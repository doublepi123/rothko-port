# Generated by config/generate_device_config.py from config/device-parameters.json.
# Do not edit by hand. Evidence for every value is recorded in the JSON file and
# in docs/EVIDENCE.md. Regenerate with:
#     python3 config/generate_device_config.py

# Match the device-specific ODM zygote; do not use the generic mgvi template.
TARGET_SUPPORTS_32_BIT_APPS := false
TARGET_SUPPORTS_64_BIT_APPS := true
# PRODUCT_VENDOR_PROPERTIES cannot alter the retained vendor prebuilt.
PRODUCT_PRODUCT_PROPERTIES += ro.zygote=zygote64
PRODUCT_PRODUCT_PROPERTIES += dalvik.vm.dex2oat64.enabled=true

PRODUCT_SHIPPING_API_LEVEL := 34
PRODUCT_USE_DYNAMIC_PARTITIONS := true
PRODUCT_BUILD_SUPER_PARTITION := true
PRODUCT_BUILD_VENDOR_BOOT_IMAGE := false
PRODUCT_BUILD_VBMETA_IMAGE := false

# Virtual A/B values from the OTA payload metadata
PRODUCT_VIRTUAL_AB_COW_VERSION := 2
PRODUCT_VIRTUAL_AB_COMPRESSION_METHOD := gz
PRODUCT_VIRTUAL_AB_COMPRESSION_FACTOR := 4096
PRODUCT_VIRTUAL_AB_OTA := true

AB_OTA_UPDATER := true
# List only images built or staged by this offline configuration.
AB_OTA_PARTITIONS += \
    boot \
    init_boot \
    vendor_boot \
    dtbo \
    odm \
    odm_dlkm \
    product \
    system \
    system_dlkm \
    system_ext \
    vendor \
    vendor_dlkm

# AVB signing is disabled: the OEM private keys are unavailable.
# Generated images are unsigned and are not flashable.
# shipping API 34 follows vendor API 34;
# the boot image is Android 16 but the vendor/odm stack is Android 14/SDK 34, FCM target-level 8.
# Do not set vendor API 36.
