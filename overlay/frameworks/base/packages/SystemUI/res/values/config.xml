<?xml version="1.0" encoding="utf-8"?>
<!--
     Device overlay for rothko.

     Opt in to reporting UDFPS UI-ready only after the frame that draws the illumination dot is
     committed by SurfaceFlinger. The platform default stays false, so no other device changes
     behavior. This does not control HBM and does not prove physical panel illumination.
-->
<resources>
    <bool name="config_udfpsDeferUiReadyUntilFrameCommit">true</bool>
</resources>
