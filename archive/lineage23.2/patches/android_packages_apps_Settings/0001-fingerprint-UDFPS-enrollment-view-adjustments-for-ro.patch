+    static int calculateProgressPadding(Rect sensor, @Nullable Rect safe, int requested,
+            float strokeWidth) {
+        return calculateProgressPadding(sensor, safe, new Rect[0], requested, strokeWidth);
+    }
+
+    static int calculateProgressPadding(Rect sensor, @Nullable Rect safe, Rect[] obstacles,
+            int requested, float strokeWidth) {
+        if (safe == null || safe.isEmpty() || sensor.isEmpty()) return -1;
+        int available = Math.min(Math.min(sensor.left - safe.left,
+                        safe.right - sensor.right),
+                Math.min(sensor.top - safe.top, safe.bottom - sensor.bottom)) - 2;
+        for (Rect obstacle : obstacles) {
+            if (obstacle.isEmpty()) continue;
+            // The full decoration square must be separated on at least one axis. A side
+            // button can remain beside the ring; its transparent footer is not a full-width
+            // obstruction. Taking the maximum separation also handles buttons above/aside.
+            final int separation = Math.max(Math.max(obstacle.left - sensor.right,
+                            sensor.left - obstacle.right),
+                    Math.max(obstacle.top - sensor.bottom, sensor.top - obstacle.bottom));
+            available = Math.min(available, separation - 2);
+        }
+        final int padding = Math.min(Math.max(0, requested), available);
+        // Keep the complete stroke outside the sensor, plus a pixel-rounding/AA margin.
+        return padding >= Math.ceil(strokeWidth) + 2 ? padding : -1;
+    }
