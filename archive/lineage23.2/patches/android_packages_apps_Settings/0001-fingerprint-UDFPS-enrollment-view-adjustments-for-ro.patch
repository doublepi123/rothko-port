+    @Nullable
+    private Rect getSafeBounds() {
+        final View root = getRootView();
+        final WindowInsets windowInsets = getRootWindowInsets();
+        if (!isAttachedToWindow() || root.getWidth() <= 0 || root.getHeight() <= 0
+                || windowInsets == null) return null;
+        final int[] location = new int[2];
+        root.getLocationOnScreen(location);
+        final Insets insets = windowInsets.getInsets(WindowInsets.Type.systemBars()
+                | WindowInsets.Type.displayCutout() | WindowInsets.Type.ime());
+        final Rect safe = new Rect(location[0] + insets.left, location[1] + insets.top,
+                location[0] + root.getWidth() - insets.right,
+                location[1] + root.getHeight() - insets.bottom);
+        final Rect visible = new Rect();
+        root.getWindowVisibleDisplayFrame(visible);
+        if (visible.isEmpty() || !safe.intersect(visible)) return null;
+
+        for (ViewParent node = getParent(); node instanceof View; node = node.getParent()) {
+            final View view = (View) node;
+            // Only untransformed ancestors are supported; otherwise safe geometry is unknown.
+            if (!view.getMatrix().isIdentity()) return null;
+            view.getLocationOnScreen(location);
+            if (view instanceof ViewGroup) {
+                final ViewGroup group = (ViewGroup) view;
+                final boolean paddingClip = group.getClipToPadding()
