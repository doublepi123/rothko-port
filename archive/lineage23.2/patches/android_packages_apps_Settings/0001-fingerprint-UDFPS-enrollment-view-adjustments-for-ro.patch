+    static float getCheckmarkSizeScale(float width, float height, float strokeWidth,
+            int intrinsicWidth, int intrinsicHeight) {
+        final float diagonal = (float) Math.sqrt(2) / 2f;
+        // Keep the *entire* checkmark at maximum overshoot inside the same drawable bounds.
+        // One pixel covers rounding and antialiasing. Only this decorative glyph is scaled.
+        final float roomX = width / 2f - (width - strokeWidth) / 2f * diagonal - 1f;
+        final float roomY = height / 2f - (height - strokeWidth) / 2f * diagonal - 1f;
+        return Math.max(0f, Math.min(1f, Math.min(
+                roomX / (intrinsicWidth / 2f * MAX_CHECKMARK_SCALE),
+                roomY / (intrinsicHeight / 2f * MAX_CHECKMARK_SCALE))));
+    }
