+    @Nullable
+    private Rect[] getFooterButtonBounds() {
+        final ArrayList<Rect> obstacles = new ArrayList<>();
+        for (ViewParent node = getParent(); node instanceof View; node = node.getParent()) {
+            if (!(node instanceof UdfpsEnrollEnrollingView)) continue;
+            final FooterBarMixin footer = ((UdfpsEnrollEnrollingView) node)
+                    .getMixin(FooterBarMixin.class);
+            final View[] buttons = {footer.getPrimaryButtonView(), footer.getSecondaryButtonView()};
+            for (View button : buttons) {
+                if (button == null || !button.isShown()) continue;
+                if (button.getWidth() <= 0 || button.getHeight() <= 0) return null;
+                final int[] location = new int[2];
+                button.getLocationOnScreen(location);
+                obstacles.add(new Rect(location[0], location[1],
+                        location[0] + button.getWidth(), location[1] + button.getHeight()));
+            }
+            break;
+        }
+        return obstacles.toArray(new Rect[0]);
+    }
 
+    private boolean updateDimensions(Rect rotatedBounds) {
+        // FrameLayout adds its padding when placing children. Account for it exactly once;
+        // both ImageViews now have zero padding, so local sensor center maps to screen center.
+        ViewGroup parentView = (ViewGroup) getParent();
+        FrameLayout.LayoutParams params = (LayoutParams) getLayoutParams();
+        final int[] coords = parentView.getLocationOnScreen();
+        final int left = rotatedBounds.left - getPaddingX() - coords[0]
+                - parentView.getPaddingLeft() + parentView.getScrollX();
+        final int top = rotatedBounds.top - getPaddingY() - coords[1]
+                - parentView.getPaddingTop() + parentView.getScrollY();
+        final int width = rotatedBounds.width() + 2 * getPaddingX();
+        final int height = rotatedBounds.height() + 2 * getPaddingY();
+        // Absolute gravity does not mirror physical sensor coordinates in RTL. Compare sizes
+        // as well as margins: an unchanged origin must not skip a changed safe window.
+        if (params.gravity == (Gravity.LEFT | Gravity.TOP) && params.leftMargin == left
+                && params.topMargin == top && params.width == width && params.height == height) {
+            return false;
+        }
+        params.gravity = Gravity.LEFT | Gravity.TOP;
+        params.setMarginStart(MarginLayoutParams.DEFAULT_MARGIN_RELATIVE);
+        params.setMarginEnd(MarginLayoutParams.DEFAULT_MARGIN_RELATIVE);
+        params.leftMargin = left;
+        params.topMargin = top;
+        params.rightMargin = 0;
+        params.bottomMargin = 0;
+        params.width = width;
+        params.height = height;
+        setLayoutParams(params);
+        return true;
     }
 
     private void onFingerDown() {
