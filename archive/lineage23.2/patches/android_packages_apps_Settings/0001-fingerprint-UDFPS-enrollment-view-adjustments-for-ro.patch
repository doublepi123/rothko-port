+                        clip.top += view.getPaddingTop();
+                        clip.right -= view.getPaddingRight();
+                        clip.bottom -= view.getPaddingBottom();
+                    }
+                    if (clip.isEmpty() || !safe.intersect(clip)) return null;
+                }
+                // A zero-height, non-clipping layout_container is an anchor, NOT a viewport.
             }
