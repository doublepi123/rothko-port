+/** Fixed-ID, scalar-only diagnostics. All View access is confined to the UI thread. */
+class RothkoKeyguardGeometry : Dumpable {
+    private val publication = RothkoKeyguardGeomPublication()
+
+    /** Installed once on the lifetime-owned keyguard root; no dump-triggered work is scheduled. */
+    fun observe(root: View) {
+        Assert.isMainThread()
+        var observer: ViewTreeObserver? = null
+        var lastSampleUptimeMs: Long? = null
+        val preDraw = ViewTreeObserver.OnPreDrawListener {
+            Assert.isMainThread()
+            val nowUptimeMs = SystemClock.uptimeMillis()
+            if (rothkoKeyguardGeomSampleDue(lastSampleUptimeMs, nowUptimeMs)) {
+                lastSampleUptimeMs = nowUptimeMs
+                publishOnMain(root, nowUptimeMs)
+            }
+            true
+        }
+        fun attach() {
+            Assert.isMainThread()
+            if (observer?.isAlive == true) return
+            observer = root.viewTreeObserver.also { it.addOnPreDrawListener(preDraw) }
+        }
+        root.addOnAttachStateChangeListener(
+            object : View.OnAttachStateChangeListener {
+                override fun onViewAttachedToWindow(v: View) = attach()
+
+                override fun onViewDetachedFromWindow(v: View) {
+                    Assert.isMainThread()
+                    observer?.takeIf { it.isAlive }?.removeOnPreDrawListener(preDraw)
+                    observer = null
+                    publication.unavailable()
+                }
+            }
+        )
+        if (root.isAttachedToWindow) attach()
+    }
+
+    private fun publishOnMain(root: View, sampleUptimeMs: Long) {
+        Assert.isMainThread()
+        val resources = root.resources
+        publication.publish(
+            RothkoKeyguardGeomSnapshot(
+                uptimeMs = sampleUptimeMs,
+                root = sample(root.findViewById(R.id.keyguard_root_view)),
+                entry = sample(root.findViewById(R.id.device_entry_icon_view)),
+                foreground = sample(root.findViewById(R.id.device_entry_icon_fg), foreground = true),
+                background = sample(root.findViewById(R.id.device_entry_icon_bg)),
+                indication = sample(root.findViewById(R.id.keyguard_indication_area)),
+                top = sample(root.findViewById(R.id.keyguard_indication_text)),
+                bottom = sample(root.findViewById(R.id.keyguard_indication_text_bottom)),
+                lockPaddingPx = resources.getDimensionPixelSize(R.dimen.lock_icon_padding),
+                bottomMarginPx = resources.getDimensionPixelSize(R.dimen.keyguard_indication_margin_bottom),
+                minTextHeightPx = resources.getDimensionPixelSize(R.dimen.keyguard_indication_text_min_height),
+            )
+        )
+    }
+
+    private fun sample(view: View?, foreground: Boolean = false): RothkoKeyguardGeomView {
+        Assert.isMainThread()
+        if (view == null) return RothkoKeyguardGeomView(RothkoKeyguardGeomState.MISSING)
+        if (!view.isAttachedToWindow) return RothkoKeyguardGeomView(RothkoKeyguardGeomState.DETACHED)
+        if (!view.isLaidOut) return RothkoKeyguardGeomView(RothkoKeyguardGeomState.UNKNOWN)
+        val screen = Rect()
+        view.getBoundsOnScreen(screen)
+        val image = if (foreground) view as? ImageView else null
+        val drawable = image?.drawable
+        return RothkoKeyguardGeomView(
+            state = RothkoKeyguardGeomState.READY,
+            screen = screen.scalars(),
+            width = view.width,
+            height = view.height,
+            visibility = view.visibility,
+            alpha = view.alpha,
+            tx = view.translationX,
+            ty = view.translationY,
+            sx = view.scaleX,
+            sy = view.scaleY,
+            padding = RothkoKeyguardGeomRect(view.paddingLeft, view.paddingTop, view.paddingRight, view.paddingBottom),
+            scaleType = image?.scaleType?.ordinal ?: -1,
+            intrinsicWidth = drawable?.intrinsicWidth ?: -1,
+            intrinsicHeight = drawable?.intrinsicHeight ?: -1,
+            drawableBounds = drawable?.bounds?.scalars(),
+        )
+    }
+
+    private fun Rect.scalars() = RothkoKeyguardGeomRect(left, top, right, bottom)
+
+    // Do not read View/resources/properties, acquire locks, or wait for UI work on this path.
+    override fun dump(pw: PrintWriter, args: Array<out String>) = publication.dump(pw)
+
+    companion object {
+        const val DUMP_NAME = "RothkoKeyguardGeom"
+
+        /** Same existing readonly opt-in as the device's FOD bridge; not a new security flag. */
+        fun enabled(context: Context): Boolean {
+            val id = context.resources.getIdentifier("config_rothkoFodStateBridgeEnabled", "bool", "android")
+            return id != 0 && context.resources.getBoolean(id) &&
+                SystemProperties.getBoolean("ro.hardware.fp.fod", false) &&
+                SystemProperties.get("ro.hardware.fp.fod.touch.ctl.version", "") == "2.0"
+        }
+    }
+}
+
+// Immutable scalar payloads only: no View, Rect, Drawable, CharSequence, arrays, or collections.
+internal enum class RothkoKeyguardGeomState { UNKNOWN, MISSING, DETACHED, READY }
+
+/** Only natural pre-draw callbacks drive this main-thread rate limit; no timer or redraw. */
+internal fun rothkoKeyguardGeomSampleDue(lastUptimeMs: Long?, nowUptimeMs: Long): Boolean =
+    lastUptimeMs == null || nowUptimeMs - lastUptimeMs >= 250L
+
+internal data class RothkoKeyguardGeomRect(val left: Int, val top: Int, val right: Int, val bottom: Int) {
+    fun scalars(): String = "$left,$top,$right,$bottom"
+}
+
+internal data class RothkoKeyguardGeomView(
+    val state: RothkoKeyguardGeomState,
+    val screen: RothkoKeyguardGeomRect? = null,
+    val width: Int = 0,
+    val height: Int = 0,
+    val visibility: Int = -1,
+    val alpha: Float = 0f,
+    val tx: Float = 0f,
+    val ty: Float = 0f,
+    val sx: Float = 1f,
+    val sy: Float = 1f,
+    val padding: RothkoKeyguardGeomRect? = null,
+    val scaleType: Int = -1,
+    val intrinsicWidth: Int = -1,
+    val intrinsicHeight: Int = -1,
+    val drawableBounds: RothkoKeyguardGeomRect? = null,
+) {
+    fun scalars(): String =
+        "state=$state screen=${screen?.scalars() ?: "UNKNOWN"} wh=$width,$height" +
+            " va=$visibility,$alpha ts=$tx,$ty,$sx,$sy p=${padding?.scalars() ?: "UNKNOWN"}"
+
+    fun foregroundScalars(): String =
+        " scaleType=$scaleType intrinsic=$intrinsicWidth,$intrinsicHeight" +
+            " drawable=${drawableBounds?.scalars() ?: "UNKNOWN"}"
+}
+
+internal data class RothkoKeyguardGeomSnapshot(
+    val uptimeMs: Long,
+    val root: RothkoKeyguardGeomView,
+    val entry: RothkoKeyguardGeomView,
+    val foreground: RothkoKeyguardGeomView,
+    val background: RothkoKeyguardGeomView,
+    val indication: RothkoKeyguardGeomView,
+    val top: RothkoKeyguardGeomView,
+    val bottom: RothkoKeyguardGeomView,
+    val lockPaddingPx: Int,
+    val bottomMarginPx: Int,
+    val minTextHeightPx: Int,
+)
+
+/** One immutable String publication: a dump reads one complete UI-frame snapshot, never Views. */
+internal class RothkoKeyguardGeomPublication {
+    @Volatile private var published: String = UNKNOWN
+
+    fun unavailable() { published = UNKNOWN }
+
+    fun publish(snapshot: RothkoKeyguardGeomSnapshot) {
+        val rendered = buildString {
+            append("$PREFIX state=${snapshot.root.state} uptimeMs=${snapshot.uptimeMs}\n")
+            append("$PREFIX dimPx=${snapshot.lockPaddingPx},${snapshot.bottomMarginPx},${snapshot.minTextHeightPx}\n")
+            append("$PREFIX root ${snapshot.root.scalars()}\n")
+            append("$PREFIX entry ${snapshot.entry.scalars()}\n")
+            append("$PREFIX fg ${snapshot.foreground.scalars()}${snapshot.foreground.foregroundScalars()}\n")
+            append("$PREFIX bg ${snapshot.background.scalars()}\n")
+            append("$PREFIX indication ${snapshot.indication.scalars()}\n")
+            append("$PREFIX top ${snapshot.top.scalars()}\n")
+            append("$PREFIX bottom ${snapshot.bottom.scalars()}\n")
+        }
+        // ASCII scalars make this a byte bound too; never truncate into a partial geometry record.
+        published = if (rendered.length <= 4096 && rendered.count { it == '\n' } <= 12 &&
+            rendered.all { it.code < 128 }) rendered else UNKNOWN
+    }
+
+    fun dump(pw: PrintWriter) {
+        val snapshot = published
+        pw.print(snapshot)
+    }
+
+    companion object {
+        private const val PREFIX = "RothkoKeyguardGeom/1"
+        private const val UNKNOWN = "$PREFIX state=UNKNOWN\n"
+    }
+}
