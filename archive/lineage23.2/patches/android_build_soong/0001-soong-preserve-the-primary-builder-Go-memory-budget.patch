From f8299d01f3fe9439fa607e6a96717670bafc62a9 Mon Sep 17 00:00:00 2001
From: lcy <admin@luchenyang.xyz>
Date: Mon, 16 Nov 2026 02:22:46 +0800
Subject: [PATCH] soong: preserve the primary builder Go memory budget

Forward GOMEMLIMIT through the empty environment used for Soong graph generation. Validate its memory-size syntax before it reaches Blueprint shell assignments. Preserve existing debug flags and the default runtime behavior when no budget is configured. Include regression cases for an unset budget, valid limits and shell/control-character rejection.
---
 ui/build/environment_test.go | 33 +++++++++++++++++++++++++++++++++
 ui/build/soong.go            | 22 ++++++++++++++++++++++
 2 files changed, 55 insertions(+)

diff --git a/ui/build/environment_test.go b/ui/build/environment_test.go
index 37f500f30..e029ca37b 100644
--- a/ui/build/environment_test.go
+++ b/ui/build/environment_test.go
@@ -87,3 +87,36 @@ func TestEnvAppendFromKati(t *testing.T) {
 		t.Errorf("     got: %v", got)
 	}
 }
+
+// Cover the shell boundary as well as the normal bounded-memory build case.
+func TestPrimaryBuilderMemoryBudget(t *testing.T) {
+	for _, tc := range []struct {
+		name, value string
+		valid       bool
+	}{
+		{"unset", "", true},
+		{"bounded", "22GiB", true},
+		{"bytes", "23622320128", true},
+		{"off", "off", true},
+		{"quoted", "\"22GiB\"", false},
+		{"space", "22 GiB", false},
+		{"shell", "22GiB; false", false},
+		{"substitution", "$(false)", false},
+		{"newline", "22GiB\nfalse", false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			env := map[string]string{"GODEBUG": "asyncpreemptoff=1"}
+			err := addPrimaryBuilderMemoryLimit(env, tc.value)
+			if (err == nil) != tc.valid {
+				t.Fatalf("unexpected error: %v", err)
+			}
+			want := ""
+			if tc.valid {
+				want = tc.value
+			}
+			if env["GOMEMLIMIT"] != want || env["GODEBUG"] != "asyncpreemptoff=1" {
+				t.Fatalf("unexpected builder environment: %#v", env)
+			}
+		})
+	}
+}
diff --git a/ui/build/soong.go b/ui/build/soong.go
index c9b303c5b..39ee57f3d 100644
--- a/ui/build/soong.go
+++ b/ui/build/soong.go
@@ -21,6 +21,7 @@ import (
 	"io/fs"
 	"os"
 	"path/filepath"
+	"regexp"
 	"runtime"
 	"slices"
 	"strconv"
@@ -198,6 +199,22 @@ func getGlobPathNameFromPrimaryBuilderFactory(config Config, pb PrimaryBuilderFa
 	return pb.name
 }
 
+var primaryBuilderMemoryLimitPattern = regexp.MustCompile(`^(off|[1-9][0-9]*(B|KiB|MiB|GiB|TiB)?)$`)
+
+// addPrimaryBuilderMemoryLimit preserves the caller's Go heap budget across
+// the primary builder's empty environment. Restrict values to runtime memory
+// sizes because Blueprint emits these assignments into a shell command.
+func addPrimaryBuilderMemoryLimit(env map[string]string, value string) error {
+	if value == "" {
+		return nil
+	}
+	if !primaryBuilderMemoryLimitPattern.MatchString(value) {
+		return errors.New("invalid primary builder GOMEMLIMIT")
+	}
+	env["GOMEMLIMIT"] = value
+	return nil
+}
+
 func (pb PrimaryBuilderFactory) primaryBuilderInvocation(config Config) bootstrap.PrimaryBuilderInvocation {
 	commonArgs := make([]string, 0, 0)
 
@@ -242,6 +259,11 @@ func (pb PrimaryBuilderFactory) primaryBuilderInvocation(config Config) bootstra
 		invocationEnv["GODEBUG"] = "asyncpreemptoff=1"
 	}
 
+	memoryLimit, _ := config.Environment().Get("GOMEMLIMIT")
+	if err := addPrimaryBuilderMemoryLimit(invocationEnv, memoryLimit); err != nil {
+		panic(err)
+	}
+
 	var allArgs []string
 	allArgs = append(allArgs, pb.specificArgs...)
 
