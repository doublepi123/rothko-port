diff --git a/java/jvm_pool.go b/java/jvm_pool.go
new file mode 100644
index 000000000..7ace42829
--- /dev/null
+++ b/java/jvm_pool.go
@@ -0,0 +1,59 @@
+// Copyright 2026 The Android Open Source Project
+// SPDX-License-Identifier: Apache-2.0
+
+package java
+
+import (
+	"strings"
+
+	"android/soong/android"
+	"android/soong/remoteexec"
+	"github.com/google/blueprint"
+)
+
+// Share Ninja's existing highmem_pool with Metalava. Native compilation retains
+// its normal parallelism. This is opt-in for memory-constrained local builders.
+var javaHighmemPool = blueprint.NewBuiltinPool("highmem_pool")
+
+func javaHighmemParams(params blueprint.RuleParams, enabled, remote bool) blueprint.RuleParams {
+	if enabled && !remote && params.Pool == nil {
+		params.Pool = javaHighmemPool
+	}
+	return params
+}
+
+func javaStaticRule(name string, params blueprint.RuleParams, args ...string) blueprint.Rule {
+	return pctx.RuleFunc(name, func(ctx android.PackageRuleContext) blueprint.RuleParams {
+		return javaHighmemParams(params, ctx.Config().IsEnvTrue("SOONG_JAVA_HIGHMEM_POOL"), ctx.Config().UseRemoteBuild())
+	}, args...)
+}
+
+// Preserve AndroidRemoteStaticRule's remote and local_pool behavior exactly.
+func javaAndroidRemoteStaticRule(name string, supports android.RemoteRuleSupports, params blueprint.RuleParams, args ...string) blueprint.Rule {
+	return pctx.PackageContext.RuleFunc(name, func(value interface{}) (blueprint.RuleParams, error) {
+		config := value.(android.Config)
+		result := javaHighmemParams(params, config.IsEnvTrue("SOONG_JAVA_HIGHMEM_POOL"), config.UseRemoteBuild())
+		if config.UseREWrapper() && !supports.RBE {
+			result.Pool = blueprint.NewBuiltinPool("local_pool")
+		}
+		return result, nil
+	}, args...)
+}
+
+func javaRemoteStaticRules(name string, params blueprint.RuleParams, remote *remoteexec.REParams, common, extra []string) (blueprint.Rule, blueprint.Rule) {
+	local := params
+	local.Command = strings.ReplaceAll(params.Command, "$reTemplate", "")
+	params.Command = strings.ReplaceAll(params.Command, "$reTemplate", remote.Template())
+	return javaStaticRule(name, local, common...),
+		pctx.AndroidRemoteStaticRule(name+"RE", android.RemoteRuleSupports{RBE: true}, params, append(common, extra...)...)
+}
+
+func javaMultiCommandRemoteStaticRules(name string, params blueprint.RuleParams, remote map[string]*remoteexec.REParams, common, extra []string) (blueprint.Rule, blueprint.Rule) {
+	local := params
+	for placeholder, command := range remote {
+		local.Command = strings.ReplaceAll(local.Command, placeholder, "")
+		params.Command = strings.ReplaceAll(params.Command, placeholder, command.Template())
+	}
+	return javaStaticRule(name, local, common...),
+		pctx.AndroidRemoteStaticRule(name+"RE", android.RemoteRuleSupports{RBE: true}, params, append(common, extra...)...)
+}
diff --git a/java/jvm_pool_test.go b/java/jvm_pool_test.go
new file mode 100644
