--- /dev/null
+++ b/java/jvm_pool_test.go
@@ -0,0 +1,85 @@
+// Copyright 2026 The Android Open Source Project
+// SPDX-License-Identifier: Apache-2.0
+package java
+
+import (
+	"bytes"
+	"regexp"
+	"strings"
+	"testing"
+
+	"android/soong/android"
+	"github.com/google/blueprint"
+)
+
+func TestJavaHighmemParams(t *testing.T) {
+	other := blueprint.NewBuiltinPool("other_pool")
+	for _, tc := range []struct {
+		name            string
+		enabled, remote bool
+		input, want     blueprint.Pool
+	}{
+		{"default", false, false, nil, nil},
+		{"opt-in", true, false, nil, javaHighmemPool},
+		{"remote-default", false, true, nil, nil},
+		{"remote-opt-in", true, true, nil, nil},
+		{"existing-pool", true, false, other, other},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			input := blueprint.RuleParams{Command: "original", Pool: tc.input}
+			got := javaHighmemParams(input, tc.enabled, tc.remote)
+			if got.Pool != tc.want || got.Command != input.Command {
+				t.Fatalf("unexpected rule params: %#v", got)
+			}
+			if input.Pool != tc.input {
+				t.Fatal("input mutated")
+			}
+		})
+	}
+}
+
+// Evaluate real module actions as well as the policy function. This catches a
+// compiler rule being accidentally left on the ordinary parallelism path.
+func TestJavaHighmemModuleRules(t *testing.T) {
+	for _, tc := range []struct{ enabled, remote string }{
+		{"", "false"}, {"true", "false"}, {"", "true"}, {"true", "true"},
+	} {
+		enabled := tc.enabled
+		t.Run("enabled="+enabled+"/remote="+tc.remote, func(t *testing.T) {
+			result := android.GroupFixturePreparers(
+				PrepareForTestWithJavaDefaultModules,
+				android.FixtureModifyProductVariables(func(variables android.FixtureProductVariables) {
+					remote := tc.remote == "true"
+					variables.UseRBE = &remote
+					variables.UseREWrapper = &remote
+				}),
+				android.FixtureMergeEnv(map[string]string{"SOONG_JAVA_HIGHMEM_POOL": enabled, "USE_RBE": tc.remote, "USE_REWRAPPER": tc.remote}),
+			).RunTestWithBp(t, `
+                java_library {
+                    name: "foo",
+                    srcs: ["a.java", "b.kt"],
+                    installable: true,
+                }
+            `)
+			var ninja bytes.Buffer
+			if err := result.Context.WriteBuildFile(&ninja, false, "build.ninja"); err != nil {
+				t.Fatal(err)
+			}
+			for _, name := range []string{"javac", "kotlinc", "turbine", "d8"} {
+				block := regexp.MustCompile(`(?m)^rule [^\n ]*\.` + name + `\n(?:[ \t]+[^\n]*\n)*`).FindString(ninja.String())
+				if block == "" {
+					t.Fatalf("missing Ninja rule %s", name)
+				}
+				if got := strings.Contains(block, "pool = highmem_pool"); got != (enabled == "true" && tc.remote == "false") {
+					t.Errorf("%s highmem pool=%v, enabled=%q: %s", name, got, enabled, block)
+				}
+			}
+			params := result.ModuleForTests(t, "foo", "android_common").Rule("lint").RuleParams
+			got := params.Pool != nil && strings.Contains(params.Pool.String(), "highmem_pool")
+			if got != (enabled == "true" && tc.remote == "false") {
+				t.Errorf("lint highmem pool=%v", got)
+			}
+
+		})
+	}
+}
