 This file contains the implementation of combining two mapping files.
+
+The optional --checked-revision argument applies a narrowly checked, in-memory
+revision to a named top-half typeattributeset before combining. It never writes
+to either input file and is absent by default, so the ordinary combine path and
+its output are unchanged.
 """
 import argparse
+import json
 import re
 from mini_parser import MiniCilParser
 
+
+class CheckedRevisionError(ValueError):
+    """A checked top-half revision is malformed or does not match the input."""
+
+
+def _parse_member_list(value, field):
+    if not isinstance(value, list):
+        raise CheckedRevisionError("%s must be a JSON array of strings" % field)
+
+    members = []
+    seen = set()
+    for member in value:
+        if not isinstance(member, str) or not member:
+            raise CheckedRevisionError(
+                "%s must contain only non-empty strings" % field)
+        if member in seen:
+            raise CheckedRevisionError(
+                "%s contains duplicate member %r" % (field, member))
+        seen.add(member)
+        members.append(member)
+    return members
+
+
+def _reject_duplicate_json_fields(pairs):
+    payload = {}
+    for key, value in pairs:
+        if key in payload:
+            raise CheckedRevisionError(
+                "revision has duplicate JSON field %r" % key)
+        payload[key] = value
+    return payload
+
+
+def parse_checked_revision(text):
+    """Parses and structurally validates one JSON-encoded checked revision."""
+    try:
+        payload = json.loads(text,
+                             object_pairs_hook=_reject_duplicate_json_fields)
+    except CheckedRevisionError:
+        raise
+    except (TypeError, ValueError) as e:
+        raise CheckedRevisionError("revision is not valid JSON: %s" % e)
+
+    if not isinstance(payload, dict):
+        raise CheckedRevisionError("revision must be a JSON object")
+
+    required = {"selector", "expected_members", "remove_members"}
+    missing = required - set(payload)
+    extra = set(payload) - required
+    if missing:
+        raise CheckedRevisionError(
+            "revision is missing field(s): %s" % ", ".join(sorted(missing)))
+    if extra:
+        raise CheckedRevisionError(
+            "revision has unknown field(s): %s" % ", ".join(sorted(extra)))
+
+    selector = payload["selector"]
+    if not isinstance(selector, str) or not selector:
+        raise CheckedRevisionError("selector must be a non-empty string")
+
+    expected = _parse_member_list(payload["expected_members"],
+                                  "expected_members")
+    remove = _parse_member_list(payload["remove_members"], "remove_members")
+    if not expected:
+        raise CheckedRevisionError("expected_members must not be empty")
+    if not remove:
+        raise CheckedRevisionError("remove_members must not be empty")
+
+    expected_set = set(expected)
+    for member in remove:
+        if member not in expected_set:
+            raise CheckedRevisionError(
+                "remove member %r is not in expected_members" % member)
+    if len(remove) == len(expected_set):
+        raise CheckedRevisionError(
+            "remove_members must leave at least one expected member")
+
+    return {
+        "selector": selector,
+        "expected_members": expected,
+        "remove_members": remove,
+    }
+
+
+def apply_checked_revisions(top, revisions):
+    """Applies checked revisions to a parsed top map in memory.
+
+    All revisions are validated before any set is changed, so a rejected
+    revision leaves the parsed top map untouched. The revision is intentionally
+    limited to replacing members of an existing typeattributeset; types,
+    typeattributes, expandtypeattribute forms and every unrelated selector are
+    left alone.
+    """
+    if not revisions:
+        return top
+
+    seen = set()
+    for revision in revisions:
+        selector = revision["selector"]
+        if selector in seen:
+            raise CheckedRevisionError(
+                "duplicate revision selector %r" % selector)
+        seen.add(selector)
+
+        if selector not in top.typeattributesets:
+            raise CheckedRevisionError(
+                "selector %r is not a typeattributeset in the top half"
+                % selector)
+
+        actual = set(top.typeattributesets[selector])
+        expected = set(revision["expected_members"])
+        if actual != expected:
+            raise CheckedRevisionError(
+                "selector %r expected members %s, actual members %s"
+                % (selector, sorted(expected), sorted(actual)))
+
+    for revision in revisions:
+        new_members = (set(revision["expected_members"]) -
+                       set(revision["remove_members"]))
+        # parse_checked_revision guarantees this is a non-empty proper subset.
+        top.typeattributesets[revision["selector"]] = new_members
+
+    return top
+
+
