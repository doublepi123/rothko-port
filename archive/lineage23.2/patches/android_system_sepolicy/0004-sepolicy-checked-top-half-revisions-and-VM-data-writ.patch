 	// Target version that this module supports. This module will be ignored if platform sepolicy
 	// version is same as this module's version.
 	Version *string
+	// Optional checked revisions of typeattributesets in the top half. Each
+	// revision requires the selector's exact current members and removes a
+	// non-empty proper subset of them before combining. Revisions are applied
+	// in memory only; top-half inputs are not modified. Requires top_half.
+	Checked_top_revisions []cilCompatMapRevision
+}
+
+type cilCompatMapRevision struct {
+	Selector         string   `json:"selector"`
+	Expected_members []string `json:"expected_members"`
+	Remove_members   []string `json:"remove_members"`
+}
+
+func validateCheckedTopRevisions(revisions []cilCompatMapRevision) error {
+	selectors := make(map[string]bool)
+	for i, revision := range revisions {
+		if revision.Selector == "" {
+			return fmt.Errorf("checked_top_revisions[%d]: selector is required", i)
+		}
+		if selectors[revision.Selector] {
+			return fmt.Errorf("checked_top_revisions[%d]: duplicate selector %q", i, revision.Selector)
+		}
+		selectors[revision.Selector] = true
+
+		if len(revision.Expected_members) == 0 {
+			return fmt.Errorf("checked_top_revisions[%d]: expected_members must not be empty", i)
+		}
+		expected := make(map[string]bool)
+		for _, member := range revision.Expected_members {
+			if member == "" {
+				return fmt.Errorf("checked_top_revisions[%d]: expected_members must contain only non-empty strings", i)
+			}
+			if expected[member] {
+				return fmt.Errorf("checked_top_revisions[%d]: duplicate expected member %q", i, member)
+			}
+			expected[member] = true
+		}
+
+		if len(revision.Remove_members) == 0 {
+			return fmt.Errorf("checked_top_revisions[%d]: remove_members must not be empty", i)
+		}
+		removed := make(map[string]bool)
+		for _, member := range revision.Remove_members {
+			if member == "" {
+				return fmt.Errorf("checked_top_revisions[%d]: remove_members must contain only non-empty strings", i)
+			}
+			if removed[member] {
+				return fmt.Errorf("checked_top_revisions[%d]: duplicate remove member %q", i, member)
+			}
+			removed[member] = true
+			if !expected[member] {
+				return fmt.Errorf("checked_top_revisions[%d]: remove member %q is not in expected_members", i, member)
+			}
+		}
+		if len(removed) == len(expected) {
+			return fmt.Errorf("checked_top_revisions[%d]: remove_members must leave at least one expected member", i)
+		}
+	}
+	return nil
 }
 
