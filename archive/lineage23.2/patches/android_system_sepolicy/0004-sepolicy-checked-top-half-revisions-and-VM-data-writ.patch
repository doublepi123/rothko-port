+// F06 focused Soong fixture coverage for the checked_top_revisions prototype.
+//
+// These tests use the real android.Test fixture harness, the real
+// se_cil_compat_map module factory, real module dependency resolution and real
+// generated build actions. They do not run combine_maps and they do not
+// compile native policy. The prototype default is OFF in production: this file
+// lives only in the disposable fixture copy of the package.
+package selinux
+
+import (
+	"encoding/json"
+	"strings"
+	"testing"
+
+	"android/soong/android"
+
+	"github.com/google/blueprint/proptools"
+)
+
+const f06PlatformSepolicyVersion = "34"
+
+// f06CombineMapsCommand is the unchanged default combine_maps command from
+// production. The rule's own Command string is not exposed by the test
+// fixture for package-level static rules, so the expanded Ninja flag string is
+// rebuilt from this unchanged command plus the recorded build action args.
+const f06CombineMapsCommand = "${combine_maps} -t ${topHalf} -b ${bottomHalf} -o $out"
+
+// f06RelativeToTop mirrors the fixture's path normalization so provider paths
+// (not part of a build action) can be compared with action paths.
+func f06RelativeToTop(ctx *android.TestContext, path string) string {
+	out := ctx.Config().SoongOutDir()
+	if strings.HasPrefix(path, out+"/") {
+		return "out/soong/" + strings.TrimPrefix(path, out+"/")
+	}
+	return path
+}
+
+// prepareForF06CilCompatMap registers the real se_cil_compat_map module factory
+// with a fresh fixture registration context and pins the platform sepolicy
+// version so version-skip behaviour is deterministic.
+var prepareForF06CilCompatMap = android.GroupFixturePreparers(
+	android.PrepareForTestWithAndroidBuildComponents,
+	android.FixtureModifyProductVariables(func(variables android.FixtureProductVariables) {
+		variables.PlatformSepolicyVersion = proptools.StringPtr(f06PlatformSepolicyVersion)
+	}),
+	android.FixtureRegisterWithContext(func(ctx android.RegistrationContext) {
+		ctx.RegisterModuleType("se_cil_compat_map", cilCompatMapFactory)
+	}),
+)
+
+func f06AddCil(t *testing.T, path string, content string) android.FixturePreparer {
+	t.Helper()
+	return android.FixtureAddTextFile(path, content)
+}
+
+// TestF06VersionMatchSkipsAllBuildActions covers the legitimate
+// version==PlatformSepolicyVersion early return even when revisions are
+// configured: no Cat, no combine rule (with or without revision args), no
+// install action and no provider.
+func TestF06VersionMatchSkipsAllBuildActions(t *testing.T) {
+	ctx := android.GroupFixturePreparers(
+		prepareForF06CilCompatMap,
+		android.FixtureAddTextFile("system/sepolicy/build/soong/Android.bp", `
+se_cil_compat_map {
+    name: "f06_skip_top",
+    version: "34",
+    bottom_half: ["f06_skip_top.cil"],
+}
+se_cil_compat_map {
+    name: "f06_skip",
+    version: "34",
+    top_half: "f06_skip_top",
+    bottom_half: ["f06_skip.cil"],
+    checked_top_revisions: [{
+        selector: "virtual_face",
+        expected_members: ["fingerprint", "vendor_face"],
+        remove_members: ["vendor_face"],
+    }],
+}
+`),
+		f06AddCil(t, "system/sepolicy/build/soong/f06_skip_top.cil", "(typeattributeset virtual_face (fingerprint vendor_face))\n"),
+		f06AddCil(t, "system/sepolicy/build/soong/f06_skip.cil", "(typeattributeset virtual_face (fingerprint vendor_face))\n"),
+	).RunTest(t).TestContext
+
+	for _, name := range []string{"f06_skip_top", "f06_skip"} {
+		m := ctx.ModuleForTests(t, name, "android_common")
+		for _, rule := range []string{"Cat", "combineMapsRule", "combineMapsRevisionRule", "CpWithBash"} {
+			if got := m.MaybeRule(rule); got.Rule != nil {
+				t.Errorf("%s: version-skipped module generated a %q action: %+v", name, rule, got)
+			}
+		}
+		if info, ok := android.OtherModuleProvider(ctx.OtherModuleProviderAdaptor(), m.Module(), CilCompatMapGeneratorInfoProvider); ok {
+			t.Errorf("%s: version-skipped module must not provide CilCompatMapGeneratorInfo, got %+v", name, info)
+		}
+	}
+}
+
+// TestF06CheckedRevisionsRequireTopProvider covers the active-module case where
+// top_half names a real se_cil_compat_map that is itself version-skipped, so it
+// never runs SetProvider and contributes an invalid GeneratedMapFile. The
+// consumer must fail through PropertyErrorf instead of silently combining only
+// the bottom half.
+func TestF06CheckedRevisionsRequireTopProvider(t *testing.T) {
+	ctx := android.GroupFixturePreparers(
+		prepareForF06CilCompatMap,
+		android.FixtureAddTextFile("system/sepolicy/build/soong/Android.bp", `
+se_cil_compat_map {
+    name: "f06_absent_top",
+    version: "34",
+    bottom_half: ["f06_absent_top.cil"],
+}
+se_cil_compat_map {
+    name: "f06_revisions_without_top",
+    version: "33",
+    top_half: "f06_absent_top",
+    bottom_half: ["f06_revisions_without_top.cil"],
+    checked_top_revisions: [{
+        selector: "virtual_face",
+        expected_members: ["fingerprint", "vendor_face"],
+        remove_members: ["vendor_face"],
+    }],
+}
+`),
+		f06AddCil(t, "system/sepolicy/build/soong/f06_absent_top.cil", "(typeattributeset virtual_face (fingerprint vendor_face))\n"),
+		f06AddCil(t, "system/sepolicy/build/soong/f06_revisions_without_top.cil", "(typeattributeset virtual_face (fingerprint vendor_face))\n"),
+	).ExtendWithErrorHandler(android.FixtureExpectsAtLeastOneErrorMatchingPattern(
+		"checked_top_revisions requires top_half to provide an actual top mapping")).RunTest(t).TestContext
+
+	// Precondition: the real skipped module must not have published a top
+	// mapping. This is what makes the consumer's top invalid without faking a
+	// provider or module context.
+	absent := ctx.ModuleForTests(t, "f06_absent_top", "android_common")
+	if info, ok := android.OtherModuleProvider(ctx.OtherModuleProviderAdaptor(), absent.Module(), CilCompatMapGeneratorInfoProvider); ok {
+		t.Fatalf("fixture precondition failed: skipped top provided %+v", info)
+	}
+	if got := absent.MaybeRule("Cat"); got.Rule != nil {
+		t.Errorf("skipped top must not generate Cat, got %+v", got)
+	}
+}
+
+// TestF06NoRevisionsKeepOriginalTopHalfCombine covers the unchanged
+// no-revisions path: Cat for the bottom half, the original combineMapsRule and
+// command with exactly topHalf/bottomHalf args, the top half coming from the
+// real provider of the top module, and an install of the combined output.
+func TestF06NoRevisionsKeepOriginalTopHalfCombine(t *testing.T) {
+	ctx := android.GroupFixturePreparers(
+		prepareForF06CilCompatMap,
+		android.FixtureAddTextFile("system/sepolicy/build/soong/Android.bp", `
+se_cil_compat_map {
+    name: "f06_top3",
+    bottom_half: ["f06_top3.cil"],
+}
+se_cil_compat_map {
+    name: "f06_combined3",
+    version: "33",
+    top_half: "f06_top3",
+    bottom_half: ["f06_bottom3_a.cil", "f06_bottom3_b.cil"],
+}
+`),
+		f06AddCil(t, "system/sepolicy/build/soong/f06_top3.cil", "(typeattributeset virtual_face (fingerprint vendor_face))\n"),
+		f06AddCil(t, "system/sepolicy/build/soong/f06_bottom3_a.cil", "(typeattributeset virtual_face (fingerprint))\n"),
+		f06AddCil(t, "system/sepolicy/build/soong/f06_bottom3_b.cil", "(typeattributeset virtual_face (vendor_face))\n"),
+	).RunTest(t).TestContext
+
+	top := ctx.ModuleForTests(t, "f06_top3", "android_common")
+	topInfo, ok := android.OtherModuleProvider(ctx.OtherModuleProviderAdaptor(), top.Module(), CilCompatMapGeneratorInfoProvider)
+	if !ok || !topInfo.GeneratedMapFile.Valid() {
+		t.Fatalf("real top module did not provide a valid generated map file: ok=%v info=%+v", ok, topInfo)
+	}
+	if combineMapsCmd != f06CombineMapsCommand {
+		t.Errorf("production combine_maps command changed\nactual:   %q\nexpected: %q", combineMapsCmd, f06CombineMapsCommand)
+	}
+
+	topCat := top.Rule("Cat")
+	topProvided := f06RelativeToTop(ctx, topInfo.GeneratedMapFile.String())
+	if got, want := topProvided, topCat.Output.String(); got != want {
+		t.Errorf("top provider path is not its generated Cat output\nactual:   %s\nexpected: %s", got, want)
+	}
+
+	combined := ctx.ModuleForTests(t, "f06_combined3", "android_common")
+	cat := combined.Rule("Cat")
+	wantBottomInputs := []string{
+		"system/sepolicy/build/soong/f06_bottom3_a.cil",
+		"system/sepolicy/build/soong/f06_bottom3_b.cil",
+	}
+	if got := cat.Inputs.Strings(); !equalStrings(got, wantBottomInputs) {
+		t.Errorf("bottom half Cat inputs changed\nactual:   %v\nexpected: %v", got, wantBottomInputs)
+	}
+
+	combine := combined.Rule("combineMapsRule")
+	if len(combine.Args) != 2 {
+		t.Errorf("no-revision path args must contain only topHalf and bottomHalf, got %v", combine.Args)
+	}
+	if got, want := combine.Args["topHalf"], topProvided; got != want {
+		t.Errorf("combineMapsRule topHalf does not come from the real top provider\nactual:   %s\nexpected: %s", got, want)
+	}
+	if got, want := combine.Args["bottomHalf"], cat.Output.String(); got != want {
+		t.Errorf("combineMapsRule bottomHalf is not the generated Cat output\nactual:   %s\nexpected: %s", got, want)
+	}
+	wantImplicits := []string{topProvided, cat.Output.String()}
+	if got := combine.Implicits.Strings(); !equalStrings(got, wantImplicits) {
+		t.Errorf("combineMapsRule implicits changed\nactual:   %v\nexpected: %v", got, wantImplicits)
+	}
+	if got := combined.MaybeRule("combineMapsRevisionRule"); got.Rule != nil {
+		t.Errorf("no-revision path must not use combineMapsRevisionRule, got %+v", got)
+	}
+
+	install := combined.Rule("CpWithBash")
+	if got, want := install.Input.String(), combine.Output.String(); got != want {
+		t.Errorf("installed file is not the combined top+bottom output\nactual:   %s\nexpected: %s", got, want)
+	}
+	if got, want := install.Output.Base(), "f06_combined3"; got != want {
+		t.Errorf("installed stem changed\nactual:   %s\nexpected: %s", got, want)
+	}
+}
+
+// TestF06RevisionArgsAreExactEscapedJSON covers the revision path: two
+// revisions (selectors virtual_face and fingerprint), each with two expected
+// members and one removal, encoded with encoding/json and
+// proptools.NinjaAndShellEscape, the actual rule command template and the top
+// dependency provider path.
+func TestF06RevisionArgsAreExactEscapedJSON(t *testing.T) {
+	ctx := android.GroupFixturePreparers(
+		prepareForF06CilCompatMap,
+		android.FixtureAddTextFile("system/sepolicy/build/soong/Android.bp", `
+se_cil_compat_map {
+    name: "f06_top4",
+    bottom_half: ["f06_top4.cil"],
+}
+se_cil_compat_map {
+    name: "f06_revised4",
+    version: "33",
+    top_half: "f06_top4",
+    bottom_half: ["f06_bottom4.cil"],
+    checked_top_revisions: [
+        {
+            selector: "virtual_face",
+            expected_members: ["fingerprint", "vendor_face"],
+            remove_members: ["vendor_face"],
+        },
+        {
+            selector: "fingerprint",
+            expected_members: ["virtual_face", "vendor_face"],
+            remove_members: ["vendor_face"],
+        },
+    ],
+}
+`),
+		f06AddCil(t, "system/sepolicy/build/soong/f06_top4.cil", "(typeattributeset virtual_face (fingerprint vendor_face))\n(typeattributeset fingerprint (virtual_face vendor_face))\n"),
+		f06AddCil(t, "system/sepolicy/build/soong/f06_bottom4.cil", "(typeattributeset virtual_face (fingerprint))\n"),
+	).RunTest(t).TestContext
+
+	top := ctx.ModuleForTests(t, "f06_top4", "android_common")
+	topInfo, ok := android.OtherModuleProvider(ctx.OtherModuleProviderAdaptor(), top.Module(), CilCompatMapGeneratorInfoProvider)
+	if !ok || !topInfo.GeneratedMapFile.Valid() {
+		t.Fatalf("real top module did not provide a valid generated map file: ok=%v info=%+v", ok, topInfo)
+	}
+
+	rev1 := cilCompatMapRevision{
+		Selector:         "virtual_face",
+		Expected_members: []string{"fingerprint", "vendor_face"},
+		Remove_members:   []string{"vendor_face"},
+	}
+	rev2 := cilCompatMapRevision{
+		Selector:         "fingerprint",
+		Expected_members: []string{"virtual_face", "vendor_face"},
+		Remove_members:   []string{"vendor_face"},
+	}
+	json1, err := json.Marshal(rev1)
+	if err != nil {
+		t.Fatalf("marshal first revision: %v", err)
+	}
+	json2, err := json.Marshal(rev2)
+	if err != nil {
+		t.Fatalf("marshal second revision: %v", err)
+	}
+
+	// Independent literal expectation: encoding/json field order, both
+	// expected members retained, one removal, and single-quoted shell/ninja
+	// escaping.
+	literalFlag1 := ` --checked-revision '{"selector":"virtual_face","expected_members":["fingerprint","vendor_face"],"remove_members":["vendor_face"]}'`
+	literalFlag2 := ` --checked-revision '{"selector":"fingerprint","expected_members":["virtual_face","vendor_face"],"remove_members":["vendor_face"]}'`
+	wantArgs := literalFlag1 + literalFlag2
+
+	computedArgs := " --checked-revision " + proptools.NinjaAndShellEscape(string(json1)) +
+		" --checked-revision " + proptools.NinjaAndShellEscape(string(json2))
+
+	combined := ctx.ModuleForTests(t, "f06_revised4", "android_common")
+	revision := combined.Rule("combineMapsRevisionRule")
+	if got := revision.Args["revisionArgs"]; got != wantArgs {
+		t.Errorf("revision args are not the exact escaped JSON\nactual:   %q\nexpected: %q", got, wantArgs)
+	}
+	if got := revision.Args["revisionArgs"]; got != computedArgs {
+		t.Errorf("revision args do not match json.Marshal + proptools.NinjaAndShellEscape\nactual:   %q\nexpected: %q", got, computedArgs)
+	}
+	if combineMapsCmd != f06CombineMapsCommand {
+		t.Errorf("production combine_maps command changed\nactual:   %q\nexpected: %q", combineMapsCmd, f06CombineMapsCommand)
+	}
+	topProvided := f06RelativeToTop(ctx, topInfo.GeneratedMapFile.String())
+	if got, want := revision.Args["topHalf"], topProvided; got != want {
+		t.Errorf("revision rule topHalf does not come from the real top provider\nactual:   %s\nexpected: %s", got, want)
+	}
+
+	// Snapshot the actual expanded Ninja/shell flag string.
+	expandedCommand := f06CombineMapsCommand + " " + revision.Args["revisionArgs"]
+	if strings.Count(expandedCommand, "--checked-revision") != 2 {
+		t.Errorf("expanded command does not contain exactly two revisions: %q", expandedCommand)
+	}
+	for _, flag := range []string{literalFlag1, literalFlag2} {
+		if !strings.Contains(expandedCommand, flag) {
+			t.Errorf("expanded command lost quoted revision flag %q: %q", flag, expandedCommand)
+		}
+	}
+	if got, want := revision.Args["bottomHalf"], combined.Rule("Cat").Output.String(); got != want {
+		t.Errorf("revision rule bottomHalf is not the generated Cat output\nactual:   %s\nexpected: %s", got, want)
+	}
+	if got, want := revision.Implicits.Strings(), []string{topProvided, combined.Rule("Cat").Output.String()}; !equalStrings(got, want) {
+		t.Errorf("revision rule implicits changed\nactual:   %v\nexpected: %v", got, want)
+	}
+	if got := combined.MaybeRule("combineMapsRule"); got.Rule != nil {
+		t.Errorf("revision path must not use the plain combineMapsRule, got %+v", got)
+	}
+}
+
+func equalStrings(a, b []string) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if a[i] != b[i] {
+			return false
+		}
+	}
+	return true
+}
