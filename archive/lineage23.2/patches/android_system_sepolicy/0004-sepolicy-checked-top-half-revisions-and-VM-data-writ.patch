@@ -0,0 +1,402 @@
+#!/usr/bin/env python3
+"""Focused tests for the F06 checked top-half revision prototype.
+
+These tests use only fixture .cil maps and local Python. They do not build or
+run Soong/Ninja, do not invoke the native policy pipeline and do not exercise
+any production mapping.
+"""
+import hashlib
+import json
+import os
+import subprocess
+import sys
+import tempfile
+import unittest
+
+TESTS_DIR = os.path.dirname(os.path.abspath(__file__))
+FIXTURES = os.path.join(TESTS_DIR, "prototype_fixtures")
+PROTOTYPE = os.path.join(TESTS_DIR, "combine_maps.py")
+
+if TESTS_DIR not in sys.path:
+    sys.path.insert(0, TESTS_DIR)
+
+import combine_maps as proto  # noqa: E402
+
+GOLDENS = json.load(open(os.path.join(FIXTURES, "goldens.json")))
+TOP = os.path.join(FIXTURES, "top_202404.cil")
+BOTTOM_34 = os.path.join(FIXTURES, "bottom_34.cil")
+BOTTOM_202404 = os.path.join(FIXTURES, "bottom_202404.cil")
+BOTTOM_33 = os.path.join(FIXTURES, "bottom_33.cil")
+
+FACE = {
+    "selector": "virtual_face_hal_prop_202404",
+    "expected_members": ["virtual_face_hal_prop", "virtual_face_prop"],
+    "remove_members": ["virtual_face_prop"],
+}
+FINGERPRINT = {
+    "selector": "virtual_fingerprint_hal_prop_202404",
+    "expected_members": [
+        "virtual_fingerprint_hal_prop",
+        "virtual_fingerprint_prop",
+    ],
+    "remove_members": ["virtual_fingerprint_prop"],
+}
+
+
+def encoded(revision):
+    return json.dumps(revision, separators=(",", ":"))
+
+
+def run_cli(script, top, bottom, out, revisions=()):
+    env = os.environ.copy()
+    env["PYTHONPATH"] = TESTS_DIR
+    cmd = [sys.executable, script, "-t", top, "-b", bottom, "-o", out]
+    for revision in revisions:
+        cmd.extend(["--checked-revision", encoded(revision)])
+    return subprocess.run(cmd, cwd=TESTS_DIR, env=env, text=True,
+                          stdout=subprocess.PIPE, stderr=subprocess.PIPE)
+
+
+def sha256(path):
+    with open(path, "rb") as f:
+        return hashlib.sha256(f.read()).hexdigest()
+
+
+def parse(path):
+    return proto.MiniCilParser(path)
+
+
+class CheckedTopRevisionTest(unittest.TestCase):
+
+    def test_fixture_has_actual_two_member_shape_and_baseline_output(self):
+        top = parse(TOP)
+        self.assertEqual(
+            top.typeattributesets["virtual_face_hal_prop_202404"],
+            {"virtual_face_hal_prop", "virtual_face_prop"})
+        self.assertEqual(
+            top.typeattributesets["virtual_fingerprint_hal_prop_202404"],
+            {"virtual_fingerprint_hal_prop", "virtual_fingerprint_prop"})
+
+        combined = proto.Combine(parse(TOP), parse(BOTTOM_34))
+        self.assertEqual(
+            combined.typeattributesets["virtual_face_hal_prop_34_0"],
+            {"virtual_face_hal_prop", "virtual_face_prop"})
+        self.assertEqual(
+            combined.typeattributesets["virtual_fingerprint_hal_prop_34_0"],
+            {"virtual_fingerprint_hal_prop", "virtual_fingerprint_prop"})
+
+    def test_no_revision_cli_matches_frozen_golden(self):
+        with tempfile.TemporaryDirectory(prefix="f06-checked-revision-") as d:
+            for label, bottom in (("34", BOTTOM_34),
+                                  ("202404", BOTTOM_202404)):
+                with self.subTest(label=label):
+                    out = os.path.join(d, "proto-%s.cil" % label)
+                    prot = run_cli(PROTOTYPE, TOP, bottom, out)
+                    self.assertEqual(prot.returncode, 0, prot.stderr)
+                    with open(out, "rb") as f:
+                        actual = f.read()
+                    golden = GOLDENS["fixtures"][label]
+                    self.assertEqual(len(actual), golden["cli_bytes"])
+                    self.assertEqual(hashlib.sha256(actual).hexdigest(),
+                                     golden["cli_sha256"])
+
+    def test_default_direct_combine_matches_frozen_golden(self):
+        for label, bottom in (("34", BOTTOM_34),
+                              ("202404", BOTTOM_202404)):
+            with self.subTest(label=label):
+                actual = proto.Combine(parse(TOP), parse(bottom)).unparse()
+                golden = GOLDENS["fixtures"][label]
+                self.assertEqual(len(actual.encode()), golden["unparse_bytes"])
+                self.assertEqual(hashlib.sha256(actual.encode()).hexdigest(),
+                                 golden["unparse_sha256"])
+
+    def test_checked_revision_removes_exactly_planned_members(self):
+        with tempfile.TemporaryDirectory(prefix="f06-checked-revision-") as d:
+            out = os.path.join(d, "out.cil")
+            result = run_cli(PROTOTYPE, TOP, BOTTOM_34, out,
+                             revisions=[FACE, FINGERPRINT])
+            self.assertEqual(result.returncode, 0, result.stderr)
+            combined = parse(out)
+            self.assertEqual(
+                combined.typeattributesets["virtual_face_hal_prop_34_0"],
+                {"virtual_face_hal_prop"})
+            self.assertEqual(
+                combined.typeattributesets["virtual_fingerprint_hal_prop_34_0"],
+                {"virtual_fingerprint_hal_prop"})
+            # Ordinary Combine semantics still copy types and unrelated members.
+            self.assertIn("virtual_face_prop", combined.types)
+            self.assertIn("virtual_fingerprint_prop", combined.types)
+            self.assertEqual(
+                combined.typeattributesets["unrelated_shared_34_0"],
+                {"unrelated_shared_a"})
+
+    def test_top_input_file_unchanged(self):
+        before_top = sha256(TOP)
+        before_bottom = sha256(BOTTOM_34)
+        with tempfile.TemporaryDirectory(prefix="f06-checked-revision-") as d:
+            out = os.path.join(d, "out.cil")
+            result = run_cli(PROTOTYPE, TOP, BOTTOM_34, out,
+                             revisions=[FACE, FINGERPRINT])
+            self.assertEqual(result.returncode, 0, result.stderr)
+            self.assertTrue(os.path.exists(out))
+        self.assertEqual(before_top, sha256(TOP))
+        self.assertEqual(before_bottom, sha256(BOTTOM_34))
+
+    def assert_revision_rejected(self, revision, expected_text,
+                                 rc_expected=2):
+        with tempfile.TemporaryDirectory(prefix="f06-checked-revision-") as d:
+            out = os.path.join(d, "out.cil")
+            result = run_cli(PROTOTYPE, TOP, BOTTOM_34, out,
+                             revisions=[revision])
+            self.assertEqual(result.returncode, rc_expected,
+                             result.stdout + result.stderr)
+            self.assertIn(expected_text, result.stderr)
+            self.assertFalse(os.path.exists(out))
+        return result
+
+    def test_expected_members_mismatch_rejected(self):
+        self.assert_revision_rejected(
+            {
+                "selector": "virtual_face_hal_prop_202404",
+                "expected_members": ["virtual_face_hal_prop",
+                                     "not_the_actual_member"],
+                "remove_members": ["not_the_actual_member"],
+            },
+            "expected members")
+
+    def test_missing_selector_rejected(self):
+        self.assert_revision_rejected(
+            {
+                "selector": "virtual_face_hal_prop_404404",
+                "expected_members": ["virtual_face_hal_prop",
+                                     "virtual_face_prop"],
+                "remove_members": ["virtual_face_prop"],
+            },
+            "not a typeattributeset")
+
+    def test_remove_all_rejected(self):
+        self.assert_revision_rejected(
+            {
+                "selector": "virtual_face_hal_prop_202404",
+                "expected_members": ["virtual_face_hal_prop",
+                                     "virtual_face_prop"],
+                "remove_members": ["virtual_face_hal_prop",
+                                   "virtual_face_prop"],
+            },
+            "must leave at least one")
+
+    def test_unexpected_type_rejected(self):
+        cases = [
+            {
+                "selector": "virtual_face_hal_prop_202404",
+                "expected_members": "virtual_face_hal_prop",
+                "remove_members": ["virtual_face_prop"],
+            },
+            {
+                "selector": "virtual_face_hal_prop_202404",
+                "expected_members": ["virtual_face_hal_prop",
+                                     "virtual_face_prop"],
+                "remove_members": 7,
+            },
+            {
+                "selector": 202404,
+                "expected_members": ["virtual_face_hal_prop"],
+                "remove_members": ["virtual_face_hal_prop"],
+            },
+        ]
+        for revision in cases:
+            with self.subTest(revision=revision):
+                self.assert_revision_rejected(revision, "must")
+
+    def test_duplicate_members_rejected(self):
+        cases = [
+            {
+                "selector": "virtual_face_hal_prop_202404",
+                "expected_members": ["virtual_face_hal_prop",
+                                     "virtual_face_hal_prop"],
+                "remove_members": ["virtual_face_hal_prop"],
+            },
+            {
+                "selector": "virtual_face_hal_prop_202404",
+                "expected_members": ["virtual_face_hal_prop",
+                                     "virtual_face_prop"],
+                "remove_members": ["virtual_face_prop",
+                                   "virtual_face_prop"],
+            },
+        ]
+        for revision in cases:
+            with self.subTest(revision=revision):
+                self.assert_revision_rejected(revision, "duplicate member")
+
+    def test_duplicate_selector_rejected(self):
+        with tempfile.TemporaryDirectory(prefix="f06-checked-revision-") as d:
+            out = os.path.join(d, "out.cil")
+            result = run_cli(PROTOTYPE, TOP, BOTTOM_34, out,
+                             revisions=[FACE, FACE])
+            self.assertEqual(result.returncode, 2, result.stderr)
+            self.assertIn("duplicate revision selector", result.stderr)
+            self.assertFalse(os.path.exists(out))
+
+    def test_unknown_remove_member_rejected(self):
+        self.assert_revision_rejected(
+            {
+                "selector": "virtual_face_hal_prop_202404",
+                "expected_members": ["virtual_face_hal_prop",
+                                     "virtual_face_prop"],
+                "remove_members": ["not_a_member"],
+            },
+            "not in expected_members")
+
+    def test_bad_json_rejected(self):
+        with tempfile.TemporaryDirectory(prefix="f06-checked-revision-") as d:
+            out = os.path.join(d, "out.cil")
+            result = subprocess.run(
+                [sys.executable, PROTOTYPE, "-t", TOP, "-b", BOTTOM_34,
+                 "-o", out, "--checked-revision", "{not json"],
+                cwd=TESTS_DIR, text=True, stdout=subprocess.PIPE,
+                stderr=subprocess.PIPE)
+            self.assertEqual(result.returncode, 2, result.stderr)
+            self.assertIn("not valid JSON", result.stderr)
+            self.assertFalse(os.path.exists(out))
+
+    def test_malformed_payload_rejected(self):
+        payloads = [
+            ("[]", "must be a JSON object"),
+            ('{"selector":"virtual_face_hal_prop_202404",'
+             '"expected_members":["virtual_face_hal_prop"]}',
+             "missing field"),
+            ('{"selector":"virtual_face_hal_prop_202404",'
+             '"expected_members":["virtual_face_hal_prop"],'
+             '"remove_members":["virtual_face_hal_prop"],"extra":true}',
+             "unknown field"),
+            ('{"selector":"virtual_face_hal_prop_202404",'
+             '"selector":"virtual_fingerprint_hal_prop_202404",'
+             '"expected_members":["virtual_face_hal_prop",'
+             '"virtual_face_prop"],'
+             '"remove_members":["virtual_face_prop"]}',
+             "duplicate JSON field"),
+            ('{"selector":"virtual_face_hal_prop_202404",'
+             '"expected_members":[],"remove_members":["x"]}',
+             "expected_members must not be empty"),
+            ('{"selector":"virtual_face_hal_prop_202404",'
+             '"expected_members":["x"],"remove_members":[]}',
+             "remove_members must not be empty"),
+        ]
+        for payload, expected_text in payloads:
+            with self.subTest(payload=payload):
+                with tempfile.TemporaryDirectory(
+                        prefix="f06-checked-revision-") as d:
+                    out = os.path.join(d, "out.cil")
+                    result = subprocess.run(
+                        [sys.executable, PROTOTYPE, "-t", TOP, "-b",
+                         BOTTOM_34, "-o", out,
+                         "--checked-revision", payload],
+                        cwd=TESTS_DIR, text=True, stdout=subprocess.PIPE,
+                        stderr=subprocess.PIPE)
+                    self.assertEqual(result.returncode, 2, result.stderr)
+                    self.assertIn(expected_text, result.stderr)
+                    self.assertFalse(os.path.exists(out))
+
+    def test_unrelated_selectors_and_types_unchanged(self):
+        top = parse(TOP)
+        baseline_sets = {k: set(v) for k, v in
+                         top.typeattributesets.items()}
+        baseline_types = set(top.types)
+        baseline_attrs = set(top.typeattributes)
+        baseline_expand = dict(top.expandtypeattributes)
+
+        proto.apply_checked_revisions(
+            top, [proto.parse_checked_revision(encoded(FACE)),
+                  proto.parse_checked_revision(encoded(FINGERPRINT))])
+
+        self.assertEqual(top.types, baseline_types)
+        self.assertEqual(top.typeattributes, baseline_attrs)
+        self.assertEqual(top.expandtypeattributes, baseline_expand)
+        self.assertEqual(top.typeattributesets["unrelated_shared_202404"],
+                         baseline_sets["unrelated_shared_202404"])
+        self.assertEqual(top.typeattributesets["unrelated_top_only_202404"],
+                         baseline_sets["unrelated_top_only_202404"])
+        self.assertEqual(top.typeattributesets["virtual_face_hal_prop_202404"],
+                         {"virtual_face_hal_prop"})
+        self.assertEqual(
+            top.typeattributesets["virtual_fingerprint_hal_prop_202404"],
+            {"virtual_fingerprint_hal_prop"})
+
+    def test_independent_202404_output_unchanged(self):
+        with tempfile.TemporaryDirectory(prefix="f06-checked-revision-") as d:
+            proto_out = os.path.join(d, "proto-202404.cil")
+            prot = run_cli(PROTOTYPE, TOP, BOTTOM_202404, proto_out)
+            self.assertEqual(prot.returncode, 0, prot.stderr)
+            with open(proto_out, "rb") as f:
+                actual = f.read()
+            golden = GOLDENS["fixtures"]["202404"]
+            self.assertEqual(len(actual), golden["cli_bytes"])
+            self.assertEqual(hashlib.sha256(actual).hexdigest(),
+                             golden["cli_sha256"])
+
+            combined = parse(proto_out)
+            self.assertEqual(
+                combined.typeattributesets["virtual_face_hal_prop_202404"],
+                {"virtual_face_hal_prop", "virtual_face_prop"})
+            self.assertEqual(
+                combined.typeattributesets[
+                    "virtual_fingerprint_hal_prop_202404"],
+                {"virtual_fingerprint_hal_prop",
+                 "virtual_fingerprint_prop"})
+
+    def test_downstream_33_fixture_explained_member_delta(self):
+        base34 = proto.Combine(parse(TOP), parse(BOTTOM_34))
+        base33 = proto.Combine(base34, parse(BOTTOM_33))
+
+        revised_top = proto.apply_checked_revisions(
+            parse(TOP), [proto.parse_checked_revision(encoded(FACE)),
+                         proto.parse_checked_revision(encoded(FINGERPRINT))])
+        revised34 = proto.Combine(revised_top, parse(BOTTOM_34))
+        revised33 = proto.Combine(revised34, parse(BOTTOM_33))
+
+        self.assertEqual(
+            base33.typeattributesets["virtual_face_hal_prop_33_0"],
+            {"virtual_face_hal_prop", "virtual_face_prop"})
+        self.assertEqual(
+            base33.typeattributesets["virtual_fingerprint_hal_prop_33_0"],
+            {"virtual_fingerprint_hal_prop", "virtual_fingerprint_prop"})
+        self.assertEqual(
+            revised33.typeattributesets["virtual_face_hal_prop_33_0"],
+            {"virtual_face_hal_prop"})
+        self.assertEqual(
+            revised33.typeattributesets["virtual_fingerprint_hal_prop_33_0"],
+            {"virtual_fingerprint_hal_prop"})
+
+        changed = set()
+        for selector in set(base33.typeattributesets) | \
+                set(revised33.typeattributesets):
+            if (base33.typeattributesets.get(selector) !=
+                    revised33.typeattributesets.get(selector)):
+                changed.add(selector)
+        self.assertEqual(changed, {
+            "virtual_face_hal_prop_33_0",
+            "virtual_fingerprint_hal_prop_33_0",
+        })
+        self.assertEqual(base33.types, revised33.types)
+        self.assertEqual(base33.typeattributes, revised33.typeattributes)
+
+    def test_failed_revision_leaves_in_memory_top_unmodified(self):
+        bad = proto.parse_checked_revision(encoded({
+            "selector": "virtual_face_hal_prop_202404",
+            "expected_members": ["virtual_face_hal_prop",
+                                 "not_the_actual_member"],
+            "remove_members": ["not_the_actual_member"],
+        }))
+        good = proto.parse_checked_revision(encoded(FINGERPRINT))
+        for revisions in ([bad], [good, bad]):
+            with self.subTest(revisions=len(revisions)):
+                top = parse(TOP)
+                before = {k: set(v) for k, v in
+                          top.typeattributesets.items()}
+                with self.assertRaises(proto.CheckedRevisionError):
+                    proto.apply_checked_revisions(top, revisions)
+                self.assertEqual(top.typeattributesets, before)
+
+
+if __name__ == "__main__":
+    unittest.main(verbosity=2)
