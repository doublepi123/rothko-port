+package selinux
+
+import (
+	"os"
+	"os/exec"
+	"strings"
+	"testing"
+)
+
+// TestZygoteNextFeatureGuardM4 runs the real flagging macro over the real
+// zygote_next.te for every supported value. It intentionally fails if m4 is
+// missing rather than skipping. Other te_macros are left unexpanded on
+// purpose: this checks the guard source, not a complete CIL policy build.
+func TestZygoteNextFeatureGuardM4(t *testing.T) {
+	m4, err := exec.LookPath("m4")
+	if err != nil {
+		t.Fatalf("m4 is required for the native guard test: %v", err)
+	}
+	macroFile := "../../flagging/flagging_macros"
+	zygoteFile := "../../private/zygote_next.te"
+	cases := []struct {
+		name    string
+		defined bool
+		value   string
+		enabled bool
+	}{
+		{"undefined", false, "", false},
+		{"empty_off", true, "", false},
+		// typed false serializes to the native empty string; this test does not
+		// rewrite or claim a Go bool marshaller.
+		{"typed_false_serialized_empty_off", true, "", false},
+		{"raw_false_off", true, "false", false},
+		{"raw_one_off", true, "1", false},
+		{"true_on", true, "true", true},
+	}
+	gatedMarkers := []string{
+		"init_daemon_domain(zygote_next)",
+		"allow zygote_next isolated_app:process dyntransition;",
+		"allow zygote_next self:global_capability_class_set { dac_override setgid setuid };",
+	}
+	typeMarkers := []string{
+		"type zygote_next, domain;",
+		"typeattribute zygote_next coredomain;",
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			args := []string{"--fatal-warnings"}
+			if tc.defined {
+				args = append(args, "-D", "target_flag_RELEASE_NATIVE_FRAMEWORK_PROTOTYPE="+tc.value)
+			}
+			args = append(args, macroFile, zygoteFile)
+			out, err := exec.Command(m4, args...).CombinedOutput()
+			if err != nil {
+				t.Fatalf("m4 failed: %v\n%s", err, out)
+			}
+			text := string(out)
+			for _, marker := range typeMarkers {
+				if !strings.Contains(text, marker) {
+					t.Errorf("m4 output for %s lost type declaration %q", tc.name, marker)
+				}
+			}
+			for _, marker := range gatedMarkers {
+				present := strings.Contains(text, marker)
+				t.Logf("%s: marker %q present=%v", tc.name, marker, present)
+				if present != tc.enabled {
+					t.Errorf("gated marker %q present=%v, want %v for %s", marker, present, tc.enabled, tc.name)
+				}
+			}
+		})
+	}
+
+	systemServer, err := os.ReadFile("../../private/system_server.te")
+	if err != nil {
+		t.Fatalf("read system_server.te: %v", err)
+	}
+	if !strings.Contains(string(systemServer),
+		"is_flag_enabled(RELEASE_NATIVE_FRAMEWORK_PROTOTYPE, `\nunix_socket_connect(system_server, zygote_next, zygote_next)\n')") {
+		t.Errorf("system_server.te does not guard only the zygote_next socket connection")
+	}
+	if !strings.Contains(string(systemServer), "unix_socket_connect(system_server, zygote, zygote)") {
+		t.Errorf("system_server.te lost the ordinary zygote socket connection")
+	}
+
+	app, err := os.ReadFile("../../private/app.te")
+	if err != nil {
+		t.Fatalf("read app.te: %v", err)
+	}
+	appText := string(app)
+	for _, required := range []string{
+		"allow appdomain zygote:fd use;\nis_flag_enabled(RELEASE_NATIVE_FRAMEWORK_PROTOTYPE, `\nallow appdomain zygote_next:fd use;\n')",
+		"allow appdomain zygote:unix_dgram_socket write;\nis_flag_enabled(RELEASE_NATIVE_FRAMEWORK_PROTOTYPE, `\nallow appdomain zygote_next:unix_dgram_socket write;\n')",
+		"allow appdomain app_zygote:fd use;",
+	} {
+		if !strings.Contains(appText, required) {
+			t.Errorf("app.te missing expected guarded/ordinary text: %q", required)
+		}
+	}
+
+	fileContexts, err := os.ReadFile("../../private/file_contexts")
+	if err != nil {
+		t.Fatalf("read file_contexts: %v", err)
+	}
+	for _, required := range []string{"/dev/socket/zygote_next", "/system/bin/zygote_next"} {
+		if !strings.Contains(string(fileContexts), required) {
+			t.Errorf("file_contexts lost %q", required)
+		}
+	}
+	domain, err := os.ReadFile("../../private/domain.te")
+	if err != nil {
+		t.Fatalf("read domain.te: %v", err)
+	}
+	if !strings.Contains(string(domain), "-zygote_next") || !strings.Contains(string(domain), "  zygote_next\n") {
+		t.Errorf("domain.te lost the zygote_next neverallow exclusion")
+	}
+}
