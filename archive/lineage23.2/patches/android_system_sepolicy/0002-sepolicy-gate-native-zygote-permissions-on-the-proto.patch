+// TestAospSelinuxFlagsIncludesZygoteNextSelector verifies that the real
+// aosp_selinux_flags registration is what feeds se_flags_collector, so deleting
+// the zygote_next selector flag from the production Android.bp fails this test.
+func TestAospSelinuxFlagsIncludesZygoteNextSelector(t *testing.T) {
+	realBp, err := os.ReadFile("../../flagging/Android.bp")
+	if err != nil {
+		t.Fatalf("read real flagging/Android.bp: %v", err)
+	}
+	text := string(realBp)
+	if !strings.Contains(text, `"RELEASE_NATIVE_FRAMEWORK_PROTOTYPE"`) {
+		t.Fatalf("RELEASE_NATIVE_FRAMEWORK_PROTOTYPE is not registered in the real aosp_selinux_flags list")
+	}
+	start := strings.Index(text, "se_flags {")
+	if start < 0 {
+		t.Fatalf("real flagging/Android.bp has no se_flags block")
+	}
+	end := strings.Index(text[start:], "\n}\n")
+	if end < 0 {
+		t.Fatalf("cannot isolate real se_flags block")
+	}
+	flagsBlock := text[start : start+end+3]
+	fixtureBp := flagsBlock + `
+	se_flags_collector {
+		name: "all_selinux_flags",
+	}
+	`
+	for _, tc := range []struct {
+		name  string
+		value string
+		want  string
+	}{
+		{"off_empty", "", "-D target_flag_RELEASE_NATIVE_FRAMEWORK_PROTOTYPE="},
+		{"on_true", "true", "-D target_flag_RELEASE_NATIVE_FRAMEWORK_PROTOTYPE=true"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			ctx := android.GroupFixturePreparers(
+				prepareForTest,
+				android.FixtureModifyProductVariables(func(variables android.FixtureProductVariables) {
+					variables.BuildFlags["RELEASE_NATIVE_FRAMEWORK_PROTOTYPE"] = tc.value
+					variables.BuildFlags["RELEASE_RANGING_STACK"] = "true"
+				}),
+				android.FixtureAddTextFile("system/sepolicy/flagging/Android.bp", fixtureBp),
+			).RunTest(t).TestContext
+
+			collectorModule := ctx.ModuleForTests(t, "all_selinux_flags", "").Module()
+			collectorData, ok := android.OtherModuleProvider(ctx.OtherModuleProviderAdaptor(), collectorModule, buildFlagsInfoProvider)
+			if !ok {
+				t.Fatalf("all_selinux_flags must provide buildFlags")
+			}
+			actual := flagsToM4Macros(collectorData.BuildFlags)
+			expected := []string{
+				"-D target_flag_RELEASE_AVF_ENABLE_DEVICE_ASSIGNMENT=true",
+				tc.want,
+				"-D target_flag_RELEASE_RANGING_STACK=true",
+			}
+			if !reflect.DeepEqual(actual, expected) {
+				t.Errorf("M4 macros did not preserve real registration/order"+
+					"\nactual:   %v"+
+					"\nexpected: %v", actual, expected)
+			}
+		})
+	}
+}
