+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+#include "recovery_loader_guard.h"
+#include "recovery_enforcement.h"
+
+#include <stdio.h>
+#include <string.h>
+#include <dlfcn.h>
+#include <link.h>
+#include <unistd.h>
+
+extern char** environ;
+
+namespace rothko::recovery::loader_guard {
+
+namespace {
+
+constexpr size_t kMaxObjectNames = 256;
+constexpr size_t kSelfPathMax = 4096;
+constexpr size_t kExpectedContextLength = sizeof(own_attr::kRecoveryContext) - 1;
+
+void SetError(char* error, size_t error_size, const char* format, const char* value) {
+  if (error == nullptr || error_size == 0) return;
+  snprintf(error, error_size, format, value != nullptr ? value : "(null)");
+}
+
+// A private library name must be exactly one path segment under the private
+// lib64 directory and look like a shared object.  No subdirectories, no ".",
+// no "..", no public absolute path.
+bool IsPrivateLibraryName(const char* name) {
+  constexpr size_t kPrefixLen = sizeof(kPrivateLibDirPrefix) - 1;
+  if (strncmp(name, kPrivateLibDirPrefix, kPrefixLen) != 0) return false;
+
+  const char* base = name + kPrefixLen;
+  if (base[0] == '\0') return false;
+  if (strchr(base, '/') != nullptr) return false;
+  if (strcmp(base, ".") == 0 || strcmp(base, "..") == 0) return false;
+
+  const size_t len = strlen(base);
+  if (len > 3 && strcmp(base + len - 3, ".so") == 0) return true;
+  return strstr(base, ".so.") != nullptr;
+}
+
+bool IsApprovedObjectName(const char* name, bool* saw_program, bool* saw_private_lib) {
+  if (name == nullptr || name[0] == '\0') return false;
+  if (strcmp(name, kRecoveryProgram) == 0) {
+    *saw_program = true;
+    return true;
+  }
+  if (strcmp(name, kPrivateLinker) == 0) return true;
+  if (strcmp(name, kLinkerInterpName) == 0) return true;
+  if (strcmp(name, kVdsoName) == 0) return true;
+  if (IsPrivateLibraryName(name)) {
+    *saw_private_lib = true;
+    return true;
+  }
+  return false;
+}
+
+struct CollectContext {
+  const char* names[kMaxObjectNames];
+  size_t count;
+  bool overflow;
+};
+
+int CollectObjectName(struct dl_phdr_info* info, size_t /*size*/, void* data) {
+  auto* context = static_cast<CollectContext*>(data);
+  if (context->count >= kMaxObjectNames) {
+    context->overflow = true;
+    return 1;
+  }
+  context->names[context->count++] = info->dlpi_name;
+  return 0;
+}
+
+}  // namespace
+
+GuardStatus EvaluateGuardFacts(const GuardFacts& facts) {
+  // An absent auxv entry is getauxval()==0 with errno=ENOENT; it is not a
+  // valid zero.  The dynamic Recovery requires a real AT_SECURE==0.
+  if (!facts.auxv.valid) return GuardStatus::kAuxvUnavailable;
+  if (facts.auxv.value != 0) return GuardStatus::kAtSecureNonZero;
+
+  if (facts.uid != 0 || facts.euid != 0) return GuardStatus::kIdentity;
+  if (facts.gid != facts.egid) return GuardStatus::kIdentity;
+
+  if (facts.own_context.status != own_attr::Status::kExact) return GuardStatus::kContext;
+  if (strncmp(facts.own_context.value, own_attr::kRecoveryContext,
+              kExpectedContextLength) != 0 ||
+      facts.own_context.value[kExpectedContextLength] != '\0') {
+    return GuardStatus::kContext;
+  }
+  return GuardStatus::kOk;
+}
+
+const char* GuardStatusName(GuardStatus status) {
+  switch (status) {
+    case GuardStatus::kOk:
+      return "ok";
+    case GuardStatus::kAuxvUnavailable:
+      return "AT_SECURE auxv is unavailable (0+ENOENT is not a valid zero)";
+    case GuardStatus::kAtSecureNonZero:
+      return "AT_SECURE is not a valid zero for the dynamic Recovery";
+    case GuardStatus::kIdentity:
+      return "uid/gid is not ruid==euid==0 with rgid==egid";
+    case GuardStatus::kContext:
+      return "SELinux context is not exactly u:r:recovery:s0";
+  }
+  return "unknown guard status";
+}
+
+void SanitizeEnvironment() {
+  for (char** entry = environ; entry != nullptr && *entry != nullptr;) {
+    if (strncmp(*entry, "LD_", 3) != 0) {
+      ++entry;
+      continue;
+    }
+    // Shift the remaining pointers left and re-examine this slot.
+    char** cursor = entry;
+    while (*(cursor + 1) != nullptr) {
+      *cursor = *(cursor + 1);
+      ++cursor;
+    }
+    *cursor = nullptr;
+  }
+}
+
+bool EnvironmentIsSanitized() {
+  for (char** entry = environ; entry != nullptr && *entry != nullptr; ++entry) {
+    if (strncmp(*entry, "LD_", 3) == 0) return false;
+  }
+  return true;
+}
+
+bool AuditObjectNames(const char* const* names, size_t count, char* error, size_t error_size) {
+  if (error != nullptr && error_size > 0) error[0] = '\0';
+  if (names == nullptr || count == 0) {
+    SetError(error, error_size, "no loaded objects reported: %s", nullptr);
+    return false;
+  }
+
+  bool saw_program = false;
+  bool saw_private_lib = false;
+  for (size_t i = 0; i < count; ++i) {
+    if (!IsApprovedObjectName(names[i], &saw_program, &saw_private_lib)) {
+      char index[32] = {};
+      snprintf(index, sizeof(index), "object[%zu]", i);
+      if (error != nullptr && error_size > 0) {
+        snprintf(error, error_size, "%s not approved: %s", index,
+                 names[i] != nullptr ? names[i] : "(null)");
+      }
+      return false;
+    }
+  }
+
+  if (!saw_program) {
+    SetError(error, error_size, "expected Recovery program %s was not loaded", kRecoveryProgram);
+    return false;
+  }
+  if (!saw_private_lib) {
+    SetError(error, error_size, "no private library under %s was loaded", kPrivateLibDirPrefix);
+    return false;
+  }
+  return true;
+}
+
+const char* UiExtensionOpenPath(bool private_runtime_enabled, const char* non_private_default) {
+  if (private_runtime_enabled) return kUiExtensionPath;
+  return non_private_default != nullptr ? non_private_default : kUiExtensionBareSoname;
+}
+
+bool IsApprovedUiExtensionPath(const char* path) {
+  return path != nullptr && strcmp(path, kUiExtensionPath) == 0;
+}
+
+bool SanitizeAndAuditEarly() {
+  if (!rothko::recovery::enforcement::KernelIsEnforcing()) {
+    fprintf(stderr, "recovery-loader-guard: require actual Enforcing; refuse\n");
+    return false;
+  }
+  GuardFacts facts;
+  facts.auxv = transition::ReadAtSecureAuxv();
+  facts.uid = getuid();
+  facts.euid = geteuid();
+  facts.gid = getgid();
+  facts.egid = getegid();
+  facts.own_context = own_attr::Read();
+  fprintf(stderr,
+          "recovery-loader-guard: entry auxv_valid=%d AT_SECURE=%lu uid=%u euid=%u gid=%u egid=%u context_status=%d sid=%s\n",
+          facts.auxv.valid, facts.auxv.value, facts.uid, facts.euid, facts.gid, facts.egid,
+          static_cast<int>(facts.own_context.status),
+          facts.own_context.status == own_attr::Status::kExact
+              ? facts.own_context.value : "(not-exact-or-unavailable)");
+
+  const GuardStatus status = EvaluateGuardFacts(facts);
+  if (status != GuardStatus::kOk) {
+    fprintf(stderr, "recovery-loader-guard: %s; refusing to continue\n",
+            GuardStatusName(status));
+    return false;
+  }
+
+  SanitizeEnvironment();
+  if (!EnvironmentIsSanitized()) {
+    fprintf(stderr, "recovery-loader-guard: LD_* variable survived sanitization\n");
+    return false;
+  }
+
+  char self[kSelfPathMax] = {};
+  const ssize_t self_len = readlink("/proc/self/exe", self, sizeof(self) - 1);
+  if (self_len <= 0 || static_cast<size_t>(self_len) >= sizeof(self)) {
+    fprintf(stderr, "recovery-loader-guard: cannot read /proc/self/exe\n");
+    return false;
+  }
+  self[self_len] = '\0';
+  if (strcmp(self, kPrivateLinker) != 0) {
+    fprintf(stderr, "recovery-loader-guard: process was not started by %s (got %s)\n",
+            kPrivateLinker, self);
+    return false;
+  }
+
+  CollectContext context{};
+  if (dl_iterate_phdr(CollectObjectName, &context) != 0 || context.overflow) {
+    fprintf(stderr, "recovery-loader-guard: loaded-object enumeration failed\n");
+    return false;
+  }
+
+  for (size_t i = 0; i < context.count; ++i) {
+    fprintf(stderr, "recovery-loader-guard: loaded[%zu]=%s\n", i,
+            context.names[i] != nullptr ? context.names[i] : "(null)");
+  }
+
+  char error[512] = {};
+  if (!AuditObjectNames(context.names, context.count, error, sizeof(error))) {
+    fprintf(stderr, "recovery-loader-guard: %s\n", error);
+    return false;
+  }
+  return true;
+}
+
+bool VerifyUiExtensionProvider(void* handle, char* error, size_t error_size) {
+  if (error != nullptr && error_size > 0) error[0] = '\0';
+  // dlopen failure is the standard builtin make_device() fallback and is
+  // allowed.  A successful dlopen, however, must be the private build.
+  if (handle == nullptr) return true;
+
+  void* symbol = dlsym(handle, "make_device");
+  if (symbol == nullptr) {
+    SetError(error, error_size, "UI extension has no make_device: %s", dlerror());
+    return false;
+  }
+
+  Dl_info info{};
+  if (dladdr(symbol, &info) == 0 || info.dli_fname == nullptr) {
+    SetError(error, error_size, "cannot resolve UI extension provider path: %s", nullptr);
+    return false;
+  }
+  if (!IsApprovedUiExtensionPath(info.dli_fname)) {
+    SetError(error, error_size, "UI extension resolved outside the private runtime: %s",
+             info.dli_fname);
+    return false;
+  }
+  return true;
+}
+
+}  // namespace rothko::recovery::loader_guard
