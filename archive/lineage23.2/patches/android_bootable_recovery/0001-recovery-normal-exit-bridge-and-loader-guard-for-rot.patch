+// SPDX-License-Identifier: Apache-2.0
+// Diagnostic only. Fixed phases on the existing normal-exit path; not a hang fix.
+#pragma once
+
+#include <atomic>
+#include <cstddef>
+#include <android-base/logging.h>
+
+namespace rothko::recovery::postcommit {
+
+// Inline variable is shared by recovery_main/librecovery/libotautil in the
+// recovery executable (librecovery and libotautil are static libraries).
+inline std::atomic<bool> g_reply_observed{false};
+
+// Only the main-thread hook calls this, after the real COMMITTED write reports
+// success. Observation does NOT mean final eligibility, reboot, or boot success.
+inline void ObserveCommittedReply() {
+  g_reply_observed.store(true, std::memory_order_relaxed);
+}
+
+// Accept literal arrays only. Call sites below contain fixed, non-sensitive
+// tokens, never argv/BCB/path/SID/property values or peer-supplied text.
+// No device/file read, new sink, flush/fsync, retry, or control-flow side effect.
+// INFO avoids UiLogger's ERROR -> ui->Print path while diagnosing UI/volmgr.
+template <std::size_t N>
+inline void Phase(const char (&phase)[N]) {
+  if (g_reply_observed.load(std::memory_order_relaxed)) {
+    LOG(INFO) << "rothko-normal-exit-phase/1 " << phase;
+  }
+}
+
+}  // namespace rothko::recovery::postcommit
diff --git a/otautil/sysutil.cpp b/otautil/sysutil.cpp
