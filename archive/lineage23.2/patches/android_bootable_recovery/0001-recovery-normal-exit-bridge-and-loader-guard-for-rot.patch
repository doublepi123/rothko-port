diff --git a/recovery_enforcement.h b/recovery_enforcement.h
new file mode 100644
index 00000000..46b5fe09
--- /dev/null
+++ b/recovery_enforcement.h
@@ -0,0 +1,72 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+#pragma once
+#include <stddef.h>
+#include <fcntl.h>
+#include <sys/stat.h>
+#include <sys/statfs.h>
+#include <unistd.h>
+
+namespace rothko::recovery::enforcement {
+constexpr char kEnforce[] = "/sys/fs/selinux/enforce";
+constexpr unsigned long kSelinuxMagic = 0xf97cff8cUL;
+enum class Outcome { kAlreadyEnforcing, kTightenedVerified, kReadFailed,
+                     kInvalidMode, kWriteFailed, kReadbackFailed, kNotEnforcing };
+struct ReadResult { bool ok = false; int mode = -1; };
+struct Hooks {
+    ReadResult (*read)();
+    bool (*write_one)();
+};
+inline bool Accepted(Outcome outcome) {
+    return outcome == Outcome::kAlreadyEnforcing || outcome == Outcome::kTightenedVerified;
+}
+inline int ParseMode(const char* data, size_t size) {
+    if (!data || (size != 1 && size != 2)) return -1;
+    if (size == 2 && data[1] != '\n') return -1;
+    return data[0] == '0' ? 0 : data[0] == '1' ? 1 : -1;
+}
+// A transition may only strengthen. Never attempts a write when already1,
+// never writes0, never retries a failed/uncertain write, never promotes read errors.
+inline Outcome Tighten(const Hooks& hooks) {
+    if (!hooks.read || !hooks.write_one) return Outcome::kReadFailed;
+    const ReadResult initial = hooks.read();
+    if (!initial.ok) return Outcome::kReadFailed;
+    if (initial.mode == 1) return Outcome::kAlreadyEnforcing;
+    if (initial.mode != 0) return Outcome::kInvalidMode;
+    if (!hooks.write_one()) return Outcome::kWriteFailed;
+    const ReadResult after = hooks.read();
+    if (!after.ok) return Outcome::kReadbackFailed;
+    return after.mode == 1 ? Outcome::kTightenedVerified : Outcome::kNotEnforcing;
+}
+inline bool ReadOnlyRequired(const Hooks& hooks) {
+    if (!hooks.read) return false;
+    const ReadResult value = hooks.read();
+    return value.ok && value.mode == 1;
+}
+inline bool CorrectFilesystem(int fd) {
+    struct statfs fs {};
+    return fstatfs(fd, &fs) == 0 && static_cast<unsigned long>(fs.f_type) == kSelinuxMagic;
+}
+inline ReadResult ReadKernelMode() {
+    const int fd = open(kEnforce, O_RDONLY | O_CLOEXEC | O_NOFOLLOW);
+    if (fd < 0) return {};
+    if (!CorrectFilesystem(fd)) { close(fd); return {}; }
+    char data[4] = {};
+    const ssize_t got = read(fd, data, sizeof(data));
+    const bool closed = close(fd) == 0;
+    if (got <= 0 || !closed) return {};
+    const int mode = ParseMode(data, static_cast<size_t>(got));
+    return {mode >= 0, mode};
+}
+inline bool WriteKernelOne() {
+    const int fd = open(kEnforce, O_WRONLY | O_CLOEXEC | O_NOFOLLOW);
+    if (fd < 0) return false;
+    if (!CorrectFilesystem(fd)) { close(fd); return false; }
+    // Exactly one standard selinuxfs enforcement request. No general path/value API.
+    const ssize_t written = write(fd, "1", 1);
+    const bool closed = close(fd) == 0;
+    return written == 1 && closed;
+}
+inline Hooks KernelHooks() { return {ReadKernelMode, WriteKernelOne}; }
+inline Outcome TightenKernel() { return Tighten(KernelHooks()); }
+inline bool KernelIsEnforcing() { return ReadOnlyRequired(KernelHooks()); }
+}  // namespace rothko::recovery::enforcement
