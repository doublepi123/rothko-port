+
+#pragma once
+
+#include <errno.h>
+#include <sys/auxv.h>
+
+#include <elf.h>
+
+// Shared auxv read facts for the static launcher and the earliest-main guard.
+//
+// getauxval() returns 0 and sets errno=ENOENT when the auxv entry is absent.
+// A bare 0 is therefore NOT proof that AT_SECURE exists and is zero.  The
+// reader clears errno first and immediately captures it, and callers must
+// require `valid` before interpreting `value`.
+namespace rothko::recovery::transition {
+
+struct AuxvFacts {
+  unsigned long value = 0;
+  int saved_errno = 0;
+  bool valid = false;
+};
+
+inline AuxvFacts MakeAuxvFacts(unsigned long value, int saved_errno) {
+  AuxvFacts facts;
+  facts.value = value;
+  facts.saved_errno = saved_errno;
+  facts.valid = saved_errno == 0;
+  return facts;
+}
+
+inline AuxvFacts ReadAtSecureAuxv() {
+  errno = 0;
+  const unsigned long value = getauxval(AT_SECURE);
+  const int saved_errno = errno;
+  return MakeAuxvFacts(value, saved_errno);
+}
+
+}  // namespace rothko::recovery::transition
