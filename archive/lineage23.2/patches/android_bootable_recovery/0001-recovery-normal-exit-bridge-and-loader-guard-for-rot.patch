+namespace rothko::recovery {
+
+// Adapter helper, not a second coordinator: reproduces the standard
+// get_args()/update_bootloader_message() rewrite of a boot-recovery BCB so the
+// pre-get_args capture can be compared with the post-get_args BCB by key.
+//
+// The raw capture is validated as clean *before* this is called. Returns false
+// when the field is not the canonical "recovery\n<option>\n..." form, in which
+// case the caller keeps the raw capture and the core blocks it.
+bool CanonicalizeBootRecovery(const std::vector<std::string>& argv_options,
+                              const std::string& recovery_field,
+                              std::string* canonical);
+
+}  // namespace rothko::recovery
diff --git a/normal_exit/normal_exit.cpp b/normal_exit/normal_exit.cpp
new file mode 100644
index 00000000..7b40a9d0
--- /dev/null
+++ b/normal_exit/normal_exit.cpp
@@ -0,0 +1,439 @@
+// SPDX-FileCopyrightText: The LineageOS Project
+// SPDX-License-Identifier: Apache-2.0
+
+#include "normal_exit.h"
+
+#include <string>
+#include <utility>
+
+namespace rothko::recovery {
+namespace {
+
+struct ParsedArgs {
+  std::vector<std::string> args;
+  std::optional<Reason> reason;
+  bool show_text = false;
+};
+
+bool ParseReasonValue(std::string_view value, Reason* out) {
+  if (value == "userrequested") {
+    *out = Reason::kUserRequested;
+    return true;
+  }
+  if (value == "adb") {
+    *out = Reason::kAdb;
+    return true;
+  }
+  if (value == "recovery_ui") {
+    *out = Reason::kRecoveryUi;
+    return true;
+  }
+  return false;
+}
+
+bool ParseArgTokens(const std::vector<std::string>& in, ParsedArgs* out) {
+  bool reason_seen = false;
+  for (const auto& arg : in) {
+    if (arg == "--show_text") {
+      if (out->show_text) return false;
+      out->show_text = true;
+      continue;
+    }
+    if (arg.rfind("--reason=", 0) == 0) {
+      Reason reason;
+      if (reason_seen || !ParseReasonValue(std::string_view(arg).substr(9), &reason)) {
+        return false;
+      }
+      out->reason = reason;
+      reason_seen = true;
+      continue;
+    }
+    return false;  // any update/wipe/sideload/locale/fastboot/unknown arg
+  }
+  out->args = in;
+  return true;
+}
+
+std::vector<std::string> SplitLines(std::string_view text) {
+  std::vector<std::string> lines;
+  std::size_t start = 0;
+  while (true) {
+    const std::size_t pos = text.find('\n', start);
+    if (pos == std::string_view::npos) {
+      lines.emplace_back(text.substr(start));
+      break;
+    }
+    lines.emplace_back(text.substr(start, pos - start));
+    start = pos + 1;
+  }
+  return lines;
+}
+
+bool ParseRecoveryField(std::string_view field, ParsedArgs* out) {
+  if (field.empty()) return true;
+  // The standard writer emits "recovery\n" and appends each option followed by
+  // a newline. A non-empty field without the canonical first line is unknown.
+  if (field.back() != '\n') return false;
+  const auto lines = SplitLines(field);
+  if (lines.size() < 2 || lines.front() != "recovery") return false;
+  std::vector<std::string> args;
+  for (std::size_t i = 1; i < lines.size(); ++i) {
+    if (lines[i].empty()) {
+      if (i + 1 == lines.size()) continue;  // trailing newline
+      return false;                        // internal empty line
+    }
+    args.push_back(lines[i]);
+  }
+  return ParseArgTokens(args, out);
+}
+
+bool Evaluate(const Capture& capture, ParsedArgs* argv, ParsedArgs* bcb,
+              std::optional<Reason>* derived_reason, std::string* why) {
+  auto fail = [&](const char* reason) {
+    if (why != nullptr) *why = reason;
+    return false;
+  };
+  if (!capture.captured_before_get_args) return fail("captured_after_get_args");
+  if (capture.argv_status != ReadStatus::kOk) return fail("argv_read_error");
+  if (capture.bcb_status != ReadStatus::kOk) return fail("bcb_read_error");
+  if (capture.commandfile == CommandFile::kError) return fail("commandfile_read_error");
+  if (capture.commandfile == CommandFile::kPresent) return fail("commandfile_present");
+  if (capture.reason_status != ReadStatus::kOk) return fail("reason_read_error");
+  if (capture.stage_status != ReadStatus::kOk) return fail("stage_read_error");
+  if (!capture.bcb.status.empty()) return fail("bcb_status_nonempty");
+  if (!capture.bcb.stage.empty()) return fail("bcb_stage_nonempty");
+  if (!capture.bcb.reserved_zero) return fail("bcb_reserved_nonzero");
+  if (capture.bcb.command != "" && capture.bcb.command != "boot-recovery") {
+    return fail("bcb_command_unknown");
+  }
+  if (capture.stage && !capture.stage->empty()) return fail("stage_nonempty");
+
+  ParsedArgs argv_args;
+  ParsedArgs bcb_args;
+  if (!ParseArgTokens(capture.argv, &argv_args)) return fail("argv_not_pure_manual_idle");
+  if (!ParseRecoveryField(capture.bcb.recovery, &bcb_args)) {
+    return fail("bcb_recovery_unknown");
+  }
+  if (capture.bcb.command.empty() && !capture.bcb.recovery.empty()) {
+    return fail("recovery_without_boot_recovery");
+  }
+
+  if (argv_args.reason && bcb_args.reason && *argv_args.reason != *bcb_args.reason) {
+    return fail("argv_bcb_reason_mismatch");
+  }
+  std::optional<Reason> derived =
+      argv_args.reason ? argv_args.reason : bcb_args.reason;
+
+  std::optional<Reason> independent;
+  if (capture.reason && !capture.reason->empty()) {
+    Reason reason;
+    if (!ParseReasonValue(*capture.reason, &reason)) return fail("reason_unknown");
+    independent = reason;
+  }
+  if (derived && !independent) return fail("reason_source_missing");
+  if (!derived && independent) return fail("reason_source_unexpected");
+  if (derived && independent && *derived != *independent) {
+    return fail("reason_source_mismatch");
+  }
+
+  if (argv != nullptr) *argv = std::move(argv_args);
+  if (bcb != nullptr) *bcb = std::move(bcb_args);
+  if (derived_reason != nullptr) *derived_reason = derived;
+  return true;
+}
+
+}  // namespace
+
+const char* ToString(State state) {
+  switch (state) {
+    case State::kBlocked: return "BLOCKED";
+    case State::kIdleClean: return "IDLE_CLEAN";
+    case State::kNormalPending: return "NORMAL_PENDING";
+    case State::kCommitting: return "COMMITTING";
+    case State::kCommitted: return "COMMITTED";
+    case State::kErrorHold: return "ERROR_HOLD";
+  }
+  return "ERROR_HOLD";
+}
+
+const char* ToString(Result result) {
+  switch (result) {
+    case Result::kBlockedCapture: return "BLOCKED_CAPTURE";
+    case Result::kIdleClean: return "IDLE_CLEAN";
+    case Result::kNormalAcceptedWakeTopMenu: return "NORMAL_ACCEPTED_WAKE_TOP_MENU";
+    case Result::kRejectedAuth: return "REJECTED_AUTH";
+    case Result::kRejectedFrame: return "REJECTED_FRAME";
+    case Result::kRejectedBusy: return "REJECTED_BUSY";
+    case Result::kRejectedRepeat: return "REJECTED_REPEAT";
+    case Result::kRejectedClosed: return "REJECTED_CLOSED";
+    case Result::kRejectedStaleWindow: return "REJECTED_STALE_WINDOW";
+    case Result::kRejectedStaleToken: return "REJECTED_STALE_TOKEN";
+    case Result::kCommitCancelledWindow: return "COMMIT_CANCELLED_WINDOW";
+    case Result::kCommittedNotBootValidated: return "COMMITTED_NOT_BOOT_VALIDATED";
+    case Result::kErrorHold: return "ERROR_HOLD";
+  }
+  return "ERROR_HOLD";
+}
+
+std::string_view StatusLine(State state) {
+  switch (state) {
+    case State::kBlocked: return "STATUS/1 BLOCKED\n";
+    case State::kIdleClean: return "STATUS/1 IDLE_CLEAN\n";
+    case State::kNormalPending: return "STATUS/1 NORMAL_PENDING\n";
+    case State::kCommitting: return "STATUS/1 COMMITTING\n";
+    case State::kCommitted: return "STATUS/1 COMMITTED\n";
+    case State::kErrorHold: return "STATUS/1 ERROR_HOLD\n";
+  }
+  return "STATUS/1 ERROR_HOLD\n";
+}
+
+bool CaptureIsClean(const Capture& capture, std::string* why) {
+  return Evaluate(capture, nullptr, nullptr, nullptr, why);
+}
+
+std::string CaptureKey(const Capture& capture) {
+  ParsedArgs argv_args;
+  ParsedArgs bcb_args;
+  std::optional<Reason> reason;
+  if (!Evaluate(capture, &argv_args, &bcb_args, &reason, nullptr)) return {};
+
+  std::string key;
+  key += capture.bcb.command.empty() ? "C0" : "C1";
+  key += capture.bcb.recovery.empty() ? "R0" : "R1";
+  key += argv_args.show_text ? "t" : "-";
+  key += bcb_args.show_text ? "t" : "-";
+  key += reason ? std::to_string(static_cast<int>(*reason)) : "n";
+  key += '|';
+  for (const auto& arg : argv_args.args) {
+    key += arg;
+    key += '\x1f';
+  }
+  key += '|';
+  for (const auto& arg : bcb_args.args) {
+    key += arg;
+    key += '\x1f';
+  }
+  return key;
+}
+
+bool IsTrustedAdbd(const PeerCredentials& peer) {
+  return peer.getcred_ok && peer.getsec_ok && peer.uid == 2000 &&
+         peer.sid == "u:r:adbd:s0";
+}
+
+bool IsNormalFrame(FrameRead read, std::string_view frame) {
+  if (read != FrameRead::kOk) return false;
+  if (frame.size() > kMaxFrameBytes) return false;
+  return frame == kNormalFrame;
+}
+
+Coordinator::Coordinator(Capture initial, Hooks hooks)
+    : hooks_(std::move(hooks)) {
+  if (CaptureIsClean(initial)) {
+    initial_key_ = CaptureKey(initial);
+    state_ = State::kIdleClean;
+  } else {
+    state_ = State::kBlocked;
+  }
+}
+
+State Coordinator::state() const {
+  std::lock_guard<std::mutex> lock(mu_);
+  return state_;
+}
+
+bool Coordinator::top_menu_open() const {
+  std::lock_guard<std::mutex> lock(mu_);
+  return top_menu_open_;
+}
+
+std::uint64_t Coordinator::generation() const {
+  std::lock_guard<std::mutex> lock(mu_);
+  return generation_;
+}
+
+std::uint64_t Coordinator::pending_token() const {
+  std::lock_guard<std::mutex> lock(mu_);
+  return pending_token_;
+}
+
+Result Coordinator::EnterTopMenu() {
+  std::lock_guard<std::mutex> lock(mu_);
+  switch (state_) {
+    case State::kBlocked: return Result::kBlockedCapture;
+    case State::kCommitted: return Result::kCommittedNotBootValidated;
+    case State::kErrorHold: return Result::kErrorHold;
+    case State::kCommitting: return Result::kRejectedBusy;
+    case State::kNormalPending:
+      if (top_menu_open_) return Result::kRejectedBusy;
+      break;
+    case State::kIdleClean:
+      if (top_menu_open_) return Result::kRejectedBusy;
+      break;
+  }
+  top_menu_open_ = true;
+  peer_closed_ = false;
+  ++generation_;
+  return Result::kIdleClean;
+}
+
+Result Coordinator::LeaveTopMenu() {
+  std::lock_guard<std::mutex> lock(mu_);
+  if (state_ == State::kCommitting) return Result::kRejectedBusy;
+  top_menu_open_ = false;
+  ++generation_;
+  if (state_ == State::kNormalPending) {
+    state_ = State::kIdleClean;
+    pending_token_ = 0;
+    return Result::kCommitCancelledWindow;
+  }
+  switch (state_) {
+    case State::kBlocked: return Result::kBlockedCapture;
+    case State::kIdleClean: return Result::kIdleClean;
+    case State::kCommitted: return Result::kCommittedNotBootValidated;
+    case State::kErrorHold: return Result::kErrorHold;
+    case State::kNormalPending:
+    case State::kCommitting:
+      break;
+  }
+  return Result::kRejectedBusy;
+}
+
+RequestOutcome Coordinator::RequestNormal(const PeerCredentials& peer, FrameRead read,
+                                          std::string_view frame,
+                                          std::uint64_t observed_generation) {
+  if (!IsNormalFrame(read, frame)) return {Result::kRejectedFrame, false};
+  if (!IsTrustedAdbd(peer)) return {Result::kRejectedAuth, false};
+
+  std::lock_guard<std::mutex> lock(mu_);
+  switch (state_) {
+    case State::kBlocked:
+      return {Result::kBlockedCapture, false};
+    case State::kNormalPending:
+      return {Result::kRejectedRepeat, false};
+    case State::kCommitting:
+    case State::kCommitted:
+    case State::kErrorHold:
+      return {Result::kRejectedBusy, false};
+    case State::kIdleClean:
+      break;
+  }
+  if (!top_menu_open_) return {Result::kRejectedClosed, false};
+  if (observed_generation != generation_) {
+    return {Result::kRejectedStaleWindow, false};
+  }
+  pending_token_ = next_token_++;
+  peer_closed_ = false;
+  state_ = State::kNormalPending;
+  return {Result::kNormalAcceptedWakeTopMenu, true};
+}
+
+CommitOutcome Coordinator::Hold(bool cleanup_started, bool reply_sent) {
+  {
+    std::lock_guard<std::mutex> lock(mu_);
+    state_ = State::kErrorHold;
+    top_menu_open_ = false;
+    pending_token_ = 0;
+    ++generation_;
+  }
+  return {Result::kErrorHold, cleanup_started, reply_sent, false};
+}
+
+CommitOutcome Coordinator::ConfirmCommit(std::uint64_t observed_generation,
+                                         std::uint64_t token) {
+  {
+    std::lock_guard<std::mutex> lock(mu_);
+    switch (state_) {
+      case State::kBlocked: return {Result::kBlockedCapture, false, false, false};
+      case State::kErrorHold: return {Result::kErrorHold, false, false, false};
+      case State::kCommitting:
+      case State::kCommitted:
+      case State::kIdleClean:
+        return {Result::kRejectedBusy, false, false, false};
+      case State::kNormalPending:
+        break;
+    }
+    if (!top_menu_open_ || observed_generation != generation_) {
+      state_ = State::kIdleClean;
+      top_menu_open_ = false;
+      pending_token_ = 0;
+      ++generation_;
+      return {Result::kCommitCancelledWindow, false, false, false};
+    }
+    if (token != pending_token_) {
+      return {Result::kRejectedStaleToken, false, false, false};
+    }
+    state_ = State::kCommitting;
+  }
+
+  auto peer_closed = [this] {
+    std::lock_guard<std::mutex> lock(mu_);
+    return peer_closed_;
+  };
+
+  bool cleanup_started = false;
+  bool reply_sent = false;
+
+  if (peer_closed()) return Hold(cleanup_started, reply_sent);
+  if (!hooks_.read_fresh) return Hold(cleanup_started, reply_sent);
+  const FreshCapture fresh = hooks_.read_fresh();
+  if (!fresh.ok) return Hold(cleanup_started, reply_sent);
+  if (!CaptureIsClean(fresh.capture) ||
+      CaptureKey(fresh.capture) != initial_key_) {
+    return Hold(cleanup_started, reply_sent);
+  }
+  if (peer_closed()) return Hold(cleanup_started, reply_sent);
+
+  cleanup_started = true;
+  if (!hooks_.standard_clear) return Hold(cleanup_started, reply_sent);
+  const ClearResult cleared = hooks_.standard_clear();
+  if (!cleared.ok || !cleared.wrote || !cleared.fsync_ok) {
+    return Hold(cleanup_started, reply_sent);
+  }
+
+  // After a successful clear, still re-read and check the command state even
+  // if the peer closed; this records the post-clear state without any reply or
+  // reboot. Never restore the old BCB.
+  if (!hooks_.readback_verify) return Hold(cleanup_started, reply_sent);
+  const ReadbackResult readback = hooks_.readback_verify();
+  if (!readback.ok || !readback.read_ok || !readback.clean) {
+    return Hold(cleanup_started, reply_sent);
+  }
+
+  if (!hooks_.command_cleanup_status) return Hold(cleanup_started, reply_sent);
+  const BoolResult command = hooks_.command_cleanup_status();
+  if (!command.ok || !command.value) return Hold(cleanup_started, reply_sent);
+
+  if (peer_closed()) return Hold(cleanup_started, reply_sent);
+  if (!hooks_.send_reply) return Hold(cleanup_started, reply_sent);
+  const ReplyResult reply = hooks_.send_reply(kCommittedLine);
+  if (!reply.ok || !reply.sent) return Hold(cleanup_started, reply_sent);
+  reply_sent = true;
+
+  {
+    std::lock_guard<std::mutex> lock(mu_);
+    state_ = State::kCommitted;
+  }
+
+  if (peer_closed()) return Hold(cleanup_started, reply_sent);
+  if (!hooks_.eligible_device_reboot) return Hold(cleanup_started, reply_sent);
+  const RebootResult reboot = hooks_.eligible_device_reboot();
+  if (!reboot.ok || !reboot.requested) return Hold(cleanup_started, reply_sent);
+
+  return {Result::kCommittedNotBootValidated, true, true, true};
+}
+
+void Coordinator::OnPeerClosed() {
+  std::lock_guard<std::mutex> lock(mu_);
+  peer_closed_ = true;
+  if (state_ == State::kNormalPending) {
+    // A pending client that disappears is an error, not a silent retry:
+    // no cleanup is run and the session holds without a reboot.
+    state_ = State::kErrorHold;
+    top_menu_open_ = false;
+    pending_token_ = 0;
+    ++generation_;
+  }
+}
+
+}  // namespace rothko::recovery
diff --git a/normal_exit/normal_exit.h b/normal_exit/normal_exit.h
new file mode 100644
index 00000000..47b4cdc0
--- /dev/null
+++ b/normal_exit/normal_exit.h
@@ -0,0 +1,214 @@
+// SPDX-FileCopyrightText: The LineageOS Project
+// SPDX-License-Identifier: Apache-2.0
+//
+// Normal-exit coordinator core for OEM recovery's adbd-triggered path.
+//
+// This is a production-intended core, not a toy model: the capture validator,
+// state machine, peer authentication, frame parser, cleanup order and failure
+// handling are the logic the real recovery adapter must reuse. The adapter is
+// deliberately thin: it reads BCB/argv/commandfile/reason/stage before
+// get_args() mutates them, supplies the fixed adbd credentials, and implements
+// the cleanup hooks with the real recovery primitives.
+//
+// REVIEW-ONLY: the adbd daemon UID/SID, the OEM ELF localreserved path and the
+// actual transport authentication still need parent evidence. A 2000/adbd
+// credential set proves only that the peer is the trusted adbd process.
+//
+// No Android headers, no UI, no filesystem writes, no signing.
+
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <functional>
+#include <mutex>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace rothko::recovery {
+
+inline constexpr std::string_view kNormalFrame = "ROTHKO-NORMAL/1\n";
+inline constexpr std::string_view kAcceptedLine = "ROTHKO-NORMAL/1 ACCEPTED\n";
+inline constexpr std::string_view kRejectedLine = "ROTHKO-NORMAL/1 REJECTED\n";
+inline constexpr std::string_view kCommittedLine = "COMMITTED\n";
+inline constexpr std::size_t kMaxFrameBytes = 32;
+
+enum class State {
+  kBlocked,
+  kIdleClean,
+  kNormalPending,
+  kCommitting,
+  kCommitted,
+  kErrorHold,
+};
+
+enum class Result {
+  kBlockedCapture,
+  kIdleClean,
+  kNormalAcceptedWakeTopMenu,
+  kRejectedAuth,
+  kRejectedFrame,
+  kRejectedBusy,
+  kRejectedRepeat,
+  kRejectedClosed,
+  kRejectedStaleWindow,
+  kRejectedStaleToken,
+  kCommitCancelledWindow,
+  kCommittedNotBootValidated,
+  kErrorHold,
+};
+
+enum class ReadStatus { kOk, kError };
+enum class CommandFile { kAbsent, kPresent, kError };
+enum class FrameRead { kOk, kEmpty, kTruncated, kOversize, kUnknown, kTimeout, kClosed };
+enum class Reason { kUserRequested, kAdb, kRecoveryUi };
+
+const char* ToString(State state);
+const char* ToString(Result result);
+std::string_view StatusLine(State state);  // fixed STATUS/1 <state>\n, no BCB data
+
+struct BcbView {
+  std::string command;
+  std::string status;
+  std::string recovery;
+  std::string stage;
+  bool reserved_zero = false;
+};
+
+struct Capture {
+  bool captured_before_get_args = false;
+  ReadStatus argv_status = ReadStatus::kError;
+  std::vector<std::string> argv;
+  ReadStatus bcb_status = ReadStatus::kError;
+  BcbView bcb;
+  CommandFile commandfile = CommandFile::kError;
+  ReadStatus reason_status = ReadStatus::kError;
+  std::optional<std::string> reason;
+  ReadStatus stage_status = ReadStatus::kError;
+  std::optional<std::string> stage;
+};
+
+struct PeerCredentials {
+  bool getcred_ok = false;
+  std::uint32_t uid = 0;
+  bool getsec_ok = false;
+  std::string sid;
+};
+
+struct FreshCapture {
+  bool ok = false;
+  Capture capture;
+};
+
+struct ClearResult {
+  bool ok = false;
+  bool wrote = false;
+  bool fsync_ok = false;
+};
+
+struct ReadbackResult {
+  bool ok = false;
+  bool read_ok = false;
+  bool clean = false;
+};
+
+struct BoolResult {
+  bool ok = false;
+  bool value = false;
+};
+
+struct ReplyResult {
+  bool ok = false;
+  bool sent = false;
+};
+
+struct RebootResult {
+  bool ok = false;
+  bool requested = false;  // only Device::REBOOT eligibility, never sys.powerctl
+};
+
+struct Hooks {
+  std::function<FreshCapture()> read_fresh;
+  std::function<ClearResult()> standard_clear;
+  std::function<ReadbackResult()> readback_verify;
+  std::function<BoolResult()> command_cleanup_status;  // verify absence only; never unlink
+  std::function<ReplyResult(std::string_view)> send_reply;
+  std::function<RebootResult()> eligible_device_reboot;
+};
+
+struct RequestOutcome {
+  Result result = Result::kRejectedBusy;
+  bool should_wake_top_menu = false;
+};
+
+struct CommitOutcome {
+  Result result = Result::kRejectedBusy;
+  bool cleanup_started = false;
+  bool reply_sent = false;
+  bool reboot_requested = false;
+};
+
+// Pure conservative capture validator. On failure, *why (if non-null) is a
+// fixed reason token and never contains BCB/argv/user data.
+bool CaptureIsClean(const Capture& capture, std::string* why = nullptr);
+
+// Internal decision fingerprint; only clean captures have a non-empty key.
+// It contains normalized allowed enum/arg tokens, never unknown BCB content.
+std::string CaptureKey(const Capture& capture);
+
+bool IsTrustedAdbd(const PeerCredentials& peer);
+bool IsNormalFrame(FrameRead read, std::string_view frame);
+
+class Coordinator {
+ public:
+  Coordinator(Capture initial, Hooks hooks);
+
+  Coordinator(const Coordinator&) = delete;
+  Coordinator& operator=(const Coordinator&) = delete;
+
+  State state() const;
+  bool top_menu_open() const;
+  std::uint64_t generation() const;
+  std::uint64_t pending_token() const;
+
+  // The top menu window is the only place a normal request may be accepted.
+  // Leaving the window (any update/wipe/sideload/submenu) invalidates the
+  // generation and drops a pending request without cleanup.
+  Result EnterTopMenu();
+  Result LeaveTopMenu();
+
+  // frame must be exactly kNormalFrame. observed_generation is the generation
+  // the socket handler saw for the current top-menu window.
+  RequestOutcome RequestNormal(const PeerCredentials& peer, FrameRead read,
+                               std::string_view frame,
+                               std::uint64_t observed_generation);
+
+  // Re-reads every source via hooks.read_fresh(), revalidates it and compares
+  // the decision key with the initial capture before touching BCB. Any
+  // failure => ERROR_HOLD; no old-BCB fallback and no automatic retry.
+  CommitOutcome ConfirmCommit(std::uint64_t observed_generation,
+                              std::uint64_t token);
+
+  // Call when the accepted client socket closes. Before COMMITTING this moves
+  // a pending request to ERROR_HOLD with zero cleanup. During COMMITTING it
+  // records the close flag; ConfirmCommit rechecks it before standard_clear
+  // (zero cleanup if already closed) and before reply/reboot (no reboot).
+  void OnPeerClosed();
+
+ private:
+  CommitOutcome Hold(bool cleanup_started, bool reply_sent);
+
+  mutable std::mutex mu_;
+  std::string initial_key_;
+  Hooks hooks_;
+  State state_;
+  bool top_menu_open_ = false;
+  std::uint64_t generation_ = 0;
+  std::uint64_t next_token_ = 1;
+  std::uint64_t pending_token_ = 0;
+  bool peer_closed_ = false;
+};
+
+}  // namespace rothko::recovery
diff --git a/normal_exit/normal_exit_posix.cpp b/normal_exit/normal_exit_posix.cpp
new file mode 100644
index 00000000..6174fd60
--- /dev/null
+++ b/normal_exit/normal_exit_posix.cpp
@@ -0,0 +1,138 @@
+// SPDX-FileCopyrightText: The LineageOS Project
+// SPDX-License-Identifier: Apache-2.0
+
+#ifndef _GNU_SOURCE
+#define _GNU_SOURCE
+#endif
+
+#include "normal_exit_posix.h"
+
+#include <poll.h>
+#include <sys/socket.h>
+#include <unistd.h>
+
+#include <algorithm>
+#include <cerrno>
+#include <chrono>
+#include <cstring>
+#include <string>
+
+#ifndef SO_PEERSEC
+#define SO_PEERSEC 31
+#endif
+
+namespace rothko::recovery {
+namespace {
+
+int RemainingMs(std::chrono::steady_clock::time_point deadline) {
+  const auto now = std::chrono::steady_clock::now();
+  if (now >= deadline) return 0;
+  const auto remain =
+      std::chrono::duration_cast<std::chrono::milliseconds>(deadline - now).count();
+  return remain <= 0 ? 1 : static_cast<int>(std::min<long long>(remain, 10000));
+}
+
+}  // namespace
+
+PeerIdentity ReadPeerIdentity(int fd) {
+  PeerIdentity peer;
+  struct ucred cred {};
+  socklen_t cred_len = sizeof(cred);
+  if (getsockopt(fd, SOL_SOCKET, SO_PEERCRED, &cred, &cred_len) == 0 &&
+      cred_len == sizeof(cred)) {
+    peer.getcred_ok = true;
+    peer.uid = cred.uid;
+  }
+
+  char sid[4096] = {};
+  socklen_t sid_len = sizeof(sid);
+  if (getsockopt(fd, SOL_SOCKET, SO_PEERSEC, sid, &sid_len) == 0) {
+    const std::size_t len = strnlen(sid, sizeof(sid));
+    peer.getsec_ok = true;
+    peer.sid.assign(sid, len);
+  }
+  return peer;
+}
+
+bool AuthorizePeer(const PeerIdentity& peer, std::string* why) {
+  PeerCredentials cred;
+  cred.getcred_ok = peer.getcred_ok;
+  cred.uid = static_cast<std::uint32_t>(peer.uid);
+  cred.getsec_ok = peer.getsec_ok;
+  cred.sid = peer.sid;
+  if (!IsTrustedAdbd(cred)) {
+    if (why != nullptr) *why = "peer_not_trusted_adbd";
+    return false;
+  }
+  return true;
+}
+
+FrameReadResult ReadNormalFrame(int fd, int timeout_ms) {
+  if (timeout_ms <= 0) return {FrameRead::kTimeout, {}};
+  const auto deadline =
+      std::chrono::steady_clock::now() + std::chrono::milliseconds(timeout_ms);
+  std::string line;
+
+  for (;;) {
+    const int remain = RemainingMs(deadline);
+    if (remain <= 0) return {FrameRead::kTimeout, line};
+
+    struct pollfd pfd {};
+    pfd.fd = fd;
+    pfd.events = POLLIN;
+    const int polled = poll(&pfd, 1, remain);
+    if (polled == 0) return {FrameRead::kTimeout, line};
+    if (polled < 0) {
+      if (errno == EINTR) continue;
+      return {FrameRead::kUnknown, line};
+    }
+
+    char ch = 0;
+    const ssize_t got = recv(fd, &ch, 1, MSG_DONTWAIT);
+    if (got < 0) {
+      if (errno == EINTR) continue;
+      if (errno == EAGAIN || errno == EWOULDBLOCK) continue;
+      return {FrameRead::kUnknown, line};
+    }
+    if (got == 0) {
+      return {line.empty() ? FrameRead::kClosed : FrameRead::kTruncated, line};
+    }
+    line.push_back(ch);
+    if (ch == '\n') return {FrameRead::kOk, line};
+    if (line.size() > kMaxFrameBytes) {
+      return {FrameRead::kOversize, line.substr(0, kMaxFrameBytes)};
+    }
+  }
+}
+
+bool WriteAll(int fd, std::string_view data, int timeout_ms) {
+  if (timeout_ms <= 0) return false;
+  const auto deadline =
+      std::chrono::steady_clock::now() + std::chrono::milliseconds(timeout_ms);
+  std::size_t offset = 0;
+  while (offset < data.size()) {
+    const int remain = RemainingMs(deadline);
+    if (remain <= 0) return false;
+    struct pollfd pfd {};
+    pfd.fd = fd;
+    pfd.events = POLLOUT;
+    const int polled = poll(&pfd, 1, remain);
+    if (polled == 0) return false;
+    if (polled < 0) {
+      if (errno == EINTR) continue;
+      return false;
+    }
+    const ssize_t wrote =
+        send(fd, data.data() + offset, data.size() - offset, MSG_DONTWAIT);
+    if (wrote < 0) {
+      if (errno == EINTR) continue;
+      if (errno == EAGAIN || errno == EWOULDBLOCK) continue;
+      return false;
+    }
+    if (wrote == 0) return false;
+    offset += static_cast<std::size_t>(wrote);
+  }
+  return true;
+}
+
+}  // namespace rothko::recovery
diff --git a/normal_exit/normal_exit_posix.h b/normal_exit/normal_exit_posix.h
new file mode 100644
index 00000000..3a2c3c47
--- /dev/null
+++ b/normal_exit/normal_exit_posix.h
@@ -0,0 +1,50 @@
+// SPDX-FileCopyrightText: The LineageOS Project
+// SPDX-License-Identifier: Apache-2.0
+//
+// Thin real POSIX boundary for the normal-exit core.
+//
+// Only socket credential reads, finite-deadline poll/recv and finite-deadline
+// send. No exec, no filesystem, no properties, no BCB access, no shell.
+// The production recovery adapter owns the actual accepted Unix socket; this
+// file is host-testable and does not create/listen on any socket.
+
+#pragma once
+
+#include <sys/types.h>
+
+#include <string>
+#include <string_view>
+
+#include "normal_exit.h"
+
+namespace rothko::recovery {
+
+struct PeerIdentity {
+  bool getcred_ok = false;
+  uid_t uid = 0;
+  bool getsec_ok = false;
+  std::string sid;
+};
+
+// SO_PEERCRED + SO_PEERSEC; any getsockopt failure is reported as such.
+PeerIdentity ReadPeerIdentity(int fd);
+
+// Fixed production rule: UID 2000 (non-root) and exact SID u:r:adbd:s0.
+// This only authorizes the trusted adbd process, not transport auth.
+bool AuthorizePeer(const PeerIdentity& peer, std::string* why = nullptr);
+
+struct FrameReadResult {
+  FrameRead status = FrameRead::kUnknown;
+  std::string line;
+};
+
+// One-shot fixed-frame read. One monotonic total deadline covers every poll
+// and recv; the deadline is never reset between fragments. At most 32 bytes
+// are retained; a longer line is OVERSIZE. EOF with a partial line is
+// TRUNCATED, EOF with no bytes is CLOSED.
+FrameReadResult ReadNormalFrame(int fd, int timeout_ms);
+
+// Optional fixed-line reply helper with the same total-deadline rule.
+bool WriteAll(int fd, std::string_view data, int timeout_ms);
+
+}  // namespace rothko::recovery
