index 00000000..0ac0f367
--- /dev/null
+++ b/recovery_launcher.h
@@ -0,0 +1,153 @@
+/*
+ * Copyright (C) 2026 The LineageOS Project
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *      http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+#pragma once
+
+#include <stddef.h>
+
+#include "own_attr_context.h"
+#include "static_transition_facts.h"
+
+// Fixed-path static launcher for the private Recovery runtime.
+//
+// This launcher is selected only by the Recovery service command line.  It has
+// exactly one target: the private linker in the private runtime directory,
+// loading the Recovery program from its original, unmodified location
+// /system/bin/recovery.  No target path, program name or loader setting is
+// accepted from arguments, environment or any file.  Every refusal is a
+// non-zero exit with nothing executed (fail closed, no public fallback).
+//
+// Static first-stage transition (2026-11-08 policy evidence):
+// init -> recovery is allowed but noatsecure is DENIED, so init's explicit
+// seclabel entry can give this static launcher AT_SECURE=1.  The static
+// launcher therefore accepts a valid auxv AT_SECURE of 0 or 1, but BOTH values
+// must pass the same complete admission: ruid==euid==0, rgid==egid, exact
+// SELinux domain u:r:recovery:s0, the one fixed private self path,
+// root-owned regular file, no set-id and no group/world write.  It clears
+// every foreign LD_* and sets only the fixed private LD_LIBRARY_PATH, then
+// execve()s the private linker.
+//
+// An auxv entry that is absent (getauxval returns 0 with errno=ENOENT) is NOT
+// treated as a valid zero.  HostFacts.auxv defaults to invalid.
+//
+// This is NOT a relaxation of the dynamic Recovery guard: the private linker
+// re-computes secureexec for the next exec, and Recovery's earliest-main guard
+// still requires a valid AT_SECURE==0, ruid==euid==0, rgid==egid, the real
+// recovery SID, and an all-private DT_NEEDED set.  A static first stage
+// accepting 1 never means the dynamic Recovery may ignore LD_*.
+namespace rothko::recovery::launcher {
+
+// The private runtime paths are build/packaging constants.  They are fixed at
+// compile time and are never derived from argv or the environment.
+inline constexpr const char kPrivateLinker[] = "/system/recovery-runtime/bin/linker64";
+inline constexpr const char kRecoveryProgram[] = "/system/bin/recovery";
+inline constexpr const char kPrivateLibDir[] = "/system/recovery-runtime/lib64";
+inline constexpr const char kPrivateLibDirPrefix[] = "/system/recovery-runtime/lib64/";
+inline constexpr const char kLoaderPathVariable[] = "LD_LIBRARY_PATH";
+inline constexpr const char kFixedLoaderPathValue[] = "/system/recovery-runtime/lib64";
+
+// The one approved production path of this launcher itself.  Main builds a
+// normal cc_binary intermediate (which may sit at OUT/.../system/bin) and its
+// authorized vendor_boot packer places the artifact here.  The intermediate
+// build path is never executed and this launcher does not accept it as a
+// runtime identity.  No other path is accepted.
+inline constexpr const char kSelfPathPrivate[] = "/system/recovery-runtime/bin/recovery-launcher";
+
+// Exact SELinux context required for the static first stage.  The kernel
+// normally appends a NUL (some kernels a newline); no other trailing bytes,
+// whitespace, category suffix or extra SID is accepted.
+inline constexpr const char kExpectedSelinuxContext[] = "u:r:recovery:s0";
+inline constexpr size_t kMaxContextBytes = own_attr::kMaxBytes;
+
+// Shared own-attr types/helpers (also used by the earliest-main guard).
+using OwnContextStatus = own_attr::Status;
+using OwnContext = own_attr::Context;
+
+inline OwnContext ParseOwnContextBytes(const char* raw, size_t length) {
+  return own_attr::Parse(raw, length);
+}
+
+inline OwnContext ReadOwnSelinuxContext() {
+  return own_attr::Read();
+}
+
+// Every non-zero value means: nothing executed, process refused.
+enum ExitCode : int {
+  kExitOk = 0,
+  kExitExecFailed = 100,
+  kExitAtSecure = 101,
+  kExitIdentity = 102,
+  kExitArguments = 103,
+  kExitEnvironment = 104,
+  kExitContext = 105,
+  kExitUnexpected = 111,
+};
+
+// Largest accepted original argv (including argv[0]).  The forwarded child
+// argv is argc + 1 entries (private linker, program, original argv[1:]).
+inline constexpr int kMaxProgramArgc = 61;
+
+// Facts gathered by the real main() and injected by host tests.  All pointers
+// are borrowed; nothing is owned.  Defaults are fail-closed: invalid auxv,
+// non-root ids and an unreadable context.
+struct HostFacts {
+  transition::AuxvFacts auxv;     // defaults invalid (auxv_valid == false)
+  unsigned uid = 1;               // getuid()
+  unsigned euid = 1;              // geteuid()
+  unsigned gid = 1;               // getgid()
+  unsigned egid = 1;              // getegid()
+  const char* self_exe = nullptr; // readlink("/proc/self/exe"); nullptr on failure
+  bool self_stat_ok = false;      // stat("/proc/self/exe") succeeded
+  unsigned self_mode = 0;         // st_mode of the launcher file
+  unsigned self_uid = 0;          // st_uid of the launcher file
+  const char* const* envp = nullptr; // environ
+  OwnContext own_context;         // exact u:r:recovery:s0 required
+};
+
+// The exec sink.  Production uses execve(2); tests use a recorder.  The
+// launcher never falls back to execvp/execl/shell.
+using ExecFn = int (*)(const char* path, char* const argv[], char* const envp[]);
+
+// Owning storage for the child environment.  Fixed size; exceeding a limit is
+// a refusal, not silent truncation.
+struct EnvBuffer {
+  static constexpr size_t kMaxVars = 256;
+  static constexpr size_t kMaxBytes = 16384;
+
+  char storage[kMaxBytes] = {};
+  char* ptrs[kMaxVars + 2] = {};
+  size_t count = 0;
+  size_t used = 0;
+};
+
+// Pure policy check: valid auxv AT_SECURE 0/1, root real+effective uid, equal
+// real+effective gid, exact domain, approved launcher path, file permissions
+// and argument shape.  It deliberately does NOT inspect or reinterpret
+// recovery arguments; the original recovery parser stays authoritative.
+ExitCode ValidateInvocation(const HostFacts& facts, int argc, char** argv);
+
+// Builds the child environment from `envp`: every variable whose name begins
+// with "LD_" is dropped (LD_PRELOAD, LD_AUDIT, LD_DEBUG, LD_CONFIG_FILE,
+// LD_LIBRARY_PATH, LD_SHOW_AUXV, ...), every other variable is preserved
+// byte-for-byte (this keeps ANDROID_SOCKET_* and ANDROID_ROOT intact), and
+// exactly one fixed LD_LIBRARY_PATH is appended.
+bool BuildChildEnvironment(const char* const* envp, EnvBuffer* out);
+
+// Validates, builds the environment and calls `exec`.  Returns kExitExecFailed
+// if `exec` returns (production execve must not return on success).
+ExitCode Run(const HostFacts& facts, int argc, char** argv, ExecFn exec, EnvBuffer* env_out);
+
+}  // namespace rothko::recovery::launcher
