+  char self[4096] = {};
+  const ssize_t self_len = readlink("/proc/self/exe", self, sizeof(self) - 1);
+  if (self_len > 0 && static_cast<size_t>(self_len) < sizeof(self)) {
+    self[self_len] = '\0';
+    facts.self_exe = self;
+  }
+
+  struct stat self_stat {};
+  if (stat("/proc/self/exe", &self_stat) == 0) {
+    facts.self_stat_ok = true;
+    facts.self_mode = static_cast<unsigned>(self_stat.st_mode);
+    facts.self_uid = static_cast<unsigned>(self_stat.st_uid);
+  }
+
+  facts.envp = environ;
+
+  const int code = static_cast<int>(rl::Run(facts, argc, argv, execve, nullptr));
+  if (code != static_cast<int>(rl::kExitOk)) {
+    fprintf(stderr, "recovery-launcher: refused (exit %d): %s\n", code, RefusalReason(code));
+  }
+  return code;
+}
+
+#endif  // !ROTHKO_RECOVERY_LAUNCHER_CORE_ONLY
