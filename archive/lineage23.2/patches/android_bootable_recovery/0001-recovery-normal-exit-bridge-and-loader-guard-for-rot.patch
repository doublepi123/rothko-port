+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+#pragma once
+
+#include <errno.h>
+#include <fcntl.h>
+#include <stddef.h>
+#include <string.h>
+#include <unistd.h>
+
+// Shared, bounded reader for the process's own SELinux context.
+//
+// /proc/self/attr/current is a regular proc attribute, NOT a symlink: it must
+// be opened and read, never readlink()ed.  The reader is read-only
+// (O_RDONLY|O_CLOEXEC), bounded, short-read aware, and never consults argv, the
+// environment, a property or a caller-supplied file.  Both the static launcher
+// and the earliest-main guard use this same helper.
+namespace rothko::recovery::own_attr {
+
+inline constexpr const char kRecoveryContext[] = "u:r:recovery:s0";
+inline constexpr size_t kMaxBytes = 96;
+
+enum class Status : int {
+  kExact = 0,
+  kOpenFailed,
+  kReadFailed,
+  kEmpty,
+  kTooLong,
+  kMalformed,
+};
+
+struct Context {
+  Status status = Status::kReadFailed;
+  char value[kMaxBytes] = {};
+};
+
+namespace detail {
+
+inline constexpr size_t kExpectedLength = sizeof(kRecoveryContext) - 1;
+
+inline bool IsTerminator(char value) {
+  return value == '\0' || value == '\n';
+}
+
+}  // namespace detail
+
+// Accepted: exactly "u:r:recovery:s0", optionally followed by one NUL or one
+// newline.  Everything else fails closed.
+inline Context Parse(const char* raw, size_t length) {
+  Context out{};
+  if (raw == nullptr || length == 0) {
+    out.status = Status::kEmpty;
+    return out;
+  }
+  if (length >= kMaxBytes) {
+    out.status = Status::kTooLong;
+    return out;
+  }
+  if (length < detail::kExpectedLength) {
+    out.status = Status::kMalformed;
+    return out;
+  }
+  for (size_t i = 0; i < detail::kExpectedLength; ++i) {
+    if (raw[i] != kRecoveryContext[i]) {
+      out.status = Status::kMalformed;
+      return out;
+    }
+  }
+  if (length == detail::kExpectedLength) {
+    // exact, no terminator
+  } else if (length == detail::kExpectedLength + 1 &&
+             detail::IsTerminator(raw[detail::kExpectedLength])) {
+    // exactly one trailing NUL or newline
+  } else {
+    out.status = Status::kMalformed;
+    return out;
+  }
+  memcpy(out.value, kRecoveryContext, detail::kExpectedLength);
+  out.value[detail::kExpectedLength] = '\0';
+  out.status = Status::kExact;
+  return out;
+}
+
+inline Context Read() {
+  Context out{};
+  const int fd = open("/proc/self/attr/current", O_RDONLY | O_CLOEXEC);
+  if (fd < 0) {
+    out.status = Status::kOpenFailed;
+    return out;
+  }
+
+  char raw[kMaxBytes + 1] = {};
+  size_t total = 0;
+  for (;;) {
+    const ssize_t n = read(fd, raw + total, sizeof(raw) - total);
+    if (n < 0) {
+      if (errno == EINTR) continue;
+      out.status = Status::kReadFailed;
+      close(fd);
+      return out;
+    }
+    if (n == 0) break;
+    total += static_cast<size_t>(n);
+    if (total == sizeof(raw)) {
+      // Buffer filled: the attribute may be truncated.  Refuse rather than
+      // parse a prefix.
+      out.status = Status::kTooLong;
+      close(fd);
+      return out;
+    }
+  }
+  close(fd);
+
+  if (total == 0) {
+    out.status = Status::kEmpty;
+    return out;
+  }
+  return Parse(raw, total);
+}
+
+}  // namespace rothko::recovery::own_attr
