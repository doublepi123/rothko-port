+
+}  // namespace
+
+int main(int argc, char** argv) {
+  namespace rl = rothko::recovery::launcher;
+
+  rl::HostFacts facts{};
+  facts.auxv = rothko::recovery::transition::ReadAtSecureAuxv();
+  facts.uid = getuid();
+  facts.euid = geteuid();
+  facts.gid = getgid();
+  facts.egid = getegid();
+  facts.own_context = rl::ReadOwnSelinuxContext();
