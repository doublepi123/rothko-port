@@ -0,0 +1,124 @@
+/*
+ * Copyright (C) 2026 The LineageOS Project
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *      http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+#pragma once
+
+#include <stddef.h>
+
+#include "own_attr_context.h"
+#include "static_transition_facts.h"
+
+// Earliest-Recovery-main guard for the private runtime.
+//
+// Called as the FIRST statement of Recovery's main(), before logging,
+// properties, BCB access or any helper process.  It now checks, in order:
+//   1. a VALID auxv AT_SECURE == 0 (an absent auxv entry is 0 + ENOENT and is
+//      NOT a valid zero), and refuses any other value;
+//   2. ruid == euid == 0 and rgid == egid (no real/effective split);
+//   3. the real process SELinux context is exactly u:r:recovery:s0;
+//   4. removes every LD_* variable from the process environment;
+//   5. proves this process was started by the fixed private linker via
+//      /proc/self/exe;
+//   6. audits every already-loaded ELF object reported by dl_iterate_phdr and
+//      fails closed on any public/unknown/relative object.
+//
+// AT_SECURE == 0 alone never proves the recovery domain; the real SID read is
+// mandatory.  This does not relax any existing private-provider requirement.
+//
+// Boundary (must not be overstated): constructors of already-loaded objects
+// have already run before main(), and objects dlopen()ed later are not seen
+// here.  The guard can only refuse to continue; main must additionally check
+// the late UI-extension provider with VerifyUiExtensionProvider().
+namespace rothko::recovery::loader_guard {
+
+inline constexpr const char kPrivateLinker[] = "/system/recovery-runtime/bin/linker64";
+inline constexpr const char kRecoveryProgram[] = "/system/bin/recovery";
+// Bionic reports the running linker's dlpi_name from the Recovery ELF's
+// PT_INTERP string, which is the public path even when the kernel actually
+// executed the private linker.  The actual loader file is proven separately by
+// /proc/self/exe; this name is therefore a fixed, documented exception.
+inline constexpr const char kLinkerInterpName[] = "/system/bin/linker64";
+inline constexpr const char kPrivateLibDirPrefix[] = "/system/recovery-runtime/lib64/";
+inline constexpr const char kVdsoName[] = "[vdso]";
+
+// Bare soname used by non-private (default) device builds.  It must NEVER be
+// attempted on a private-runtime device: a bare name can resolve the public
+// OEM SDK34 C++ DSO and run its constructor before any post-dlopen check.
+inline constexpr const char kUiExtensionBareSoname[] = "librecovery_ui_ext.so";
+inline constexpr const char kUiExtensionPath[] = "/system/recovery-runtime/lib64/librecovery_ui_ext.so";
+
+// Returns the exact dlopen() argument the caller must use.
+//   private_runtime_enabled == true  -> always kUiExtensionPath (absolute),
+//                                       regardless of the non-private default.
+//   private_runtime_enabled == false -> the caller's original bare soname,
+//                                       preserving the pre-existing behaviour
+//                                       of devices that did not opt in.
+// The private-runtime device must pass true.  There is no runtime attempt-bare-
+// then-fallback sequence: the choice is made by main's unified device gate.
+const char* UiExtensionOpenPath(bool private_runtime_enabled, const char* non_private_default);
+
+// Facts used by the dynamic guard admission.  Defaults are fail-closed:
+// invalid auxv, non-root ids, unreadable context.
+struct GuardFacts {
+  transition::AuxvFacts auxv;
+  unsigned uid = 1;
+  unsigned euid = 1;
+  unsigned gid = 1;
+  unsigned egid = 1;
+  own_attr::Context own_context;
+};
+
+enum class GuardStatus : int {
+  kOk = 0,
+  kAuxvUnavailable,
+  kAtSecureNonZero,
+  kIdentity,
+  kContext,
+};
+
+// Pure facts evaluation; host tests inject facts.  Production fills the same
+// facts from getauxval/getuid/geteuid/getgid/getegid and the bounded own-attr
+// read, never from argv/environment/properties.
+GuardStatus EvaluateGuardFacts(const GuardFacts& facts);
+const char* GuardStatusName(GuardStatus status);
+
+// Removes every "LD_*" entry from environ in place, preserving every other
+// variable (notably ANDROID_SOCKET_* and ANDROID_ROOT).
+void SanitizeEnvironment();
+
+// True when no environ entry starts with "LD_".
+bool EnvironmentIsSanitized();
+
+// Pure audit over the object-name list reported by dl_iterate_phdr.  Returns
+// false (and fills `error`) on the first forbidden name, when the Recovery
+// program is absent, or when no private library was loaded.
+bool AuditObjectNames(const char* const* names, size_t count, char* error, size_t error_size);
+
+// Exact-path check for the only approved UI extension candidate.
+bool IsApprovedUiExtensionPath(const char* path);
+
+// Production entry.  Evaluates the real facts, prints a line per loaded object
+// for the boot log/evidence, and returns false on any failure; the caller must
+// fail closed and must not run the normal Recovery flow.
+bool SanitizeAndAuditEarly();
+
+// To be called immediately after the existing
+// dlopen("librecovery_ui_ext.so", RTLD_NOW) in recovery_main.cpp.
+// handle == nullptr (builtin fallback) is allowed.  A non-null handle is only
+// allowed when make_device actually resolves inside the exact private path.
+bool VerifyUiExtensionProvider(void* handle, char* error, size_t error_size);
+
+}  // namespace rothko::recovery::loader_guard
