+#pragma once
+
+#include <string>
+
+class RecoveryUI;
+
+// Thin same-process adapter between the recovery main loop / UI and the
+// normal-exit coordinator core in normal_exit/. The socket worker only
+// authenticates, emits the fixed identity banner, parses and queues a request;
+// every cleanup, reply decision and reboot eligibility is executed on the main
+// thread through these calls.
+//
+// Default-OFF: the adapter is compiled in but inert. FeatureEnabled() is false
+// unless the runtime property ro.rothko.recovery.normal_exit is "1" (and the
+// init socket exists). Define ROTHKO_RECOVERY_NORMAL_EXIT=0 for the recovery
+// target to remove the adapter at build time. This stage enables no device.
+namespace rothko::recovery::bridge {
+
+bool FeatureEnabled();
+
+// Device-private safety gate independent of IPC/property enablement. A failed
+// read or non-Enforcing observation holds this process until a fresh start.
+bool SecurityReadyForOperation();
+
+// Called from recovery_main() before get_args() can rewrite the BCB. Captures
+// argv, the full bootloader_message, stage and the command-file status. The
+// captured BCB is canonicalized exactly as get_args()/update_bootloader_message()
+// will rewrite it, but only after the *raw* capture was validated as clean.
+void CaptureBeforeGetArgs(int argc, char** argv, std::string* stage);
+
+// Called once the RecoveryUI exists. Creates the coordinator and the socket
+// listener when the feature is enabled. If the socket is unavailable the
+// feature stays inert and the pre-existing recovery behaviour is unchanged.
+void Start(RecoveryUI* ui);
+
+// Main-thread top-menu window bookkeeping. is_main_menu=false closes the window
+// (a submenu / wipe / advanced screen is not a valid normal-exit window).
+void EnsureTopMenuWindow(bool is_main_menu);
+void LeaveTopMenuWindow();
+
+// True while the prompt-time FinishRecovery() must not clear the BCB because the
+// pre-get_args capture and the commit fresh read have to describe the same BCB.
+// False once the feature is inert, preserving the original call semantics.
+bool PromptClearDeferred();
+
+// Consumes the one-shot flag set after a post-clear BCB readback proved empty.
+// The generic FinishRecovery() tail then skips a second protected clear.
+bool ConsumeVerifiedClear();
+
+// True while a blocked/held/pending normal-exit session must not take the menu
+// timeout/default reboot path. ERROR_HOLD, a blocked capture and an in-flight
+// request keep the menu alive instead of auto-rebooting over pending work.
+bool DefaultRebootSuppressed();
+
+enum class PromptInterrupt {
+  kNotOurs,    // another thread interrupted the menu (mode switch); keep old behaviour
+  kKeepMenu,   // our request was rejected/cancelled; stay in the menu
+  kReboot,     // committed and verified; return Device::REBOOT to recovery_main
+  kErrorHold,  // fail-closed; do not clear and do not reboot
+};
+
+// Runs the whole commit on the calling (main) thread.
+PromptInterrupt OnPromptInterrupt();
+
+// Joins the worker. Recovery normally reboots instead of returning, but the
+// runtime is still stoppable for tests and for a future orderly exit.
+void Stop();
+
+}  // namespace rothko::recovery::bridge
