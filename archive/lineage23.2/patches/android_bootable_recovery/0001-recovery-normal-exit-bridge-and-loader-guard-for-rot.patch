+// Deployment-owned names. The socket is init-provided (see OWNERS-HANDOFF.md);
+// this adapter never creates /dev/socket entries or SELinux policy.
+constexpr const char* kSocketName = "rothko_recovery_normal";
+constexpr const char* kCommandFile = "/cache/recovery/command";
+constexpr const char* kFeatureProperty = "ro.rothko.recovery.normal_exit";
+constexpr const char* kBuildIdProperty = "ro.rothko.recovery.runtime_build_id";
+// This is the actual runtime comparison value, also retained for hash-bound
+// pack admission; do not replace it with an unrelated sidecar marker.
+[[gnu::used, gnu::retain]] const char kExpectedBuildId[] = "rothko-recovery-sdk36-20261108-r2-phase";
+constexpr const char* kBootIdPath = "/proc/sys/kernel/random/boot_id";
+constexpr std::size_t kMaxIdentityBanner = 128;
+constexpr int kFrameTimeoutMs = 2000;
+constexpr int kReplyTimeoutMs = 2000;
+constexpr int kPollSliceMs = 100;
+constexpr int kPendingDeadlineMs = 15000;
+
+// Compiled in by default and inert at runtime: the rothko-only property is the
+// opt-in. Define ROTHKO_RECOVERY_NORMAL_EXIT=0 for the recovery target to remove
+// the adapter from the build entirely (optional kill switch).
+#if defined(ROTHKO_RECOVERY_NORMAL_EXIT) && ROTHKO_RECOVERY_NORMAL_EXIT == 0
+constexpr bool kCompiledIn = false;
+#else
+constexpr bool kCompiledIn = true;
+#endif
+
+// ---------------------------------------------------------------------------
+// Capture helpers. Only fixed outcome classes are logged; BCB payloads and
+// command-file contents are never printed.
+// ---------------------------------------------------------------------------
+
+template <std::size_t N>
+bool AllZero(const char (&data)[N]) {
+  for (std::size_t i = 0; i < N; ++i) {
+    if (data[i] != '\0') return false;
+  }
+  return true;
+}
+
+template <std::size_t N>
+bool FieldToString(const char (&data)[N], std::string* out) {
+  const void* nul = memchr(data, '\0', N);
+  if (nul == nullptr) return false;  // unterminated => unknown => block
+  out->assign(data, static_cast<const char*>(nul) - data);
+  return true;
+}
+
+bool ReadBcb(Capture* capture) {
+  bootloader_message boot = {};
+  std::string err;
+  if (!read_bootloader_message(&boot, &err)) {
+    LOG(ERROR) << "rothko-normal-exit: BCB read failed: " << err;
+    capture->bcb_status = ReadStatus::kError;
+    capture->bcb = {};
+    capture->stage_status = ReadStatus::kError;
+    capture->stage.reset();
+    return false;
+  }
+  capture->bcb_status = ReadStatus::kOk;
+  if (!FieldToString(boot.command, &capture->bcb.command) ||
+      !FieldToString(boot.status, &capture->bcb.status) ||
+      !FieldToString(boot.recovery, &capture->bcb.recovery) ||
+      !FieldToString(boot.stage, &capture->bcb.stage)) {
+    LOG(ERROR) << "rothko-normal-exit: BCB field unterminated";
+    capture->bcb_status = ReadStatus::kError;
+    return false;
+  }
+  capture->bcb.reserved_zero = AllZero(boot.reserved);
+  capture->stage_status = ReadStatus::kOk;
+  capture->stage = capture->bcb.stage;
+  return true;
+}
+
+CommandFile CommandFileStatus() {
+  if (!HasCache()) return CommandFile::kAbsent;
+  if (ensure_path_mounted(kCommandFile) != 0) return CommandFile::kError;
+  if (access(kCommandFile, F_OK) == 0) return CommandFile::kPresent;
+  return errno == ENOENT ? CommandFile::kAbsent : CommandFile::kError;
+}
+
+// get_args() rewrites a boot-recovery BCB into "recovery\n<options>". The raw
+// pre-get_args capture is validated first; only then is the known rewrite
+// applied so the commit-time fresh read can match the same key.
+void ApplyGetArgsRewrite(Capture* capture, const std::vector<std::string>& argv) {
+  if (capture->bcb_status != ReadStatus::kOk) return;
+  if (capture->bcb.command != "boot-recovery") return;
+  std::string canonical;
+  if (!CanonicalizeBootRecovery(argv, capture->bcb.recovery, &canonical)) {
+    // Not the canonical form: keep the raw field so the core blocks it.
+    return;
+  }
+  capture->bcb.recovery = std::move(canonical);
+}
+
+Capture BuildFreshCapture(const std::vector<std::string>& argv) {
+  Capture capture;
+  // The key this fresh read is compared against was captured before get_args();
+  // the flag records that provenance rather than the read time.
+  capture.captured_before_get_args = true;
+  capture.argv_status = ReadStatus::kOk;  // argv is immutable after exec
+  capture.argv = argv;
+  (void)ReadBcb(&capture);
+  capture.commandfile = CommandFileStatus();
+  // Production recovery has no independent reason source besides argv/BCB, so
+  // an independent reason is absent; --reason=... therefore blocks admission.
+  capture.reason_status = ReadStatus::kOk;
+  return capture;
+}
+
+struct InitialCapture {
+  std::mutex mu;
+  bool valid = false;
+  bool raw_clean = false;
+  Capture capture;
+  std::vector<std::string> argv;
+};
+
+InitialCapture& Initial() {
+  static InitialCapture initial;
+  return initial;
+}
+
+// ---------------------------------------------------------------------------
+// Runtime state
+// ---------------------------------------------------------------------------
+
+struct ActiveConnection {
+  int fd = -1;
+  std::mutex mu;
+  std::condition_variable cv;
+  std::string reply_line;
+  bool reply_pending = false;
+  bool reply_done = false;
+  bool reply_ok = false;
+  bool release = false;
+  bool closed = false;
+};
+
+std::mutex g_state_mu;
+std::unique_ptr<Coordinator> g_coord;
+RecoveryUI* g_ui = nullptr;
+std::vector<std::string> g_argv;
+int g_listen_fd = -1;
+bool g_listening = false;
+
+std::thread g_worker;
+std::atomic<bool> g_stopping{false};
+int g_stop_pipe[2] = {-1, -1};
+
+std::mutex g_active_mu;
+std::shared_ptr<ActiveConnection> g_active;
+
+std::atomic<bool> g_verified_clear{false};
+std::atomic<bool> g_security_hold{false};
+
+Coordinator* Coord() {
+  std::lock_guard<std::mutex> lock(g_state_mu);
+  return g_coord.get();
+}
+
+std::shared_ptr<ActiveConnection> GrabActive() {
+  std::lock_guard<std::mutex> lock(g_active_mu);
+  return g_active;
+}
+
+void ReleaseActive() {
+  std::shared_ptr<ActiveConnection> conn;
+  {
+    std::lock_guard<std::mutex> lock(g_active_mu);
+    conn = std::move(g_active);
+  }
+  if (!conn) return;
+  {
+    std::lock_guard<std::mutex> lock(conn->mu);
+    conn->release = true;
+  }
+  conn->cv.notify_all();
+}
+
+// ---------------------------------------------------------------------------
+// Hooks. Every cleanup/reboot hook runs on the main thread; send_reply hands
+// the fixed line to the socket worker and waits for its bounded write result.
+// ---------------------------------------------------------------------------
+
+FreshCapture ReadFreshHook() {
+  if (!SecurityReadyForOperation()) return FreshCapture{false, {}};
+  std::vector<std::string> argv;
+  {
+    std::lock_guard<std::mutex> lock(g_state_mu);
+    argv = g_argv;
+  }
+  Capture fresh = BuildFreshCapture(argv);
+  return FreshCapture{fresh.bcb_status == ReadStatus::kOk, std::move(fresh)};
+}
+
+ClearResult StandardClearHook() {
+  if (!SecurityReadyForOperation()) return {};
+  RecoveryUI* ui = nullptr;
+  {
+    std::lock_guard<std::mutex> lock(g_state_mu);
+    ui = g_ui;
+  }
+  if (ui == nullptr) return ClearResult{};
+  // The real, observable FinishRecovery clear: standard bootloader_message
+  // write+fsync, locale/log tail and the command-file unlink.
+  const RecoveryCleanupResult result =
+      FinishRecoveryChecked(ui, RecoveryFinishMode::kFull);
+  // clear_bootloader_message() returns true only after the standard write and
+  // fsync succeeded, so a cleared BCB is the real write+fsync result.
+  const bool cleared = result.bcb_cleared;
+  return ClearResult{cleared, cleared, cleared};
+}
+
+ReadbackResult ReadbackHook() {
+  if (!SecurityReadyForOperation()) return ReadbackResult{false, false, false};
+  bootloader_message boot = {};
+  std::string err;
+  if (!read_bootloader_message(&boot, &err)) {
+    LOG(ERROR) << "rothko-normal-exit: BCB readback failed: " << err;
+    return ReadbackResult{false, false, false};
+  }
+  const bool clean = AllZero(boot.command) && AllZero(boot.status) && AllZero(boot.recovery) &&
+                     AllZero(boot.stage) && AllZero(boot.reserved);
+  if (clean) g_verified_clear.store(true);
+  return ReadbackResult{true, true, clean};
+}
+
+BoolResult CommandStatusHook() {
+  if (!SecurityReadyForOperation()) return BoolResult{false, false};
+  if (!HasCache()) return BoolResult{true, true};
+  if (ensure_path_mounted(kCommandFile) != 0) return BoolResult{false, false};
+  if (access(kCommandFile, F_OK) == 0) return BoolResult{true, false};
+  return BoolResult{true, errno == ENOENT};
+}
+
+ReplyResult SendReplyHook(std::string_view line) {
+  if (!SecurityReadyForOperation()) return ReplyResult{false, false};
+  const std::shared_ptr<ActiveConnection> conn = GrabActive();
+  if (!conn) return ReplyResult{false, false};
+  std::unique_lock<std::mutex> lock(conn->mu);
+  if (conn->closed || conn->release) return ReplyResult{false, false};
+  conn->reply_line.assign(line);
+  conn->reply_pending = true;
+  conn->cv.notify_all();
+  const bool done = conn->cv.wait_for(lock, std::chrono::milliseconds(kReplyTimeoutMs),
+                                      [&conn] {
+                                        return conn->reply_done || conn->release || conn->closed;
+                                      });
+  if (!done || !conn->reply_ok) return ReplyResult{false, false};
+  // Diagnostics only, after the actual fixed reply was written. All original
+  // peer-close, security and final-readback eligibility checks still run.
+  postcommit::ObserveCommittedReply();
+  postcommit::Phase("committed_reply_observed");
+  return ReplyResult{true, true};
+}
+
+RebootResult RebootEligibleHook() {
+  postcommit::Phase("final_security.before");
+  if (!SecurityReadyForOperation()) {
+    postcommit::Phase("final_security.hold");
+    return {};
+  }
+  postcommit::Phase("final_security.after");
+  postcommit::Phase("final_readback.before");
+  const ReadbackResult final_read = ReadbackHook();
+  postcommit::Phase("final_readback.after");
+  if (!final_read.ok || !final_read.read_ok || !final_read.clean) {
+    return RebootResult{false, false};
+  }
+  return RebootResult{true, true};
+}
+
+Hooks MakeHooks() {
+  Hooks hooks;
+  hooks.read_fresh = [] { return ReadFreshHook(); };
+  hooks.standard_clear = [] { return StandardClearHook(); };
+  hooks.readback_verify = [] { return ReadbackHook(); };
+  hooks.command_cleanup_status = [] { return CommandStatusHook(); };
+  hooks.send_reply = [](std::string_view line) { return SendReplyHook(line); };
+  hooks.eligible_device_reboot = [] { return RebootEligibleHook(); };
+  return hooks;
+}
+
+// ---------------------------------------------------------------------------
+// Server identity banner. Values are read, never invented: the kernel boot ID
+// and a build ID that main sets. If either is unavailable the connection is
+// rejected before any normal frame is read.
+// ---------------------------------------------------------------------------
+
+bool IsUuid(const std::string& value) {
+  if (value.size() != 36) return false;
+  for (std::size_t i = 0; i < value.size(); ++i) {
+    const char c = value[i];
+    if (i == 8 || i == 13 || i == 18 || i == 23) {
+      if (c != '-') return false;
+      continue;
+    }
+    const bool hex = (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F');
+    if (!hex) return false;
+  }
+  return true;
+}
+
+bool ReadIdentity(std::string* boot_id, std::string* build_id) {
+  std::string content;
+  if (!android::base::ReadFileToString(kBootIdPath, &content)) return false;
+  *boot_id = android::base::Trim(content);
+  if (!IsUuid(*boot_id)) return false;
+  *build_id = android::base::GetProperty(kBuildIdProperty, "");
+  if (*build_id != kExpectedBuildId) return false;
+  if (build_id->empty() || build_id->size() > 64) return false;
+  for (const char c : *build_id) {
+    if (static_cast<unsigned char>(c) <= 0x20 || static_cast<unsigned char>(c) > 0x7e) {
+      return false;
+    }
+  }
+  return true;
+}
+
+// ---------------------------------------------------------------------------
+// Socket worker. Authenticate, parse one fixed frame, queue it in the
+// coordinator and keep the connection open for the main-thread reply decision.
+// No cleanup, reboot, exec or shell happens here.
+// ---------------------------------------------------------------------------
+
+void ServeConnection(int fd) {
+  if (!SecurityReadyForOperation()) { close(fd); return; }
+  auto conn = std::make_shared<ActiveConnection>();
+  conn->fd = fd;
+
+  const PeerIdentity peer = ReadPeerIdentity(fd);
+  if (!AuthorizePeer(peer)) {
+    LOG(WARNING) << "rothko-normal-exit: rejected peer identity";
+    (void)WriteAll(fd, kRejectedLine, kReplyTimeoutMs);
+    close(fd);
+    return;
+  }
+
+  std::string boot_id;
+  std::string build_id;
+  if (!ReadIdentity(&boot_id, &build_id)) {
+    LOG(WARNING) << "rothko-normal-exit: identity unavailable; rejected";
+    (void)WriteAll(fd, kRejectedLine, kReplyTimeoutMs);
+    close(fd);
+    return;
+  }
+  const std::string banner = "ROTHKO-IDENT/1 " + boot_id + " " + build_id + "\n";
+  if (banner.size() > kMaxIdentityBanner || !WriteAll(fd, banner, kReplyTimeoutMs)) {
+    close(fd);
+    return;
+  }
+
+  const FrameReadResult frame = ReadNormalFrame(fd, kFrameTimeoutMs);
+  if (!SecurityReadyForOperation()) { close(fd); return; }
+  Coordinator* coord = Coord();
+  if (coord == nullptr) {
+    close(fd);
+    return;
+  }
+  const PeerCredentials cred{peer.getcred_ok, static_cast<std::uint32_t>(peer.uid),
+                             peer.getsec_ok, peer.sid};
+  const RequestOutcome outcome =
+      coord->RequestNormal(cred, frame.status, frame.line, coord->generation());
+  if (!outcome.should_wake_top_menu) {
+    (void)WriteAll(fd, kRejectedLine, kReplyTimeoutMs);
+    close(fd);
+    return;
+  }
+
+  {
+    std::lock_guard<std::mutex> lock(g_active_mu);
+    g_active = conn;
+  }
+  {
+    std::lock_guard<std::mutex> lock(g_state_mu);
+    if (g_ui != nullptr) g_ui->InterruptKey();
+  }
+
+  const auto deadline =
+      std::chrono::steady_clock::now() + std::chrono::milliseconds(kPendingDeadlineMs);
+  for (;;) {
+    {
+      std::unique_lock<std::mutex> lock(conn->mu);
+      if (conn->reply_pending) {
+        const std::string line = conn->reply_line;
+        conn->reply_pending = false;
+        lock.unlock();
+        const bool ok = WriteAll(fd, line, kReplyTimeoutMs);
+        lock.lock();
+        conn->reply_done = true;
+        conn->reply_ok = ok;
+        lock.unlock();
+        conn->cv.notify_all();
+        continue;
+      }
+      if (conn->release || conn->closed) break;
+    }
+
+    if (std::chrono::steady_clock::now() >= deadline) {
+      // The main thread never reached the commit decision. Fail closed: hold the
+      // session without cleanup instead of wedging the only socket worker.
+      coord->OnPeerClosed();
+      {
+        std::lock_guard<std::mutex> lock(conn->mu);
+        conn->closed = true;
+      }
+      break;
+    }
+
+    struct pollfd fds[2] = {{fd, POLLIN, 0}, {g_stop_pipe[0], POLLIN, 0}};
+    const int polled = poll(fds, 2, kPollSliceMs);
+    if (polled > 0) {
+      if (fds[1].revents & POLLIN) break;
+      if (fds[0].revents & (POLLIN | POLLHUP | POLLERR)) {
+        char peek = 0;
+        const ssize_t got = recv(fd, &peek, 1, MSG_PEEK | MSG_DONTWAIT);
+        if (got == 0 || (got < 0 && errno != EAGAIN && errno != EWOULDBLOCK && errno != EINTR)) {
+          coord->OnPeerClosed();
+          {
+            std::lock_guard<std::mutex> lock(conn->mu);
+            conn->closed = true;
+          }
+          break;
+        }
+        if (got > 0) {
+          // A second frame on the same connection is a duplicate; queue it so
+          // the coordinator records the repeat rejection without cleanup.
+          const FrameReadResult repeat = ReadNormalFrame(fd, kFrameTimeoutMs);
+          (void)coord->RequestNormal(cred, repeat.status, repeat.line, coord->generation());
+          (void)WriteAll(fd, kRejectedLine, kReplyTimeoutMs);
+        }
+      }
+    }
+    if (g_stopping.load()) break;
+  }
+
+  {
+    std::lock_guard<std::mutex> lock(g_active_mu);
+    if (g_active == conn) g_active.reset();
+  }
+  close(fd);
+}
+
+void WorkerMain() {
+  while (!g_stopping.load()) {
+    struct pollfd fds[2] = {{g_listen_fd, POLLIN, 0}, {g_stop_pipe[0], POLLIN, 0}};
+    const int polled = poll(fds, 2, -1);
+    if (polled < 0) {
+      if (errno == EINTR) continue;
+      break;
+    }
+    if (fds[1].revents & POLLIN) break;
+    if (!(fds[0].revents & POLLIN)) continue;
+
+    const int fd = accept(g_listen_fd, nullptr, nullptr);
+    if (fd < 0) {
+      if (errno == EINTR) continue;
+      continue;
+    }
+    (void)fcntl(fd, F_SETFD, FD_CLOEXEC);
+    ServeConnection(fd);
+  }
+}
+
+bool OpenStopPipe() {
+  if (pipe(g_stop_pipe) != 0) return false;
+  (void)fcntl(g_stop_pipe[0], F_SETFD, FD_CLOEXEC);
+  (void)fcntl(g_stop_pipe[1], F_SETFD, FD_CLOEXEC);
+  return true;
+}
+
+}  // namespace
+
+bool SecurityReadyForOperation() {
+  if (!kCompiledIn) return true;
+  if (g_security_hold.load()) return false;
+  if (!enforcement::KernelIsEnforcing()) {
+    g_security_hold.store(true);
+    LOG(ERROR) << "rothko-normal-exit: security hold; actual Enforcing required";
+    return false;
+  }
+  return !g_security_hold.load();
+}
+
+bool FeatureEnabled() {
+  if (!kCompiledIn || !SecurityReadyForOperation()) return false;
+  // Ordinary authenticated USER adbd only. Unknown values and trade-in/FOYER
+  // admission fail closed; UID/SID alone is not transport authentication.
+  if (android::base::GetProperty("ro.secure", "") != "1" ||
+      android::base::GetProperty("ro.adb.secure", "") != "1" ||
+      android::base::GetProperty("ro.debuggable", "") != "0") return false;
+  const std::string tradein = android::base::GetProperty("persist.adb.tradeinmode", "");
+  if (!tradein.empty() && tradein != "0") return false;
+  return android::base::GetBoolProperty(kFeatureProperty, false);
+}
+
+void CaptureBeforeGetArgs(int argc, char** argv, std::string* stage) {
+  if (!FeatureEnabled()) return;
+
+  std::vector<std::string> options;
+  for (int i = 1; i < argc; ++i) options.emplace_back(argv[i]);
+
+  Capture capture = BuildFreshCapture(options);
+  if (stage != nullptr) *stage = capture.stage.value_or("");
+
+  const bool raw_clean = CaptureIsClean(capture);
+  if (raw_clean) ApplyGetArgsRewrite(&capture, options);
+
+  InitialCapture& initial = Initial();
+  std::lock_guard<std::mutex> lock(initial.mu);
+  initial.valid = true;
+  initial.raw_clean = raw_clean;
+  initial.argv = std::move(options);
+  initial.capture = std::move(capture);
+}
+
+void Start(RecoveryUI* ui) {
+  if (!FeatureEnabled()) return;
+
+  InitialCapture& initial = Initial();
+  Capture capture;
+  std::vector<std::string> argv;
+  bool raw_clean = false;
+  {
+    std::lock_guard<std::mutex> lock(initial.mu);
+    if (!initial.valid) {
+      LOG(ERROR) << "rothko-normal-exit: capture missing; feature inert";
+      return;
+    }
+    capture = initial.capture;
+    argv = initial.argv;
+    raw_clean = initial.raw_clean;
+  }
+
+  const int fd = android_get_control_socket(kSocketName);
+  if (fd < 0) {
+    LOG(ERROR) << "rothko-normal-exit: socket unavailable; feature inert";
+    return;
+  }
+  (void)fcntl(fd, F_SETFD, FD_CLOEXEC);
+  if (listen(fd, 1) != 0) {
+    PLOG(ERROR) << "rothko-normal-exit: listen failed; feature inert";
+    close(fd);
+    return;
+  }
+  if (!OpenStopPipe()) {
+    close(fd);
+    return;
+  }
+
+  {
+    std::lock_guard<std::mutex> lock(g_state_mu);
+    g_ui = ui;
+    g_argv = std::move(argv);
+    g_coord = std::make_unique<Coordinator>(std::move(capture), MakeHooks());
+    g_listen_fd = fd;
+    g_listening = true;
+  }
+  g_verified_clear.store(false);
+  g_stopping.store(false);
+  g_worker = std::thread(WorkerMain);
+  LOG(INFO) << "rothko-normal-exit: adapter started, capture "
+            << (raw_clean ? "clean" : "blocked") << ", state " << ToString(Coord()->state());
+}
+
+void EnsureTopMenuWindow(bool is_main_menu) {
+  Coordinator* coord = Coord();
+  if (coord == nullptr) return;
+  if (!is_main_menu) {
+    (void)coord->LeaveTopMenu();
+    return;
+  }
+  if (!coord->top_menu_open()) (void)coord->EnterTopMenu();
+}
+
+void LeaveTopMenuWindow() {
+  Coordinator* coord = Coord();
+  if (coord != nullptr) (void)coord->LeaveTopMenu();
+}
+
+bool PromptClearDeferred() {
+  if (!SecurityReadyForOperation()) return true;
+  std::lock_guard<std::mutex> lock(g_state_mu);
+  return g_listening;
+}
+
+bool ConsumeVerifiedClear() {
+  return g_verified_clear.exchange(false);
+}
+
+bool DefaultRebootSuppressed() {
+  if (!SecurityReadyForOperation()) return true;
+  Coordinator* coord = Coord();
+  if (coord == nullptr) return false;
+  switch (coord->state()) {
+    case State::kBlocked:
+    case State::kErrorHold:
+    case State::kNormalPending:
+    case State::kCommitting:
+      return true;
+    case State::kIdleClean:
+    case State::kCommitted:
+      return false;
+  }
+  return true;
+}
+
+PromptInterrupt OnPromptInterrupt() {
+  if (!SecurityReadyForOperation()) {
+    if (Coordinator* coord = Coord(); coord != nullptr) coord->OnPeerClosed();
+    ReleaseActive();
+    return PromptInterrupt::kErrorHold;
+  }
+  Coordinator* coord = Coord();
+  if (coord == nullptr) return PromptInterrupt::kNotOurs;
+  if (coord->pending_token() == 0) return PromptInterrupt::kNotOurs;
+  if (coord->state() != State::kNormalPending) return PromptInterrupt::kNotOurs;
+
+  const CommitOutcome outcome = coord->ConfirmCommit(coord->generation(), coord->pending_token());
+  postcommit::Phase("confirm_commit.after");
+  postcommit::Phase("release_active.before");
+  ReleaseActive();
+  postcommit::Phase("release_active.after");
+  switch (outcome.result) {
+    case Result::kCommittedNotBootValidated:
+      postcommit::Phase("interrupt_return_reboot");
+      return PromptInterrupt::kReboot;
+    case Result::kErrorHold:
+    case Result::kBlockedCapture:
+      postcommit::Phase("interrupt_return_error_hold");
+      return PromptInterrupt::kErrorHold;
+    case Result::kCommitCancelledWindow:
+    case Result::kRejectedStaleWindow:
+    case Result::kRejectedStaleToken:
+    case Result::kRejectedBusy:
+      return PromptInterrupt::kKeepMenu;
+    default:
+      return PromptInterrupt::kKeepMenu;
+  }
+}
+
+void Stop() {
+  {
+    std::lock_guard<std::mutex> lock(g_state_mu);
+    g_listening = false;
+  }
+  g_stopping.store(true);
+  if (g_stop_pipe[1] >= 0) {
+    const char wake = 1;
+    (void)write(g_stop_pipe[1], &wake, 1);
+  }
+  if (g_worker.joinable()) g_worker.join();
+  ReleaseActive();
+
+  int fd = -1;
+  int stop_read = -1;
+  int stop_write = -1;
+  {
+    std::lock_guard<std::mutex> lock(g_state_mu);
+    fd = g_listen_fd;
+    g_listen_fd = -1;
+    g_ui = nullptr;
+    g_coord.reset();
+  }
+  stop_read = g_stop_pipe[0];
+  stop_write = g_stop_pipe[1];
+  g_stop_pipe[0] = -1;
+  g_stop_pipe[1] = -1;
+  if (fd >= 0) close(fd);
+  if (stop_read >= 0) close(stop_read);
+  if (stop_write >= 0) close(stop_write);
+}
+
+}  // namespace rothko::recovery::bridge
