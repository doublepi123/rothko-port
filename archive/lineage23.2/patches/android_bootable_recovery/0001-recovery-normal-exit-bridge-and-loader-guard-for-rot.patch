+namespace rothko::recovery::launcher {
+
+namespace {
+
+bool IsApprovedSelfPath(const char* path) {
+  return strcmp(path, kSelfPathPrivate) == 0;
+}
+
+// A loader variable is any name starting with "LD_".  This covers the complete
+// Bionic loader namespace (LD_LIBRARY_PATH, LD_PRELOAD, LD_AUDIT, LD_DEBUG,
+// LD_CONFIG_FILE, LD_SHOW_AUXV, ...).  ANDROID_LD_* is not a Bionic loader
+// input and is not matched.
+bool IsLoaderVariable(const char* entry) {
+  return strncmp(entry, "LD_", 3) == 0;
+}
+
+constexpr size_t kExpectedContextLength = sizeof(kExpectedSelinuxContext) - 1;
+
+}  // namespace
+
+ExitCode ValidateInvocation(const HostFacts& facts, int argc, char** argv) {
+  // An absent auxv entry is getauxval()==0 with errno=ENOENT; it is not a
+  // valid zero.  A valid 0 or 1 is accepted for the static first stage; every
+  // other value is refused.  Both accepted values still go through the
+  // complete admission below.
+  if (!facts.auxv.valid) return kExitAtSecure;
+  if (facts.auxv.value != 0 && facts.auxv.value != 1) return kExitAtSecure;
+
+  // Root real and effective identity, and no real/effective gid split.
+  if (facts.uid != 0 || facts.euid != 0) return kExitIdentity;
+  if (facts.gid != facts.egid) return kExitIdentity;
+
+  // Exact domain is mandatory for both AT_SECURE values.  A missing, garbled
+  // or different context fails closed; the production reader never accepts a
+  // value from argv, environment, a property or a caller-supplied file.
+  if (facts.own_context.status != OwnContextStatus::kExact) return kExitContext;
+  if (strncmp(facts.own_context.value, kExpectedSelinuxContext, kExpectedContextLength) != 0 ||
+      facts.own_context.value[kExpectedContextLength] != '\0') {
+    return kExitContext;
+  }
+
+  // The launcher must be the approved file at the one fixed private path,
+  // root-owned, regular, not group/world writable and not set-id.  The build
+  // intermediate path is deliberately not accepted at runtime.
+  if (facts.self_exe == nullptr || !IsApprovedSelfPath(facts.self_exe)) return kExitIdentity;
+  if (!facts.self_stat_ok || !S_ISREG(facts.self_mode)) return kExitIdentity;
+  if (facts.self_uid != 0) return kExitIdentity;
+  if ((facts.self_mode & (S_IWGRP | S_IWOTH)) != 0) return kExitIdentity;
+  if ((facts.self_mode & (S_ISUID | S_ISGID)) != 0) return kExitIdentity;
+
+  if (argv == nullptr || argc < 1 || argc > kMaxProgramArgc) return kExitArguments;
+  for (int i = 0; i < argc; ++i) {
+    if (argv[i] == nullptr) return kExitArguments;
+  }
+  // No interpretation of argv[1:]: they are passed to Recovery unchanged and
+  // Recovery's own argument handling stays authoritative.
+  return kExitOk;
+}
+
+bool BuildChildEnvironment(const char* const* envp, EnvBuffer* out) {
+  if (out == nullptr) return false;
+  out->count = 0;
+  out->used = 0;
+  out->ptrs[0] = nullptr;
+
+  for (size_t i = 0; envp != nullptr && envp[i] != nullptr; ++i) {
+    const char* entry = envp[i];
+    if (IsLoaderVariable(entry)) continue;
+    if (strchr(entry, '=') == nullptr) continue;
+
+    const size_t len = strlen(entry);
+    if (out->count + 2 >= EnvBuffer::kMaxVars) return false;
+    if (out->used + len + 1 > EnvBuffer::kMaxBytes) return false;
+
+    memcpy(out->storage + out->used, entry, len + 1);
+    out->ptrs[out->count++] = out->storage + out->used;
+    out->used += len + 1;
+  }
+
+  static constexpr char kFixed[] = "LD_LIBRARY_PATH=/system/recovery-runtime/lib64";
+  constexpr size_t kFixedLen = sizeof(kFixed);  // includes NUL
+  if (out->used + kFixedLen > EnvBuffer::kMaxBytes) return false;
+
+  memcpy(out->storage + out->used, kFixed, kFixedLen);
+  out->ptrs[out->count++] = out->storage + out->used;
+  out->used += kFixedLen;
+  out->ptrs[out->count] = nullptr;
+  return true;
+}
+
+ExitCode Run(const HostFacts& facts, int argc, char** argv, ExecFn exec, EnvBuffer* env_out) {
+  if (exec == nullptr) return kExitUnexpected;
+
+  const ExitCode validation = ValidateInvocation(facts, argc, argv);
+  if (validation != kExitOk) return validation;
+#if !defined(ROTHKO_RECOVERY_LAUNCHER_CORE_ONLY)
+  // Only the device-specific static first hop may strengthen inherited OEM permissive.
+  // Root/exactdomain/trusted-file checks above must run BEFORE this fixed1-only request.
+  const auto enforcing = rothko::recovery::enforcement::TightenKernel();
+  if (!rothko::recovery::enforcement::Accepted(enforcing)) {
+    fprintf(stderr, "recovery-launcher: cannot establish Enforcing; outcome=%d\n",
+            static_cast<int>(enforcing));
+    return static_cast<ExitCode>(106);
+  }
+  fprintf(stderr, "recovery-launcher: Enforcing verified; outcome=%d\n",
+          static_cast<int>(enforcing));
+#endif
+
+  EnvBuffer local;
+  EnvBuffer* env = env_out != nullptr ? env_out : &local;
+  if (!BuildChildEnvironment(facts.envp, env)) return kExitEnvironment;
+
+  // argv for the child: private linker, then the exact Recovery program, then
+  // the original recovery arguments.  Bionic drops the linker-path argv[0]
+  // when the linker is invoked directly, so Recovery sees
+  // argv[0] = /system/bin/recovery and argv[1:] = original argv[1:].
+  char* child_argv[kMaxProgramArgc + 3] = {};
+  child_argv[0] = const_cast<char*>(kPrivateLinker);
+  child_argv[1] = const_cast<char*>(kRecoveryProgram);
+  for (int i = 1; i < argc; ++i) {
+    child_argv[i + 1] = argv[i];
+  }
+  child_argv[argc + 1] = nullptr;
+
+  const int result = exec(kPrivateLinker, child_argv, env->ptrs);
+  const int saved_errno = errno;
+  fprintf(stderr, "recovery-launcher: execve(%s) returned %d: %s\n", kPrivateLinker, result,
+          strerror(saved_errno));
+  return kExitExecFailed;
+}
+
+}  // namespace rothko::recovery::launcher
+
+#if !defined(ROTHKO_RECOVERY_LAUNCHER_CORE_ONLY)
+
+namespace {
+
+const char* RefusalReason(int code) {
+  switch (code) {
+    case rothko::recovery::launcher::kExitAtSecure:
+      return "AT_SECURE auxv is unavailable or not a valid 0/1";
+    case rothko::recovery::launcher::kExitIdentity:
+      return "unexpected uid/gid, launcher path or launcher file permissions";
+    case rothko::recovery::launcher::kExitContext:
+      return "SELinux context is not exactly u:r:recovery:s0";
+    case rothko::recovery::launcher::kExitArguments:
+      return "unexpected argument count or null argument";
+    case rothko::recovery::launcher::kExitEnvironment:
+      return "could not construct the sanitized environment";
+    case rothko::recovery::launcher::kExitExecFailed:
+      return "execve of the private linker failed";
+    default:
+      return "unexpected launcher state";
+  }
