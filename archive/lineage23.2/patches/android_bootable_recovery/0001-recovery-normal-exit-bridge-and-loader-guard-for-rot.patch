+// SPDX-FileCopyrightText: The LineageOS Project
+// SPDX-License-Identifier: Apache-2.0
+
+#include "get_args_canonical.h"
+
+#include <utility>
+
+namespace rothko::recovery {
+
+bool CanonicalizeBootRecovery(const std::vector<std::string>& argv_options,
+                              const std::string& recovery_field,
+                              std::string* canonical) {
+  if (canonical == nullptr) return false;
+
+  std::vector<std::string> options;
+  if (!argv_options.empty()) {
+    // get_args() only reads the BCB when no command-line option was supplied.
+    options = argv_options;
+  } else if (!recovery_field.empty()) {
+    if (recovery_field.back() != '\n') return false;
+    std::size_t start = 0;
+    bool first = true;
+    for (;;) {
+      const std::size_t pos = recovery_field.find('\n', start);
+      const std::string token = pos == std::string::npos
+                                    ? recovery_field.substr(start)
+                                    : recovery_field.substr(start, pos - start);
+      if (first) {
+        if (token != "recovery") return false;
+      } else if (!token.empty() && token[0] != '\0') {
+        options.push_back(token);
+      }
+      first = false;
+      if (pos == std::string::npos) break;
+      start = pos + 1;
+    }
+  }
+
+  std::string out = "recovery\n";
+  for (const auto& option : options) {
+    out += option;
+    if (option.empty() || option.back() != '\n') out += '\n';
+  }
+  *canonical = std::move(out);
+  return true;
+}
+
+}  // namespace rothko::recovery
