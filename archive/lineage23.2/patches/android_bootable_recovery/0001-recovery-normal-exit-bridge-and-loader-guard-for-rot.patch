@@ -15,6 +15,7 @@
  */
 
 #include "otautil/sysutil.h"
+#include "otautil/normal_exit_phase.h"
 
 #include <errno.h>  // TEMP_FAILURE_RETRY
 #include <fcntl.h>
@@ -220,16 +221,25 @@ MemMapping::~MemMapping() {
 }
 
 void Reboot(std::string_view target) {
+  rothko::recovery::postcommit::Phase("standard_reboot.enter");
   std::string cmd = "reboot," + std::string(target);
   // Honor the quiescent mode if applicable.
+  rothko::recovery::postcommit::Phase("quiescent_property.before");
   if (target != "bootloader" && target != "fastboot" &&
       android::base::GetBoolProperty("ro.boot.quiescent", false)) {
     cmd += ",quiescent";
   }
+  rothko::recovery::postcommit::Phase("quiescent_property.after");
+  rothko::recovery::postcommit::Phase("powerctl_set.before");
   if (!android::base::SetProperty(ANDROID_RB_PROPERTY, cmd)) {
+    rothko::recovery::postcommit::Phase("powerctl_set.failed");
     LOG(FATAL) << "Reboot failed";
   }
+  rothko::recovery::postcommit::Phase("powerctl_set.after");
 
+  // Reboot is noreturn. A successful SetProperty only hands off to init; it
+  // proves neither shutdown completion nor the next boot. No synthetic after.
+  rothko::recovery::postcommit::Phase("standard_reboot.wait_for_init");
   while (true) pause();
 }
 
