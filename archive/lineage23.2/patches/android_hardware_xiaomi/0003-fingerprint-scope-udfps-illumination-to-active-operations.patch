From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Rothko Device Maintainers <noreply@rothko.invalid>
Date: Mon, 16 Nov 2026 02:01:04 +0000
Subject: [PATCH 3/3] fingerprint: scope UDFPS illumination to active operations

Notify handlers when authentication or enrollment actually starts. Retire the
illumination operation on errors, cancellation, close, lockout, or completed
enrollment. Do not start the legacy HAL when the sensor is locked out.

The rothko handler observes raw touch/display events independently of framework
pointer events. It needs this operation boundary to ignore ordinary touches
once authentication has ended. Other rebuilt handlers keep the default no-op
start hook. Rebuild the service and handler together for the extended internal
interface.

diff --git a/aidl/fingerprint/Session.cpp b/aidl/fingerprint/Session.cpp
--- a/aidl/fingerprint/Session.cpp
+++ b/aidl/fingerprint/Session.cpp
@@ -69,6 +69,7 @@
                                    std::shared_ptr<ICancellationSignal>* out) {
     hw_auth_token_t authToken;
     translate(hat, authToken);
+    if (mUdfpsHandler) mUdfpsHandler->onOperationStarted();
 #ifndef IMPL_V2
     int error = mDevice->enroll(mDevice, &authToken, mUserId, 60);
 #else
@@ -76,6 +77,7 @@
 #endif
     if (error) {
         ALOGE("enroll failed: %d", error);
+        if (mUdfpsHandler) mUdfpsHandler->cancel();
         mCb->onError(Error::UNABLE_TO_PROCESS, error);
     }
 
@@ -85,7 +87,9 @@
 
 ndk::ScopedAStatus Session::authenticate(int64_t operationId,
                                          std::shared_ptr<ICancellationSignal>* out) {
-    checkSensorLockout();
+    *out = SharedRefBase::make<CancellationSignal>(this);
+    if (checkSensorLockout()) return ndk::ScopedAStatus::ok();
+    if (mUdfpsHandler) mUdfpsHandler->onOperationStarted();
 #ifndef IMPL_V2
     int error = mDevice->authenticate(mDevice, operationId, mUserId);
 #else
@@ -93,10 +97,10 @@
 #endif
     if (error) {
         ALOGE("authenticate failed: %d", error);
+        if (mUdfpsHandler) mUdfpsHandler->cancel();
         mCb->onError(Error::UNABLE_TO_PROCESS, error);
     }
 
-    *out = SharedRefBase::make<CancellationSignal>(this);
     return ndk::ScopedAStatus::ok();
 }
 
@@ -226,8 +230,8 @@
     return ndk::ScopedAStatus::ok();
 }
 
-ndk::ScopedAStatus Session::onPointerCancelWithContext(const PointerContext& /*context*/) {
-    return ndk::ScopedAStatus::ok();
+ndk::ScopedAStatus Session::onPointerCancelWithContext(const PointerContext& context) {
+    return onPointerUp(context.pointerId);
 }
 
 ndk::ScopedAStatus Session::setIgnoreDisplayTouches(bool /*shouldIgnore*/) {
@@ -250,6 +254,7 @@
 }
 
 ndk::ScopedAStatus Session::close() {
+    if (mUdfpsHandler) mUdfpsHandler->cancel();
     mClosed = true;
     mCb->onSessionClosed();
     AIBinder_DeathRecipient_delete(mDeathRecipient);
@@ -329,12 +334,14 @@
 bool Session::checkSensorLockout() {
     LockoutTracker::LockoutMode lockoutMode = mLockoutTracker.getMode();
     if (lockoutMode == LockoutTracker::LockoutMode::kPermanent) {
+        if (mUdfpsHandler) mUdfpsHandler->cancel();
         ALOGE("Fail: lockout permanent");
         mCb->onLockoutPermanent();
         mIsLockoutTimerAborted = true;
         return true;
     }
     if (lockoutMode == LockoutTracker::LockoutMode::kTimed) {
+        if (mUdfpsHandler) mUdfpsHandler->cancel();
         int64_t timeLeft = mLockoutTracker.getLockoutTimeLeft();
         ALOGE("Fail: lockout timed: %ld", timeLeft);
         mCb->onLockoutTimed(timeLeft);
@@ -370,6 +377,7 @@
     // const uint64_t devId = reinterpret_cast<uint64_t>(mDevice);
     switch (msg->type) {
         case FINGERPRINT_ERROR: {
+            if (mUdfpsHandler) mUdfpsHandler->cancel();
             int32_t vendorCode = 0;
             Error result = VendorErrorFilter(msg->data.error, &vendorCode);
             ALOGD("onError(%hhd, %d)", result, vendorCode);
@@ -398,6 +406,9 @@
             ALOGD("onEnrollResult(fid=%d, rem=%d)", msg->data.enroll.finger.fid,
                   msg->data.enroll.samples_remaining);
 #endif
+            if (msg->data.enroll.samples_remaining == 0 && mUdfpsHandler) {
+                mUdfpsHandler->cancel();
+            }
             mCb->onEnrollmentProgress(msg->data.enroll.finger.fid,
                                       msg->data.enroll.samples_remaining);
 
diff --git a/fingerprint/include/UdfpsHandler.h b/fingerprint/include/UdfpsHandler.h
--- a/fingerprint/include/UdfpsHandler.h
+++ b/fingerprint/include/UdfpsHandler.h
@@ -25,6 +25,9 @@
     virtual void onAuthenticationSucceeded() {};
     virtual void onAuthenticationFailed() {};
     virtual void cancel() {};
+
+    // The service and handlers must be rebuilt together when this interface changes.
+    virtual void onOperationStarted() {};
 };
 
 struct UdfpsHandlerFactory {
