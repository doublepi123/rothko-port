+func androidMkFilesEqual(previous, draft string, size int64) (bool, error) {
+	left, err := os.Open(previous)
+	if err != nil {
+		return false, err
+	}
+	defer left.Close()
+	right, err := os.Open(draft)
+	if err != nil {
+		return false, err
+	}
+	defer right.Close()
+	leftChunk := make([]byte, 1024*1024)
+	rightChunk := make([]byte, len(leftChunk))
+	for size > 0 {
+		length := min(size, int64(len(leftChunk)))
+		if _, err := io.ReadFull(left, leftChunk[:length]); err != nil {
+			return false, err
+		}
+		if _, err := io.ReadFull(right, rightChunk[:length]); err != nil {
+			return false, err
+		}
+		if !bytes.Equal(leftChunk[:length], rightChunk[:length]) {
+			return false, nil
+		}
+		size -= length
+	}
+	return true, nil
 }
 
