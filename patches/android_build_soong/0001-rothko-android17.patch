+func writeRecordJSON(out io.Writer, records []SoongApiModuleRecord) error {
+	if len(records) == 0 {
+		empty := "[]"
+		if records == nil {
+			empty = "null"
+		}
+		_, err := io.WriteString(out, empty)
+		return err
+	}
+	prefix := "[\n  "
+	for i := range records {
+		record, err := json.MarshalIndent(&records[i], "  ", "  ")
+		if err != nil {
+			return fmt.Errorf("marshal Soong API record %q: %w", records[i].Name, err)
+		}
+		if _, err := io.WriteString(out, prefix); err != nil {
+			return err
+		}
+		if _, err := out.Write(record); err != nil {
