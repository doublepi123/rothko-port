From: lcy <admin@luchenyang.xyz>
Subject: [PATCH] blueprint: Bound memory while generating the Ninja graph

Keep this patch on the Android 17 baseline recorded in patches/BASES.tsv.

---

diff --git a/bootstrap/command.go b/bootstrap/command.go
index e5f68629..06a6270d 100644
--- a/bootstrap/command.go
+++ b/bootstrap/command.go
@@ -172,10 +172,18 @@ func RunBlueprint(args Args, stopBefore StopBefore, ctx *blueprint.Context, conf
 		return ninjaDeps, nil
 	}
 
-	providersValidationChan := make(chan []error, 1)
-	go func() {
-		providersValidationChan <- ctx.VerifyProvidersWereUnchanged()
-	}()
+	var providersValidationChan chan []error
+	if ctx.SerialSingletons() {
+		if errs := ctx.VerifyProvidersWereUnchanged(); len(errs) != 0 {
+			return nil, proptools.MergeErrors(errs)
+		}
+		runtime.GC()
+	} else {
+		providersValidationChan = make(chan []error, 1)
+		go func() {
+			providersValidationChan <- ctx.VerifyProvidersWereUnchanged()
+		}()
+	}
 
 	ctx.RecordSandboxMetrics(config)
 
@@ -219,9 +227,10 @@ func RunBlueprint(args Args, stopBefore StopBefore, ctx *blueprint.Context, conf
 		}
 	}
 
-	providerValidationErrors := <-providersValidationChan
-	if providerValidationErrors != nil {
-		return nil, proptools.MergeErrors(providerValidationErrors)
+	if providersValidationChan != nil {
+		if errs := <-providersValidationChan; len(errs) != 0 {
+			return nil, proptools.MergeErrors(errs)
+		}
 	}
 
 	if args.Memprofile != "" {
