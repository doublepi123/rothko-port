+    private final java.util.concurrent.atomic.AtomicReference<PreparedFrameOwner> mPreparedFrameOwner=new java.util.concurrent.atomic.AtomicReference<>();
+    private boolean preparedFrameStillValid(PreparedFrameOwner frame,BaseClientMonitor client,long request,int sensor){
+        if(frame==null)return mPreparedFrameOwner.get()==null;
+        if(frame.client!=client||frame.request!=request||frame.sensor!=sensor)return false;
+        // Keep an expired/revoked tombstone until the REAL frame revoke. Never
+        // silently reclassify an old renderer callback as ordinary raw READY.
+        if(frame.revoked.get()||frame.security!=mProductionSecurityEpoch.get()||SystemClock.elapsedRealtime()>=frame.expires)return false;
+        boolean bound=frame.guard.getAsBoolean();
