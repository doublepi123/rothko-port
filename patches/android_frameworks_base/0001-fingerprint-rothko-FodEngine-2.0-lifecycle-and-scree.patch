+/* SPDX-License-Identifier: Apache-2.0 */
+package com.android.systemui.biometrics;
+
+import android.content.Context;
+
+/** Internal UI-event values carried by existing permission-checked FingerprintManager call. */
+public final class RothkoFodUiEvents {
+    /** Per-press illumination frame committed (existing I fact). */
+    public static final int FRAME_COMMITTED = 0x52460001;
+    /** Per-press illumination frame revoked (existing I fact). */
+    public static final int FRAME_REVOKED = 0x52460002;
+    /** Attached/shown/window-visible optical overlay frame committed (the O fact). */
+    public static final int OVERLAY_FRAME_COMMITTED = 0x52460003;
+    /** Optical overlay frame presence revoked: hide, detach, window visibility loss or dispose. */
+    public static final int OVERLAY_FRAME_REVOKED = 0x52460004;
+    private RothkoFodUiEvents() {}
+
+    public static boolean enabled(Context context) {
+        int id = context.getResources().getIdentifier(
+                "config_rothkoFodStateBridgeEnabled", "bool", "android");
+        return id != 0 && context.getResources().getBoolean(id);
+    }
+}
