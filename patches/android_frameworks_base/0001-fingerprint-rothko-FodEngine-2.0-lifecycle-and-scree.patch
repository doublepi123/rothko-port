+    private RothkoFodBridge(Context context, Handler fingerprintHandler) {
+        mFingerprintHandler = fingerprintHandler;
+        HandlerThread thread = new HandlerThread(TAG);
+        thread.start();
+        mWorker = new Handler(thread.getLooper());
+        mTransport = new XiaomiFodTransport(this::vendorDied);
+        mMachine = new FodStateMachine(mTransport,SystemClock::elapsedRealtime);
+        FodColorFadeTracker.listen(mWorker, this::handleFadeObserved);
+        final DisplayManager displays = context.getSystemService(DisplayManager.class);
+        initializeObservePolicy(context,displays);
+        if (displays == null) {
+            Slog.e(TAG, "No DisplayManager; power unknown, never activate");
+            return;
+        }
+        // Committed-state changes are PRIVATE events; the two-argument overload is insufficient.
+        displays.registerDisplayListener(new DisplayManager.DisplayListener() {
+            @Override public void onDisplayAdded(int id) { update(id); }
+            @Override public void onDisplayChanged(int id) { update(id); }
+            @Override public void onDisplayRemoved(int id) {
+                if (id == Display.DEFAULT_DISPLAY) handleDisplayPower(-1);
+            }
+            private void update(int id) {
+                if (id != Display.DEFAULT_DISPLAY) return;
+                Display display = displays.getDisplay(id);
+                handleDisplayPower(display == null ? -1 : mapPower(display.getCommittedState()));
+            }
+        }, mWorker, DisplayManager.EVENT_TYPE_DISPLAY_ADDED
+                | DisplayManager.EVENT_TYPE_DISPLAY_CHANGED
+                | DisplayManager.EVENT_TYPE_DISPLAY_REMOVED
+                | DisplayManager.EVENT_TYPE_DISPLAY_STATE,
+                DisplayManager.PRIVATE_EVENT_TYPE_DISPLAY_COMMITTED_STATE_CHANGED);
+        mWorker.post(() -> {
+            Display display = displays.getDisplay(Display.DEFAULT_DISPLAY);
+            handleDisplayPower(display == null ? -1 : mapPower(display.getCommittedState()));
+        });
+    }
+
+    /** Mirrors actual DisplayAdapter/SurfaceControl HWC mapping; UNKNOWN is never defaulted ON. */
+    public static int mapPower(int state) {
+        switch (state) {
+            case Display.STATE_OFF: return SurfaceControl.POWER_MODE_OFF;
+            case Display.STATE_DOZE: return SurfaceControl.POWER_MODE_DOZE;
+            case Display.STATE_DOZE_SUSPEND: return SurfaceControl.POWER_MODE_DOZE_SUSPEND;
+            case Display.STATE_ON_SUSPEND: return SurfaceControl.POWER_MODE_ON_SUSPEND;
+            case Display.STATE_ON:
+            case Display.STATE_VR: return SurfaceControl.POWER_MODE_NORMAL;
+            default: return FodStateMachine.UNKNOWN_POWER;
+        }
+    }
