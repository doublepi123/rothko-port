+        return captured!=null && current(mSource,captured,captured.getRequestId(),mEpoch.get(),
+                mBridge.productionWakeFence(),SystemClock.elapsedRealtime(),session);
+    }
+    private boolean eligibleForContinuation(){
+        try{
+            BaseClientMonitor captured=mCurrentClient.get();AidlSession session=mSession.get();
+            return captured!=null&&!captured.isAlreadyDone()&&session!=null&&session.ownsResponseHandler(mSource)
+                &&session.getUserId()==captured.getTargetUserId()&&session.getSession().asBinder().isBinderAlive()
+                &&mRealHal.getAsBoolean()&&mLockoutClear.test(captured.getTargetUserId())&&mEnrolled.test(captured.getTargetUserId())
+                &&mBridge.productionWakeContinuationReady(mBridge.productionWakeSecurityFence(),
+                    new RothkoFodBridge.ObserveCandidate(captured,mProps,true,true));
+        }catch(RuntimeException unavailable){return false;}
+    }
+    private boolean current(AidlResponseHandler source, BaseClientMonitor captured,
+            long request,long epoch,long bridgeFence,long received,AidlSession session) {
+        try {
+            final boolean realHal=mRealHal.getAsBoolean();
+            final boolean lockoutClear=mLockoutClear.test(captured.getTargetUserId());
+            if (mPower == null || epoch != mEpoch.get()
+                    || SystemClock.elapsedRealtime()-received > MAX_CALLBACK_QUEUE_AGE_MS
+                    || mCurrentClient.get() != captured || captured.getRequestId() != request
+                    || captured.isAlreadyDone() || session == null || mSession.get() != session
+                    || !session.ownsResponseHandler(source)
+                    || session.getUserId() != captured.getTargetUserId()
+                    || !session.getSession().asBinder().isBinderAlive() || !realHal
+                    || !lockoutClear
+                    || !mEnrolled.test(captured.getTargetUserId())) return false;
+            return mBridge.productionWakePolicyReady(bridgeFence,
+                    new RothkoFodBridge.ObserveCandidate(captured,mProps,realHal,lockoutClear))
+                    && epoch == mEpoch.get();
+        } catch (RuntimeException unavailable) { return false; }
+    }
+}
