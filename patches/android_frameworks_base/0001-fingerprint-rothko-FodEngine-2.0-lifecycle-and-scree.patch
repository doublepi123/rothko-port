+/* SPDX-License-Identifier: Apache-2.0 */
+package com.android.server.biometrics.sensors.fingerprint.fod;
+
+import java.util.IdentityHashMap;
+import java.util.Map;
+
+/** Real owner registry; absence is known only after an owner observation, never by default. */
