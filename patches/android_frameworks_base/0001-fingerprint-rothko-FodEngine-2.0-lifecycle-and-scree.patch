diff --git a/packages/SystemUI/src/com/android/systemui/biometrics/RothkoFodOverlayFrameGate.java b/packages/SystemUI/src/com/android/systemui/biometrics/RothkoFodOverlayFrameGate.java
new file mode 100644
index 000000000..ecf7a4291
--- /dev/null
+++ b/packages/SystemUI/src/com/android/systemui/biometrics/RothkoFodOverlayFrameGate.java
@@ -0,0 +1,266 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+package com.android.systemui.biometrics;
+
+import java.util.concurrent.Executor;
+import java.util.function.BooleanSupplier;
+import java.util.function.Consumer;
+
+/**
+ * Pure, main-thread-confined lifecycle gate for the optical UDFPS overlay frame-presence fact
+ * (the "O" fact: the overlay window is attached, shown, window-visible and one of its real
+ * hardware-rendered frames actually produced a new buffer).
+ *
+ * <p>The commit result is the RenderThread {@code didProduceBuffer} boolean. A ViewTreeObserver
+ * frame-commit callback alone is NOT accepted: it ignores that flag and is not evidence that a new
+ * buffer or SurfaceFlinger transaction exists. A false result must never emit the O fact.
+ *
+ * <p>Rules enforced here:
+ * <ul>
+ *   <li>Only a real {@code didProduceBuffer=true} result for the current generation while the view
+ *       and the captured root/window/surface identities are still current may emit {@code true}.</li>
+ *   <li>{@code true} is emitted at most once per armed generation; repeated or late results are
+ *       ignored.</li>
+ *   <li>Ending an armed generation emits exactly one {@code false}, including when no frame was
+ *       ever committed (full hide with no per-press illumination).</li>
+ *   <li>Disposing/invalidating emits nothing; a stale RenderThread result that already escaped is
+ *       rejected by the generation token.</li>
+ *   <li>Failed sync flags, no buffer, replaced root/window/surface, software rendering or a
+ *       non-observable view fail closed: no {@code true} is synthesized and nothing retries by
+ *       timer.</li>
+ * </ul>
+ *
+ * <p>A committed frame means the hardware renderer produced a new buffer; it is NOT proof of
+ * SurfaceFlinger presentation, panel output, painted pixels, HBM or biometric data.
+ */
+public final class RothkoFodOverlayFrameGate {
+    /** Mirrors {@code HardwareRenderer.SYNC_OK}; verified against real headers by the host lane. */
+    public static final int SYNC_OK = 0;
+    /** Mirrors {@code HardwareRenderer.SYNC_REDRAW_REQUESTED} (1 << 0). */
+    public static final int SYNC_REDRAW_REQUESTED = 1;
+
+    /** How a real frame observer was installed. */
+    public enum Registration {
+        /** Registered now; the caller must issue exactly one traversal request. */
+        REGISTERED,
+        /** Deferred to the first real pre-draw because no valid hardware surface exists yet. */
+        DEFERRED,
+        /** No real commit can be observed; fail closed and do not nudge. */
+        FAILED
+    }
+
+    /** Main-thread delivery of the immutable epoch plus the RenderThread buffer primitive. */
+    public interface FrameResultSink {
+        void onFrameResult(int epoch, boolean didProduceBuffer);
+    }
+
+    /** Real hardware frame-commit registration, backed by the ViewRoot RenderThread path. */
+    public interface FrameSource {
+        /**
+         * Registers a one-shot observer for the next real RenderThread frame commit.
+         *
+         * @param epoch  immutable generation token; stale results are rejected by the gate
+         * @param result receives the epoch + RenderThread {@code didProduceBuffer} PRIMITIVE on
+         *               the main thread; the implementation must not read a View on RenderThread
+         */
+        Registration registerFrameCommitObserver(int epoch, FrameResultSink result);
+
+        /** Logically cancels the observation for {@code epoch}; a late result is still rejected. */
+        void cancelFrameCommitObserver(int epoch);
+    }
+
+    private final BooleanSupplier mFrameObservable;
+    private final FrameSource mFrameSource;
+    private final Runnable mRequestFrame;
+
+    private Consumer<Boolean> mListener;
+    private int mGeneration;
+    private boolean mArmed;
+    private boolean mCommitted;
+
+    /**
+     * @param frameObservable re-checked right before any emission; must be true only while this
+     *                        exact overlay is attached, shown and its window is visible
+     * @param frameSource     real RenderThread commit registration for that same view
+     * @param requestFrame    issues exactly ONE real traversal request for a REGISTERED generation
+     */
+    public RothkoFodOverlayFrameGate(
+            BooleanSupplier frameObservable, FrameSource frameSource, Runnable requestFrame) {
+        if (frameObservable == null) {
+            throw new NullPointerException("frameObservable");
+        }
+        if (frameSource == null) {
+            throw new NullPointerException("frameSource");
+        }
+        if (requestFrame == null) {
+            throw new NullPointerException("requestFrame");
+        }
+        mFrameObservable = frameObservable;
+        mFrameSource = frameSource;
+        mRequestFrame = requestFrame;
+    }
+
+    public void setListener(Consumer<Boolean> listener) {
+        if (listener == null) {
+            dispose();
+            return;
+        }
+        mListener = listener;
+        arm();
+    }
+
+    public void arm() {
+        if (mListener == null || mArmed) {
+            return;
+        }
+        if (!mFrameObservable.getAsBoolean()) {
+            return;
+        }
+        beginGeneration();
+    }
+
+    /**
+     * Explicit refresh entry for an identical-show refresh or a same-view power/fade recovery:
+     * silently drops the old generation (no duplicate false), then asks for exactly one new real
+     * frame. A {@code true} still comes only from the real commit callback.
+     */
+    public void requestFrame() {
+        if (mListener == null) {
+            return;
+        }
+        invalidateGeneration(true /* cancelSource */);
+        if (!mFrameObservable.getAsBoolean()) {
+            return;
+        }
+        beginGeneration();
+    }
+
+    private void beginGeneration() {
+        final int token = ++mGeneration;
+        mArmed = true;
+        mCommitted = false;
+        final Registration registration = mFrameSource.registerFrameCommitObserver(
+                token, this::onFrameCommitResult);
+        if (registration == Registration.FAILED) {
+            mArmed = false;
+            mGeneration++;
+            return;
+        }
+        if (registration == Registration.REGISTERED) {
+            // Exactly one traversal for this generation. A DEFERRED registration owns its own
+            // single traversal after the real pre-draw registers the RenderThread callback.
+            mRequestFrame.run();
+        }
+    }
+
+    private void onFrameCommitResult(int token, boolean didProduceBuffer) {
+        if (!mArmed || token != mGeneration || mCommitted) {
+            return;
+        }
+        if (!didProduceBuffer) {
+            // NO_BUFFER: never emit O, never retry by timer; a later explicit arm/request may try.
+            invalidateGeneration(false /* cancelSource */);
+            return;
+        }
+        if (!mFrameObservable.getAsBoolean()) {
+            invalidateGeneration(false /* cancelSource */);
+            return;
+        }
+        mCommitted = true;
+        final Consumer<Boolean> listener = mListener;
+        if (listener != null) {
+            listener.accept(Boolean.TRUE);
+        }
+    }
+
+    public void disarm() {
+        if (!mArmed) {
+            return;
+        }
+        invalidateGeneration(true /* cancelSource */);
+        final Consumer<Boolean> listener = mListener;
+        if (listener != null) {
+            listener.accept(Boolean.FALSE);
+        }
+    }
+
+    public void dispose() {
+        mListener = null;
+        invalidateGeneration(true /* cancelSource */);
+    }
+
+    public boolean isArmed() {
+        return mArmed;
+    }
+
+    private void invalidateGeneration(boolean cancelSource) {
+        final int token = mGeneration;
+        mArmed = false;
+        mCommitted = false;
+        mGeneration++;
+        if (cancelSource) {
+            mFrameSource.cancelFrameCommitObserver(token);
+        }
+    }
+
+    /**
+     * Production predicate for RenderThread sync flags. Only {@code SYNC_OK} (0) and
+     * {@code SYNC_REDRAW_REQUESTED} (1) may lead to a real commit result; flags 2|4|8
+     * (lost surface, stopped context, frame dropped) and any unknown bit fail closed.
+     */
+    public static boolean isSyncResultPotentiallyBufferProducing(int syncResult) {
+        return syncResult == SYNC_OK || syncResult == SYNC_REDRAW_REQUESTED;
+    }
+
+    /**
+     * Production identity predicate re-checked on the main thread after the RenderThread commit.
+     * Object identity alone is insufficient for Surface/SurfaceControl: their wrappers can be
+     * mutated or copyFrom'ed, so the captured layer id and Surface generation id are compared too.
+     * All parameters are immutable captures from the main-thread registration moment.
+     */
+    public static boolean isCurrentFrameCapture(
+            boolean sameRootObject,
+            boolean sameWindowToken,
+            boolean capturedSurfaceControlValid,
+            boolean sameSurfaceControlLayerId,
+            boolean capturedSurfaceValid,
+            boolean sameSurfaceGeneration,
+            boolean hardwareEnabled,
+            boolean viewObservable) {
+        return sameRootObject
+                && sameWindowToken
+                && capturedSurfaceControlValid
+                && sameSurfaceControlLayerId
+                && capturedSurfaceValid
+                && sameSurfaceGeneration
+                && hardwareEnabled
+                && viewObservable;
+    }
+
+    /**
+     * Pure RenderThread-to-main hand-off: only the immutable epoch and the didProduceBuffer
+     * primitive cross the thread. The main executor is captured on the main thread.
+     */
+    public static void postFrameCommitResult(
+            Executor mainExecutor, int epoch, FrameResultSink result, boolean didProduceBuffer) {
+        if (mainExecutor == null) {
+            throw new NullPointerException("mainExecutor");
+        }
+        if (result == null) {
+            throw new NullPointerException("result");
+        }
+        mainExecutor.execute(() -> result.onFrameResult(epoch, didProduceBuffer));
+    }
+
+    /**
+     * Shared identity predicate for UI callbacks. Positive AND negative observations may only be
+     * forwarded while the captured overlay object, show generation and touch-view object are all
+     * still current and the overlay is not being torn down.
+     */
+    public static boolean isCurrentOverlayIdentity(
+            boolean sameOverlayObject,
+            boolean sameShowGeneration,
+            boolean sameTouchView,
+            boolean overlayHiding) {
+        return sameOverlayObject && sameShowGeneration && sameTouchView && !overlayHiding;
+    }
+}
