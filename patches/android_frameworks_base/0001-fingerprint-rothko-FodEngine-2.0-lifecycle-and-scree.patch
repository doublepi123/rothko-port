new file mode 100644
index 000000000..25c44b937
--- /dev/null
+++ b/services/core/java/com/android/server/biometrics/sensors/fingerprint/aidl/KeyguardWakePolicyCore.java
@@ -0,0 +1,100 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+package com.android.server.biometrics.sensors.fingerprint.aidl;
+
+import java.util.function.BooleanSupplier;
+
+/** No Android API, claim, Binder endpoint, driver command or biometric payload. */
+final class KeyguardWakePolicyCore {
+    enum Feature { DISABLED, ENABLED }
+    enum Outcome { DISABLED, BAD_EVENT, POLICY_DENIED, NO_DRIVER, DUPLICATE,
+        DRIVER_FAILED, WAKE_FAILED, WAKE_REQUESTED, CLEANUP_UNKNOWN, QUARANTINED }
+    enum Cleanup { RELEASED, FAILED, UNKNOWN }
+    enum Preparation { OBSERVING_CURRENT_PRESS, KNOWN_LOSS, UNKNOWN }
+    enum Completion { REQUESTED, KNOWN_LOSS, UNKNOWN }
+
+    static final class Contact {
+        final Object client, session;
+        final long requestId;
+        final int userId, sensorId, rawInfo, vendorCode, frameworkInfo;
+        Contact(Object client, Object session, long requestId, int userId, int sensorId,
+                int rawInfo, int vendorCode, int frameworkInfo) {
+            this.client=client; this.session=session; this.requestId=requestId;
+            this.userId=userId; this.sensorId=sensorId; this.rawInfo=rawInfo;
+            this.vendorCode=vendorCode; this.frameworkInfo=frameworkInfo;
+        }
+    }
+    interface DriverBackend {
+        ContactLease acquireForExistingAuthentication(Contact contact);
+    }
+    interface ContactLease {
+        // Backend must bind real contact/registration generation to this exact owner.
+        boolean matches(Contact contact);
+        // This is a future independently reviewed backend operation, NOT monitor ACK.
+        Preparation prepareNormalWake();
+        Completion completeNormalWake();
+        default void requestPreparedConfigure(){}
+        Cleanup release();
+    }
+    enum UnavailableDriver implements DriverBackend {
+        INSTANCE;
+        @Override public ContactLease acquireForExistingAuthentication(Contact contact) {
+            return null;
+        }
+    }
+
+    private final Feature mFeature;
+    private final DriverBackend mDriver;
+    private Object mPressClient;
+    private long mPressRequest;
+    private boolean mQuarantined;
+    KeyguardWakePolicyCore(Feature feature, DriverBackend driver) {
+        mFeature=feature; mDriver=driver;
+    }
+    void onUpOrInvalidated() { mPressClient=null; }
+
+    Outcome onRealAidlDown(Contact contact, BooleanSupplier freshPolicy, Runnable normalWake) {
+        if (mFeature != Feature.ENABLED) return Outcome.DISABLED;
+        if (mQuarantined) return Outcome.QUARANTINED;
+        if (contact == null || contact.client == null || contact.session == null
+                || contact.rawInfo != 7 || contact.vendorCode != 22
+                || contact.frameworkInfo != 6) return Outcome.BAD_EVENT;
+        if (mPressClient == contact.client && mPressRequest == contact.requestId)
+            return Outcome.DUPLICATE;
+        try {
+            if (!freshPolicy.getAsBoolean()) return Outcome.POLICY_DENIED;
+        } catch (RuntimeException unavailable) { return Outcome.POLICY_DENIED; }
+        final ContactLease lease;
+        try { lease=mDriver.acquireForExistingAuthentication(contact); }
+        catch (RuntimeException unavailable) { mQuarantined=true; return Outcome.DRIVER_FAILED; }
+        if (lease == null) return Outcome.NO_DRIVER;
+        Outcome outcome=Outcome.DRIVER_FAILED;
+        try {
+            final Preparation preparation=lease.matches(contact)
+                    ?lease.prepareNormalWake():Preparation.KNOWN_LOSS;
+            if (preparation == Preparation.KNOWN_LOSS) outcome=Outcome.POLICY_DENIED;
+            else if (preparation != Preparation.OBSERVING_CURRENT_PRESS) mQuarantined=true;
+            else if (!freshPolicy.getAsBoolean() || !lease.matches(contact)) outcome=Outcome.POLICY_DENIED;
+            else {
+                // One normal wake attempt per press, even when the power service rejects it.
+                mPressClient=contact.client; mPressRequest=contact.requestId;
+                normalWake.run();
+                final Completion completion=lease.completeNormalWake();
+                if(completion==Completion.REQUESTED)lease.requestPreparedConfigure();
+                // A normal API wake was requested even if UP/expiry now prevents
+                // continuity. Finally still STOPs that known-lost transfer.
+                if (completion != Completion.UNKNOWN) outcome=Outcome.WAKE_REQUESTED;
+                else { mQuarantined=true; outcome=Outcome.DRIVER_FAILED; }
+            }
+        } catch (RuntimeException failure) {
+            mQuarantined=true; outcome=Outcome.WAKE_FAILED;
+        } finally {
+            Cleanup cleanup;
+            try { cleanup=lease.release(); }
+            catch (RuntimeException failure) { cleanup=Cleanup.UNKNOWN; }
+            if (cleanup != Cleanup.RELEASED) {
+                mQuarantined=true; outcome=Outcome.CLEANUP_UNKNOWN;
+            }
+        }
+        return outcome;
+    }
+}
