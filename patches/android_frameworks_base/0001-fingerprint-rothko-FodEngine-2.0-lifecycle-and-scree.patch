+        final java.util.concurrent.atomic.AtomicBoolean retired=new java.util.concurrent.atomic.AtomicBoolean();
+        final java.util.concurrent.atomic.AtomicBoolean revoked=new java.util.concurrent.atomic.AtomicBoolean();
+        java.util.function.Consumer<Boolean> pendingReady;boolean readySeen;
+        final java.util.function.BooleanSupplier guard;final Runnable closed;
+        PreparedFrameOwner(BaseClientMonitor client,long request,int sensor,long nonce,long security,long expires,
