+    /**
+     * A genuine power/fade invalidation starts a fresh observation generation. Rotate a NEW
+     * pending object from the still-valid show record; never reuse the consumed attempted object.
+     */
+    private void rotateObservationForFreshFrame() {
+        final Observation record = mShowRecord;
+        if (record == null) return;
+        if (record.feedbackEpoch != mFeedbackEpoch.get()) return;
+        synchronized (mLock) {
+            if (mActive == null || mActive.client != record.client
+                    || mActive.requestId != record.requestId
+                    || mActive.sensorId != record.sensorId
+                    || mActiveRevoked) {
+                return;
+            }
+            if (mUiOwner != null && mUiOwner != record.ownerBinder) return;
+        }
+        final Observation fresh = new Observation(record.wrapper, record.client,
+                record.reason, record.callback, record.feedbackEpoch);
+        fresh.windowWasReady = false;
+        mPendingObservation = fresh;
+    }
+
+    /** Worker-only: one bounded identical show after a genuine ready-window transition. */
+    private void maybeRequestFreshFrame() {
+        final Observation pending = mPendingObservation;
+        if (pending == null || pending.attempted || pending.original == null) return;
+        if (pending.feedbackEpoch != mFeedbackEpoch.get()) {
+            // An ingress cancel/finish/owner/transport invalidation already revoked this request.
+            mPendingObservation = null;
+            return;
+        }
+        if (pending.windowWasReady) {
+            // The early show may already have produced O/I; a fresh observation must not reuse
+            // that old READY. Invalidate the old epoch once, then let prepare arm the new window.
+            synchronized (mLock) {
+                mFenceA++;
+                mFenceB++;
+            }
+            mMachine.onOverlayFrameRevoked(pending.client, pending.requestId, pending.sensorId);
+            pending.windowWasReady = false;
+        }
+        synchronized (mLock) {
+            if (mActive == null || mActive.client != pending.client
+                    || mActive.requestId != pending.requestId
+                    || mActive.sensorId != pending.sensorId
+                    || mActiveRevoked) {
+                mPendingObservation = null;
+                return;
+            }
+            if (mUiOwner == null) return; // owner bind has not happened yet
+            if (mUiOwner != pending.ownerBinder) {
+                mPendingObservation = null; // replaced owner cannot adopt the old request
+                return;
+            }
+        }
+        if (!mMachine.prepareOverlayFrameObservation(
+                pending.client, pending.requestId, pending.sensorId)) {
+            return;
+        }
+        pending.attempted = true; // mark before sending; no periodic retry
+        mPendingObservation = null;
+        try {
+            pending.original.showUdfpsOverlay(pending.requestId, pending.sensorId,
+                    pending.reason, pending.callback);
+        } catch (RemoteException ignored) {
+            // One attempt only.
+        }
+    }
+
+    private void cancelPendingObservation() {
+        mPendingObservation = null;
+    }
