+    private void handleWrapperShow(ClientOverlay wrapper, BaseClientMonitor client, int reason,
+            IUdfpsOverlayControllerCallback callback, long showEpoch) {
+        if (client == null || wrapper.mOriginal == null) return;
+        if (showEpoch != mFeedbackEpoch.get()) return; // cancel/finish/owner/transport crossed it
+        final boolean active;
+        final boolean ownerReady;
+        final IBinder currentOwner;
+        synchronized (mLock) {
+            active = !mActiveRevoked
+                    && activeMatchesLocked(client, wrapper.mRequestId, wrapper.mSensorId);
+            currentOwner = mUiOwner;
+            // Owner bind may legitimately happen after wrapper creation (late bind); wait for it.
+            ownerReady = currentOwner != null && currentOwner == wrapper.mOwnerBinder;
+        }
+        if (!active) return;
+        if (currentOwner != null && currentOwner != wrapper.mOwnerBinder) {
+            return; // wrapper is bound to a replaced owner and never retargets a new Binder
+        }
+        if (mShowRecord != null) {
+            // A new real show is a new observation lifetime. Clear the previous O/I and advance
+            // the FSM revocation token before prepare can arm a monitor for the new frame.
+            mMachine.onOverlayFrameRevoked(client, wrapper.mRequestId, wrapper.mSensorId);
+        }
+        if (mPendingObservation != null && mPendingObservation.wrapper != wrapper) {
+            mPendingObservation = null;
+        }
+        final boolean windowReady = mMachine.prepareOverlayFrameObservation(
+                client, wrapper.mRequestId, wrapper.mSensorId);
+        final Observation observation = new Observation(wrapper, client, reason, callback, showEpoch);
+        observation.windowWasReady = windowReady;
+        mShowRecord = observation;
+        notifyProductionWakeLifecycle(WAKE_OBSERVATION);
+        if (windowReady && ownerReady) {
+            // The real show already requested the observation frame; no duplicate is sent.
+            observation.attempted = true;
+            mPendingObservation = null;
+        } else {
+            // Bounded one-shot request tied to this exact show/client/owner.
+            mPendingObservation = observation;
+        }
+        try {
+            wrapper.mOriginal.showUdfpsOverlay(wrapper.mRequestId, wrapper.mSensorId, reason,
+                    callback);
+        } catch (RemoteException ignored) {
+            // Oneway; a failed show stays failed and is never retried periodically.
+        }
+    }
+
+    private void handleWrapperHide(ClientOverlay wrapper, int sensorId) {
+        if (sensorId != wrapper.mSensorId) return;
+        if (mShowRecord != null && mShowRecord.wrapper != wrapper) {
+            // Another wrapper owns the current show: neither clear its record nor forward.
+            return;
+        }
+        if (mPendingObservation != null && mPendingObservation.wrapper == wrapper) {
+            mPendingObservation = null;
+        }
+        mShowRecord = null;
+        notifyProductionWakeLifecycle();
+        try {
+            wrapper.mOriginal.hideUdfpsOverlay(sensorId);
+        } catch (RemoteException ignored) {
+            // Original hide failure stays original.
+        }
+    }
