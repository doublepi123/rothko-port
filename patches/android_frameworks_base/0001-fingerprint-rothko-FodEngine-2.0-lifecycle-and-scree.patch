+                if (!activeMatchesLocked(client, requestId, sensorId)) return;
+                owner = ownerRefLocked();
+                mFenceA++;
+                mFenceB++;
+            }
+            mWorker.post(() -> {
+                if (ownerStillCurrent(owner)) {
+                    mMachine.onOverlayFrameRevoked(client, requestId, sensorId);
+                }
+            });
+        } else if (event == FRAME_COMMITTED) {
+            // I: capture/check A and B. It can never create overlay presence on its own.
+            final IngressStamp stamp = captureIngress();
+            mWorker.post(() -> {
+                if (ingressStillValid(stamp, true)) {
+                    mMachine.onFrameCommitted(client, requestId, sensorId);
+                    maybeForwardPreparedReady(mPreparedFrameOwner.get());
+                }
+            });
+        } else if (event == FRAME_REVOKED) {
+            // Per-press revoke advances B only. A pending O (A unchanged) is still accepted.
+            final OwnerRef owner;
+            synchronized (mLock) {
+                if (!activeMatchesLocked(client, requestId, sensorId)) return;
+                owner = ownerRefLocked();
+                mFenceB++;
+            }
+            // Renderer ownership is closed by its exact grant nonce, not by an
+            // untyped old FRAME_REVOKED which could target a newer same-request scope.
+            mWorker.post(() -> {
+                if (ownerStillCurrent(owner)) {
+                    mMachine.onFrameRevoked(client, requestId, sensorId);
+                }
+            });
+        } else if (event == android.hardware.fingerprint.FingerprintManager.UDFPS_UI_READY) {
+            final IngressStamp stamp = captureIngress();
+            mWorker.post(() -> {
+                mMachine.onReadyRequested();
+                if (!ingressStillValid(stamp, true)
+                        || !mMachine.isReady(client, requestId, sensorId)) {
+                    mMachine.onReadyResult(false);
+                    return;
+                }
+                // Provider rechecks scheduler identity again on its handler before forwarding.
+                final long revocation = mMachine.revocation();
+                mFingerprintHandler.post(() -> deliverStandardReady.accept(
+                        () -> revocation == mMachine.revocation()
+                                && fencesUnchanged(stamp.a, stamp.b),
+                        forwarded -> mWorker.post(() -> mMachine.onReadyResult(
+                                Boolean.TRUE.equals(forwarded)))));
+            });
+        }
+    }
+
+    /** Current IUdfpsOverlayController binder only; death clears illumination, no rebind retry. */
+    public void setUiOwner(IBinder owner) {
+        final IBinder oldOwner;
+        final IBinder.DeathRecipient oldDeath;
+        final long stamp;
+        final ActiveClient activeAtReplacement;
+        synchronized (mLock) {
+            if (mUiOwner == owner) return;
+            oldOwner = mUiOwner;
+            oldDeath = mUiDeath;
+            activeAtReplacement = mActive;
+            mUiOwner = owner;
+            mUiDeath = null;
+            stamp = ++mOwnerStamp;
+            mObserveEpoch.incrementAndGet();
+            // Owner replacement invalidates immediately, not only when worker cleanup runs.
+            mFenceA++;
+            mFenceB++;
+            mOwnerPendingStamp = stamp;
+            if (oldOwner != null && oldOwner != owner) {
+                mFeedbackEpoch.incrementAndGet();
+                // Owner replacement/removal revokes the active session at ingress; only a new
+                // scheduler client may rearm it.
+                mActiveRevoked = true;
+            }
+        }
+        notifyProductionWakeLifecycle();
+        if (owner != null) {
+            final IBinder.DeathRecipient death = () -> onUiOwnerDied(owner, stamp);
+            boolean linked = false;
+            try {
+                owner.linkToDeath(death, 0);
+                linked = true;
+            } catch (RemoteException | RuntimeException e) {
+                // Owner already dead: stay invalidated; the worker cleanup still runs.
+            }
+            boolean keep;
+            synchronized (mLock) {
+                keep = linked && mUiOwner == owner && mOwnerStamp == stamp;
+                if (keep) {
+                    mUiDeath = death;
+                } else if (!linked && mUiOwner == owner && mOwnerStamp == stamp) {
+                    mUiOwner = null;
+                    mUiDeath = null;
+                    mFenceA++;
+                    mFenceB++;
+                    mActiveRevoked = true;
+                    mOwnerPendingStamp = stamp;
+                }
+            }
+            if (linked && !keep) {
+                // A concurrent replacement won; never leave a stale death link behind.
+                try { owner.unlinkToDeath(death, 0); }
+                catch (java.util.NoSuchElementException ignored) { /* no stale recipient */ }
+            }
+        }
+        mWorker.post(() -> {
+            if (oldOwner != null && oldDeath != null) {
+                try { oldOwner.unlinkToDeath(oldDeath, 0); }
+                catch (java.util.NoSuchElementException alreadyDead) { /* no stale recipient */ }
+            }
+            boolean currentTransition;
+            boolean sessionAlreadyReplaced;
+            synchronized (mLock) {
+                currentTransition = mOwnerStamp == stamp;
+                if (currentTransition) mOwnerPendingStamp = 0;
+                // A scheduler client that started while this replacement was in flight has
+                // already cleared the old session; do not quarantine the new one.
+                sessionAlreadyReplaced = mActive != null && mActive != activeAtReplacement;
+            }
+            // A stale replacement cleanup must not quarantine a session a newer transition owns.
+            if (currentTransition) {
+                final boolean firstBind = oldOwner == null && owner != null;
+                if (!firstBind && (owner == null || (oldOwner != null && oldOwner != owner))) {
+                    // A replaced/removed owner invalidates its show ownership and feedback.
+                    mShowRecord = null;
+                    mPendingObservation = null;
+                }
+                // A first owner bind is readiness, not a death: never quarantine the live client.
+                if (!firstBind && !sessionAlreadyReplaced) mMachine.onUiOwnerDied();
+                maybeRequestFreshFrame();
+                notifyProductionWakeLifecycle();
+            }
+        });
+    }
+
+    /** Death only acts for its captured still-current owner stamp. */
+    private void onUiOwnerDied(IBinder owner, long stamp) {
+        final long deathStamp;
+        final ActiveClient activeAtDeath;
+        synchronized (mLock) {
+            if (mUiOwner != owner || mOwnerStamp != stamp) return;
+            activeAtDeath = mActive;
+            mUiOwner = null;
+            mUiDeath = null;
+            mOwnerStamp++;
+            deathStamp = mOwnerStamp;
+            mObserveEpoch.incrementAndGet();
+            mFenceA++;
+            mFenceB++;
+            mFeedbackEpoch.incrementAndGet();
+            mActiveRevoked = true;
+            mOwnerPendingStamp = deathStamp;
+        }
+        notifyProductionWakeLifecycle();
+        mWorker.post(() -> {
+            boolean currentTransition;
+            boolean sessionAlreadyReplaced;
+            synchronized (mLock) {
+                currentTransition = mOwnerStamp == deathStamp && mOwnerPendingStamp != 0;
+                if (currentTransition) mOwnerPendingStamp = 0;
+                sessionAlreadyReplaced = mActive != null && mActive != activeAtDeath;
+            }
+            if (currentTransition) {
+                // Owner death invalidates show ownership and any one-shot feedback.
+                mShowRecord = null;
+                mPendingObservation = null;
+                if (!sessionAlreadyReplaced) mMachine.onUiOwnerDied();
+            }
+        });
+    }
+
+    /** Only a matched current client may advance its cancel fence. */
+    public void onCancelRequested(BaseClientMonitor client) {
+        if (client == null) return;
+        synchronized (mLock) {
+            if (!activeMatchesLocked(client, client.getRequestId(), client.getSensorId())) return;
+            // Mark the active session revoked at ingress, before the worker cancel runs.
+            mActiveRevoked = true;
+            // Cancel invalidates session/overlay and illumination/READY immediately.
+            mObserveEpoch.incrementAndGet();
+            mFenceA++;
+            mFenceB++;
+            mFeedbackEpoch.incrementAndGet();
+        }
+        notifyProductionWakeLifecycle();
+        mWorker.post(() -> {
+            cancelPendingFor(client);
+            mMachine.onCancelRequested(client);
+        });
+    }
+
+    /**
+     * Caller-thread ingress fence for cancelEnrollment/cancelAuthentication.
+     *
+     * Reads only the scheduler-published active identity (client/token/request/sensor), never the
+     * scheduler current client. On an exact match it immediately advances both generations so an
+     * already queued READY/FRAME cannot cross this cancel input, then posts the machine cancel.
+     * A mismatched token/request/sensor returns false and does not touch another client.
+     */
+    public boolean onCancelTokenSynchronously(IBinder token, long requestId, int sensorId) {
+        if (token == null) return false;
+        final BaseClientMonitor client;
+        synchronized (mLock) {
+            final ActiveClient active = mActive;
+            if (active == null
+                    || active.token != token
+                    || active.requestId != requestId
+                    || active.sensorId != sensorId) {
+                return false;
+            }
+            client = active.client;
+            mObserveEpoch.incrementAndGet();
+            mActiveRevoked = true;
+            mFenceA++;
+            mFenceB++;
+            mFeedbackEpoch.incrementAndGet();
+        }
+        notifyProductionWakeLifecycle();
+        mWorker.post(() -> {
+            cancelPendingFor(client);
+            mMachine.onCancelRequested(client);
+        });
+        return true;
+    }
+
+    public void onFingerprintHalDied() {
+        mObserveEpoch.incrementAndGet();
+        synchronized (mLock) {
+            // Transport/HAL loss invalidates both lifetimes immediately.
+            mActiveRevoked = true;
+            mFenceA++;
+            mFenceB++;
+            mFeedbackEpoch.incrementAndGet();
+        }
+        notifyProductionWakeLifecycle();
+        mWorker.post(() -> {
+            cancelPendingObservation();
+            mMachine.onUiOwnerDied();
+        });
+    }
+
+    private void vendorDied(IBinder binder) {
+        if (mTransport.isCurrent(binder)) {
+            mObserveEpoch.incrementAndGet();
+            synchronized (mLock) {
+                // Transport loss invalidates both lifetimes immediately.
+                mActiveRevoked = true;
+                mFenceA++;
+                mFenceB++;
+                mFeedbackEpoch.incrementAndGet();
+            }
+            notifyProductionWakeLifecycle();
+        }
+        mWorker.post(() -> {
+            // A late death notification for the previous handle cannot kill its replacement.
+            if (mTransport.isCurrent(binder)) {
+                cancelPendingObservation();
+                mMachine.onTransportDied();
+            }
+        });
+    }
+
+    private void handleDisplayPower(int power) {
+        final boolean changed;
+        synchronized (mLock) {
+            changed = power != mLastPower;
+            if (changed) {
+                mLastPower = power;
+                mFenceA++;
+                mFenceB++;
+            }
+        }
+        mMachine.onDisplayPower(power);
+        if (changed) {
+            notifyProductionWakeLifecycle(power==0?WAKE_OFF:power==2?WAKE_DISPLAY:WAKE_SECURITY);
+            rotateObservationForFreshFrame();
+            maybeRequestFreshFrame();
+            maybeRequestPreparedConfigure();
+            maybeForwardPreparedReady(mPreparedFrameOwner.get());
+        }
+    }
+
+    private void handleFadeObserved(boolean visible) {
+        final boolean changed;
+        synchronized (mLock) {
+            changed = mLastFade == null || mLastFade != visible;
+            if (changed) {
+                mLastFade = visible;
+                mFenceA++;
+                mFenceB++;
+            }
+        }
+        mMachine.onFadeObserved(visible);
+        if (changed) {
+            notifyProductionWakeLifecycle(visible?WAKE_FADE_BLOCK:WAKE_DISPLAY);
+            rotateObservationForFreshFrame();
+            maybeRequestFreshFrame();
+            maybeRequestPreparedConfigure();
+            maybeForwardPreparedReady(mPreparedFrameOwner.get());
+        }
+    }
+
+    private IngressStamp captureIngress() {
+        synchronized (mLock) {
+            final ActiveClient active = mActive;
+            return new IngressStamp(mFenceA, mFenceB, ownerRefLocked(), mOwnerPendingStamp,
+                    active == null ? null : active.client,
+                    active == null ? 0L : active.requestId,
+                    active == null ? -1 : active.sensorId,
+                    mActiveRevoked);
+        }
+    }
+
+    private OwnerRef ownerRefLocked() {
+        return mUiOwner == null ? null : new OwnerRef(mUiOwner, mOwnerStamp);
+    }
+
+    private boolean activeMatchesLocked(BaseClientMonitor client, long requestId, int sensorId) {
+        return mActive != null && mActive.client == client
+                && mActive.requestId == requestId && mActive.sensorId == sensorId;
+    }
+
+    private boolean ownerStillCurrent(OwnerRef owner) {
+        synchronized (mLock) {
+            if (mOwnerPendingStamp != 0) return false;
+            if (owner == null) return mUiOwner == null;
+            return mUiOwner == owner.binder && mOwnerStamp == owner.stamp;
+        }
+    }
+
+    private boolean ingressStillValid(IngressStamp stamp, boolean includeB) {
+        final IBinder ownerBinder;
+        synchronized (mLock) {
+            if (stamp.a != mFenceA) return false;
+            if (includeB && stamp.b != mFenceB) return false;
+            // Captured during an owner transition: never let it cross the cleanup boundary.
+            if (stamp.ownerPending != 0 || mOwnerPendingStamp != 0) return false;
+            // A positive observation is never valid for a revoked/canceled/finished session.
+            if (stamp.activeRevoked || mActiveRevoked) return false;
+            if (stamp.client == null || mActive == null || mActive.client != stamp.client
+                    || mActive.requestId != stamp.requestId
+                    || mActive.sensorId != stamp.sensorId) {
+                return false;
+            }
+            // A null/replaced owner can never authorize a positive observation.
+            if (stamp.owner == null || mUiOwner != stamp.owner.binder
+                    || mOwnerStamp != stamp.owner.stamp) {
+                return false;
+            }
+            ownerBinder = stamp.owner.binder;
+        }
+        // Binder liveness is checked outside the lock; a death still advances the fences.
+        return ownerBinder.isBinderAlive();
+    }
+
+    private boolean fencesUnchanged(long a, long b) {
+        synchronized (mLock) {
+            return a == mFenceA && b == mFenceB;
+        }
+    }
+}
