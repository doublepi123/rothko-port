+    public ClientMonitorCallback callback(FingerprintSensorPropertiesInternal props,
+            java.util.function.BooleanSupplier realHalActive) {
+        if (props == null || props.sensorType != FingerprintSensorProperties.TYPE_UDFPS_OPTICAL) {
+            return null;
+        }
+        return new ClientMonitorCallback() {
+            @Override public void onClientStarted(BaseClientMonitor client) {
+                if (!realHalActive.getAsBoolean()) return;
+                // Do not let FingerprintDetectClient, remove, probe or any non-Udfps client
+                // become the bridge session. The same sensor is required by props.
+                if (!isBridgeClient(client, props.sensorId)) return;
+                final ActiveClient next = new ActiveClient(client);
+                synchronized (mLock) {
+                    final ActiveClient previous = mActive;
+                    mActive = next;
+                    if (previous == null || previous.client != client) {
+                        mObserveEpoch.incrementAndGet();
+                        // Only a new scheduler client rearms a revoked session.
+                        mActiveRevoked = false;
+                    }
+                    // A replacement client inherits neither fact; a repeated start does not churn.
+                    if (previous != null && previous.client != client) {
+                        mFenceA++;
+                        mFenceB++;
+                        mFeedbackEpoch.incrementAndGet();
+                    }
+                }
+                int state = BiometricStateListener.STATE_IDLE;
+                if (client instanceof EnrollClient) state = BiometricStateListener.STATE_ENROLLING;
+                else if (client instanceof AuthenticationClient) {
+                    AuthenticationClient<?, ?> auth = (AuthenticationClient<?, ?>) client;
+                    state = auth.isKeyguard() ? BiometricStateListener.STATE_KEYGUARD_AUTH
+                            : auth.isBiometricPrompt() ? BiometricStateListener.STATE_BP_AUTH
+                            : BiometricStateListener.STATE_AUTH_OTHER;
+                }
+                final int eventState = state;
+                mWorker.post(() -> {
+                    if (mPendingObservation != null
+                            && mPendingObservation.client != client) {
+                        mPendingObservation = null;
+                    }
+                    PreparedFrameOwner oldPrepared=mPreparedFrameOwner.get();
+                    if(oldPrepared!=null&&oldPrepared.client!=client)retirePreparedFrame(oldPrepared);
+                    mMachine.onClientStarted(client, client.getRequestId(),
+                            client.getSensorId(), eventState);
+                    notifyProductionWakeLifecycle();
+                    maybeRequestFreshFrame();
+                });
+            }
+            @Override public void onClientFinished(BaseClientMonitor client, boolean success) {
+                if (!isBridgeClientType(client)) return;
+                synchronized (mLock) {
+                    final ActiveClient active = mActive;
+                    if (active == null || active.client != client) return;
+                    mActive = null;
+                    mObserveEpoch.incrementAndGet();
+                    mActiveRevoked = true;
+                    // Finish invalidates session/overlay and illumination/READY immediately.
+                    mFenceA++;
+                    mFenceB++;
+                    mFeedbackEpoch.incrementAndGet();
+                }
+                mWorker.post(() -> {
+                    cancelPendingFor(client);
+                    mMachine.onClientFinished(client);
+                    notifyProductionWakeLifecycle();
+                });
+            }
+        };
+    }
