index 000000000..92e194f53
--- /dev/null
+++ b/services/core/java/com/android/server/biometrics/sensors/fingerprint/fod/FodAcquisitionDiagnostics.java
@@ -0,0 +1,228 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+package com.android.server.biometrics.sensors.fingerprint.fod;
+
+import java.io.PrintWriter;
+import java.util.concurrent.atomic.AtomicLongArray;
+
+/**
+ * Optional rothko HAL-callback observation; no Android/HAL dependency or biometric payload state.
+ * Provider owns one boot-lifetime set. Received means callback ingress; delivered means the
+ * existing scheduler-selected consumer returned, NOT that an image, template or auth succeeded.
+ * All counters saturate. Independent atomics are not a cross-handler transactional snapshot.
+ */
+public final class FodAcquisitionDiagnostics {
+
+    /** Fixed software grant branches only; no identity, timing or biometric payload. */
+    public enum GrantEvent { GRANT_ENTRY, GRANT_CLOSED, GRANT_REUSED, GRANT_NOT_COMPLETE, GRANT_FENCE_LOST, GRANT_FRESH, HANDLER_NOT_POSTED, HANDLER_CHECK_EXPIRED, HANDLER_POLICY_REJECTED, HANDLER_WAIT_TIMEOUT, HANDLER_NOT_ALLOWED, HANDLER_FENCE_LOST, NATIVE_QUERY, NATIVE_PRECHECK_REJECTED, NATIVE_TRANSACT_FAILED, NATIVE_DEADLINE_ZERO, NATIVE_BAD_TRAILING, NATIVE_HAS_FDS, NATIVE_FENCE_LOST, NATIVE_DEADLINE_EXPIRED, NATIVE_DEADLINE_EXCEEDS, NATIVE_RPC_EXCEPTION, GRANT_AUTHORIZED, GRANT_DENIED }
+    private static final AtomicLongArray sGrantCounts = new AtomicLongArray(GrantEvent.values().length);
+    public static void noteGrant(GrantEvent event) {
+        int index=event.ordinal(); long before;
+        do { before=sGrantCounts.get(index); if(before==Long.MAX_VALUE)return;
+        } while(!sGrantCounts.compareAndSet(index,before,before+1));
+    }
+    public static boolean checkGrant(GrantEvent event,boolean accepted) {
+        if(!accepted)noteGrant(event); return accepted;
+    }
+    private static void dumpGrant(PrintWriter pw) {
+        pw.println("RothkoFodGrant/1 scope=SOFTWARE_EVENTS physicalProof=NONE consistency=INDEPENDENT_ATOMICS");
+        for(GrantEvent event:GrantEvent.values())
+            pw.println("RothkoFodGrant/1 "+event.name()+"="+sGrantCounts.get(event.ordinal()));
+    }
+
+    /** Fixed software branch events only; never an owner, nonce, time or result payload. */
+    public enum WakeEvent {
+        RAW_DOWN,
+        RAW_UP,
+        CALLBACK_NO_CLIENT,
+        CALLBACK_RECHECK_REJECTED,
+        CORE_DISABLED,
+        CORE_BAD_EVENT,
+        CORE_POLICY_DENIED,
+        CORE_NO_DRIVER,
+        CORE_DUPLICATE,
+        CORE_DRIVER_FAILED,
+        CORE_WAKE_FAILED,
+        CORE_WAKE_REQUESTED,
+        CORE_CLEANUP_UNKNOWN,
+        CORE_QUARANTINED,
+        ARM_ACCEPTED,
+        ARM_KNOWN_LOSS,
+        ARM_UNKNOWN,
+        PREPARE_NATIVE_ACCEPTED,
+        PREPARE_NATIVE_KNOWN_LOSS,
+        PREPARE_NATIVE_UNKNOWN,
+        COMPLETE_NATIVE_ACCEPTED,
+        COMPLETE_NATIVE_KNOWN_LOSS,
+        COMPLETE_NATIVE_UNKNOWN,
+        PREPARE_POSTCHECK_REJECTED,
+        COMPLETE_PRECHECK_REJECTED,
+        COMPLETE_POSTCHECK_REJECTED,
+        RENDER_POSTED,
+        RENDER_POSTCHECK_REJECTED,
+        RENDER_OFFER_DELIVERED,
+        LIFECYCLE_SECURITY,
+        LIFECYCLE_DISPLAY,
+        LIFECYCLE_OBSERVATION,
+        LIFECYCLE_OFF,
+        LIFECYCLE_FADE_BLOCK,
+        LIFECYCLE_KEEP,
+        LIFECYCLE_STOP,
+        LEASE_STOP,
+        LEASE_RELEASE_KEEP,
+        LEASE_RELEASE_STOP,
+        CONFIGURE_ENTRY,
+        CONFIGURE_ARGUMENT_REJECTED,
+        CONFIGURE_OWNER_REJECTED,
+        CONFIGURE_QUEUE_REJECTED,
+        RENDER_WAIT_EXPIRED,
+        RENDER_WAIT_STATE,
+        RENDER_WIRE_ATTEMPT,
+        RENDER_WIRE_FAILED
+    }
+    private static final AtomicLongArray sWakeCounts = new AtomicLongArray(WakeEvent.values().length);
+    public static void noteWake(WakeEvent event) {
+        final int index = event.ordinal();
+        long before;
+        do {
+            before = sWakeCounts.get(index);
+            if (before == Long.MAX_VALUE) return;
+        } while (!sWakeCounts.compareAndSet(index, before, before + 1));
+    }
+    public static int recordWakeWire(int command, int result) {
+        final int offset = result == 0 ? 0 : result == 1 ? 1 : 2;
+        final WakeEvent event;
+        if (command == 3) event = WakeEvent.values()[WakeEvent.ARM_ACCEPTED.ordinal() + offset];
+        else if (command == 4) event = WakeEvent.values()[WakeEvent.PREPARE_NATIVE_ACCEPTED.ordinal() + offset];
+        else if (command == 5) event = WakeEvent.values()[WakeEvent.COMPLETE_NATIVE_ACCEPTED.ordinal() + offset];
+        else return result;
+        noteWake(event);
+        return result;
+    }
+    public static void noteWakeLifecycle(int reason) {
+        switch (reason) {
+            case 1 -> noteWake(WakeEvent.LIFECYCLE_SECURITY);
+            case 2 -> noteWake(WakeEvent.LIFECYCLE_DISPLAY);
+            case 3 -> noteWake(WakeEvent.LIFECYCLE_OBSERVATION);
+            case 4 -> noteWake(WakeEvent.LIFECYCLE_OFF);
+            case 5 -> noteWake(WakeEvent.LIFECYCLE_FADE_BLOCK);
+            default -> { }
+        }
+    }
+    private static void dumpWake(PrintWriter pw) {
+        dumpGrant(pw);
+        pw.println("RothkoFodWake/1 scope=SOFTWARE_EVENTS physicalProof=NONE consistency=INDEPENDENT_ATOMICS");
+        for (WakeEvent event : WakeEvent.values()) {
+            pw.println("RothkoFodWake/1 " + event.name() + "=" + sWakeCounts.get(event.ordinal()));
+        }
+    }
+
+    public static final int ACQUIRED = 0, PROGRESS = 1, ERROR = 2;
+    private static final int AIDL = 9, FRAMEWORK = 10, GOOD = 11, START = 12,
+            VENDOR_IDLE = 13, VENDOR_WORK = 14, VENDOR_OTHER = 15, OTHER = 16,
+            ERROR_HW = 17, ERROR_TIMEOUT = 18, ERROR_CANCEL = 19, ERROR_VENDOR = 20,
+            ERROR_OTHER = 21, ROUTE_AIDL = 22, ROUTE_HIDL = 23, UI_ATTEMPT = 24, UI_RETURNED = 25, UI_REMOTE = 26, UI_HIDL = 27;
+    private static final int PAIR_AIDL_7_22=28,PAIR_AIDL_7_23=29,
+            PAIR_FRAMEWORK_6_22=30,PAIR_FRAMEWORK_6_23=31;
+    private final AtomicLongArray mCounts = new AtomicLongArray(32);
+    private final Runnable mObserveTick;
+    private final java.util.function.Consumer<Boolean> mObservePolicy;
+    private final Runnable mObserveUp;
+    public FodAcquisitionDiagnostics(){this(null,null,null);}
+    public FodAcquisitionDiagnostics(Runnable tick,java.util.function.Consumer<Boolean> policy){
+        this(tick,policy,null);
+    }
+    public FodAcquisitionDiagnostics(Runnable tick,java.util.function.Consumer<Boolean> policy,Runnable up){
+        mObserveTick=tick;mObservePolicy=policy;mObserveUp=up;
+    }
+    public void onObservePolicyChange(boolean pending){if(mObservePolicy!=null)mObservePolicy.accept(pending);}
+
+    private void increment(int index) {
+        long before;
+        do {
+            before = mCounts.get(index);
+            if (before == Long.MAX_VALUE) return;
+        } while (!mCounts.compareAndSet(index, before, before + 1));
+    }
+
+    /** Registration path only; does not fetch or inspect any HAL/session object. */
+    public void onProviderRoute(boolean aidl) { increment(aidl ? ROUTE_AIDL : ROUTE_HIDL); }
+
+    public void onUiReadyAttempt(boolean hidl) {
+        increment(UI_ATTEMPT);
+        if (hidl) increment(UI_HIDL);
+    }
+    public void onUiReadyReturned() { increment(UI_RETURNED); }
+    public void onUiReadyRemoteException() { increment(UI_REMOTE); }
+
+    /** Namespace-sensitive classification only. Vendor raw values are never retained/output. */
+    public void onAcquired(boolean aidl, int acquired, int vendorCode) {
+        increment(ACQUIRED * 3);
+        increment(aidl ? AIDL : FRAMEWORK);
+        if(acquired==(aidl?7:6)){
+            if(vendorCode==22)increment(aidl?PAIR_AIDL_7_22:PAIR_FRAMEWORK_6_22);
+            else if(vendorCode==23){increment(aidl?PAIR_AIDL_7_23:PAIR_FRAMEWORK_6_23);
+                if(mObserveUp!=null)mObserveUp.run();}
+        }
+        if(mObserveTick!=null)mObserveTick.run();
+        // Exact constants from AcquiredInfo.aidl and BiometricFingerprintConstants.java.
+        if (acquired == (aidl ? 1 : 0)) increment(GOOD);
+        else if (acquired == (aidl ? 8 : 7)) increment(START);
+        else if (acquired == (aidl ? 7 : 6)) {
+            // Same-firmware mfp-daemon: 7/0 idle, 7/21 workmode; no success assertion.
+            increment(vendorCode == 0 ? VENDOR_IDLE : vendorCode == 21 ? VENDOR_WORK
+                    : VENDOR_OTHER);
+        } else increment(OTHER);
+    }
+
+    /** No enrollmentId, remaining, completion, user or template parameter is accepted. */
+    public void onProgress() { increment(PROGRESS * 3); }
+
+    /** Already converted FRAMEWORK enum; never records vendorCode or exception data. */
+    public void onError(int frameworkError) {
+        increment(ERROR * 3);
+        increment(frameworkError == 1 ? ERROR_HW : frameworkError == 3 ? ERROR_TIMEOUT
+                : frameworkError == 5 ? ERROR_CANCEL : frameworkError == 8 ? ERROR_VENDOR
+                : ERROR_OTHER);
+    }
+
+    public void onDelivered(int kind) {
+        if (kind >= ACQUIRED && kind <= ERROR) increment(kind * 3 + 1);
+    }
+
+    public void onDropped(int kind) {
+        if (kind >= ACQUIRED && kind <= ERROR) increment(kind * 3 + 2);
+    }
+
+    /** Existing permission-gated fingerprint dump only. No lock, scheduler, session or binder. */
+    public void dumpFixedPairs(PrintWriter pw){
+        pw.println("RothkoFodPair/1 scope=RECEIVED_FIXED_PAIR_BUCKETS physicalProof=NONE"
+                +" consistency=INDEPENDENT_ATOMICS aidl7v22="+mCounts.get(PAIR_AIDL_7_22)
+                +" aidl7v23="+mCounts.get(PAIR_AIDL_7_23)
+                +" framework6v22="+mCounts.get(PAIR_FRAMEWORK_6_22)
+                +" framework6v23="+mCounts.get(PAIR_FRAMEWORK_6_23));
+    }
+
+    public void dump(PrintWriter pw) {
+        final long[] c = new long[mCounts.length()];
+        for (int i = 0; i < c.length; i++) c[i] = mCounts.get(i);
+        final String route = c[ROUTE_AIDL] == 0 ? (c[ROUTE_HIDL] == 0 ? "UNKNOWN" : "HIDL")
+                : c[ROUTE_HIDL] == 0 ? "AIDL" : "MIXED";
+        final String p = "RothkoFodAcquire/1 ";
+        pw.println(p + "scope=CALLBACK_EVENTS physicalProof=NONE consistency=INDEPENDENT_ATOMICS"
+                + " uiReadyAttempt=" + c[UI_ATTEMPT] + " uiReadyReturned=" + c[UI_RETURNED]
+                + " uiReadyRemoteException=" + c[UI_REMOTE] + " uiReadyHidl=" + c[UI_HIDL]
+                + " providerRoute=" + route + " aidlAcquired=" + c[AIDL] + " frameworkAcquired=" + c[FRAMEWORK]);
+        pw.println(p + "acquiredReceived=" + c[0] + " acquiredDelivered=" + c[1]
+                + " acquiredDropped=" + c[2] + " good=" + c[GOOD] + " start=" + c[START]
+                + " vendorIdle=" + c[VENDOR_IDLE] + " vendorWork=" + c[VENDOR_WORK]
+                + " vendorOther=" + c[VENDOR_OTHER] + " other=" + c[OTHER]);
+        pw.println(p + "progressReceived=" + c[3] + " progressDelivered=" + c[4]
+                + " progressDropped=" + c[5]);
+        pw.println(p + "errorReceived=" + c[6] + " errorDelivered=" + c[7]
+                + " errorDropped=" + c[8] + " hwUnavailable=" + c[ERROR_HW]
+                + " timeout=" + c[ERROR_TIMEOUT] + " canceled=" + c[ERROR_CANCEL]
+                + " vendorError=" + c[ERROR_VENDOR] + " otherError=" + c[ERROR_OTHER]);
+        dumpFixedPairs(pw);
+        dumpWake(pw);
+    }
+}
diff --git a/services/core/java/com/android/server/biometrics/sensors/fingerprint/fod/FodColorFadeTracker.java b/services/core/java/com/android/server/biometrics/sensors/fingerprint/fod/FodColorFadeTracker.java
new file mode 100644
index 000000000..337ef27f2
--- /dev/null
+++ b/services/core/java/com/android/server/biometrics/sensors/fingerprint/fod/FodColorFadeTracker.java
@@ -0,0 +1,50 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+package com.android.server.biometrics.sensors.fingerprint.fod;
+
+import android.os.Handler;
+import java.util.function.Consumer;
+
+/** In-process ColorFade registry, no Binder service or guessed ScreenFade value. */
+public final class FodColorFadeTracker {
+    private static final FodFadeState STATE = new FodFadeState();
+    private static Handler sHandler;
+    private static Consumer<Boolean> sListener;
+    private static Runnable sObserveInvalidation;
+    private FodColorFadeTracker() {}
+
+    public static synchronized void update(Object owner, boolean visible) {
+        Boolean before = STATE.visible();
+        STATE.observe(owner, visible);
+        if (!java.util.Objects.equals(before, STATE.visible())) publish();
+    }
+
+    /** Called before the real remove transaction; returned callback belongs ONLY to that removal. */
+    public static synchronized Runnable removalTransaction(Object owner) {
+        final long generation = STATE.removalSubmitted(owner);
+        return () -> {
+            synchronized (FodColorFadeTracker.class) {
+                Boolean before = STATE.visible();
+                STATE.removalCommitted(owner, generation);
+                if (!java.util.Objects.equals(before, STATE.visible())) publish();
+            }
+        };
+    }
+
+    static synchronized void listen(Handler handler, Consumer<Boolean> listener) {
+        sHandler = handler;
+        sListener = listener;
+        if (STATE.visible() != null) publish(); // no observed renderer -> unknown, not fabricated 0
+    }
+
+    static synchronized Boolean observedVisibility(){return STATE.visible();}
+    static synchronized void listenObserveInvalidation(Runnable invalidation){sObserveInvalidation=invalidation;}
+
+    private static void publish() {
+        if(sObserveInvalidation!=null)sObserveInvalidation.run();
+        if (sHandler != null) {
+            final boolean value = STATE.visible();
+            final Consumer<Boolean> listener = sListener;
+            sHandler.post(() -> listener.accept(value));
+        }
+    }
+}
diff --git a/services/core/java/com/android/server/biometrics/sensors/fingerprint/fod/FodFadeState.java b/services/core/java/com/android/server/biometrics/sensors/fingerprint/fod/FodFadeState.java
