+/* SPDX-License-Identifier: Apache-2.0 */
+package com.android.server.biometrics.sensors.fingerprint.fod;
+
+import android.os.IBinder;
+import android.os.Parcel;
+import android.os.RemoteException;
+import android.os.ServiceManager;
+import android.util.Slog;
+
+/** Stock services.jar exact wire. All methods run on the bridge worker, not Binder/main. */
+final class XiaomiFodTransport implements FodStateMachine.Transport {
+    static final String SERVICE =
+            "vendor.xiaomi.hardware.fingerprintextension.IXiaomiFingerprint/default";
+    static final String TOKEN =
+            "vendor.xiaomi.hardware.fingerprintextension.IXiaomiFingerprint";
+    private static final String TAG = "RothkoFodTransport";
+    private final java.util.function.Consumer<IBinder> mOnDeath;
+    private volatile IBinder mBinder;
+    private IBinder.DeathRecipient mDeath;
+
+    XiaomiFodTransport(java.util.function.Consumer<IBinder> onDeath) { mOnDeath = onDeath; }
+
+    @Override public boolean connect() {
+        if (mBinder != null) return true;
+        try {
+            final IBinder binder = ServiceManager.checkService(SERVICE);
+            if (binder == null) return false;
+            final IBinder.DeathRecipient death = () -> mOnDeath.accept(binder);
+            binder.linkToDeath(death, 0);
+            mBinder = binder;
+            mDeath = death;
+            return true;
+        } catch (RemoteException | RuntimeException e) {
+            Slog.w(TAG, "FOD service unavailable or denied; no retry", e);
+            return false;
+        }
+    }
+
+    boolean isCurrent(IBinder binder) { return mBinder == binder; }
+
+    @Override public boolean send(int command, int parameter) {
+        if (mBinder == null) return false;
+        // Deliberate narrow whitelist. No generic vendor command API is exported.
+        if (!((command == 1 || command == 2 || command == 7)
+                && (parameter == 0 || parameter == 1))
+                && !(command == 3 && parameter >= 0 && parameter <= 4)
+                && !(command == 4 && parameter >= 1 && parameter <= 4)) {
+            throw new IllegalArgumentException("unsupported stock FOD command");
+        }
+        final Parcel data = Parcel.obtain();
+        final Parcel reply = Parcel.obtain();
+        try {
+            data.writeInterfaceToken(TOKEN);
+            data.writeInt(command);
+            data.writeInt(parameter);
+            if (!mBinder.transact(1, data, reply, 0)) return false; // synchronous, NOT oneway
+            reply.readException();
+            final int result = reply.readInt();
+            if (result != 0) Slog.w(TAG, "extCmd rejected: " + command + " result=" + result);
+            return result == 0;
+        } catch (RemoteException | RuntimeException e) {
+            Slog.w(TAG, "extCmd failed: " + command + "; invalidate activity, no retry", e);
+            return false;
+        } finally {
+            reply.recycle();
+            data.recycle();
+        }
+    }
+
+    @Override public void disconnect() {
+        if (mBinder != null && mDeath != null) {
+            try { mBinder.unlinkToDeath(mDeath, 0); }
+            catch (java.util.NoSuchElementException alreadyDead) { /* already unlinked */ }
+        }
+        mBinder = null;
+        mDeath = null;
+    }
+}
