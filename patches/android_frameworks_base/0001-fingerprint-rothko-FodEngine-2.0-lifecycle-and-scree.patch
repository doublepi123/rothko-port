diff --git a/services/core/java/com/android/server/biometrics/sensors/fingerprint/fod/FodAcquisitionDiagnostics.java b/services/core/java/com/android/server/biometrics/sensors/fingerprint/fod/FodAcquisitionDiagnostics.java
