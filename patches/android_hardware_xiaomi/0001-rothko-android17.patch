From: lcy <admin@luchenyang.xyz>
Subject: [PATCH] fingerprint: Support Rothko prebuilt vendor and optical illumination

Keep this patch on the Android 17 baseline recorded in patches/BASES.tsv.

---

diff --git a/aidl/fingerprint/Android.bp b/aidl/fingerprint/Android.bp
index 96ca610..5a78369 100644
--- a/aidl/fingerprint/Android.bp
+++ b/aidl/fingerprint/Android.bp
@@ -5,12 +5,8 @@
 // SPDX-License-Identifier: Apache-2.0
 //
 
-cc_binary {
-    name: "android.hardware.biometrics.fingerprint-service.xiaomi",
-    defaults: ["xiaomi_hardware_biometrics_config_default"],
-    relative_install_path: "hw",
-    init_rc: ["android.hardware.biometrics.fingerprint-service.xiaomi.rc"],
-    vintf_fragments: ["android.hardware.biometrics.fingerprint-service.xiaomi.xml"],
+filegroup {
+    name: "android.hardware.biometrics.fingerprint-service.xiaomi-srcs",
     srcs: [
         "CancellationSignal.cpp",
         "Fingerprint.cpp",
@@ -19,6 +15,24 @@ cc_binary {
         "Session.cpp",
         "service.cpp",
     ],
+}
+
+cc_library_headers {
+    name: "android.hardware.biometrics.fingerprint-service.xiaomi-headers",
+    export_include_dirs: [
+        ".",
+        "include",
+    ],
+    vendor: true,
+}
+
+cc_binary {
+    name: "android.hardware.biometrics.fingerprint-service.xiaomi",
+    defaults: ["xiaomi_hardware_biometrics_config_default"],
+    relative_install_path: "hw",
+    init_rc: ["android.hardware.biometrics.fingerprint-service.xiaomi.rc"],
+    vintf_fragments: ["android.hardware.biometrics.fingerprint-service.xiaomi.xml"],
+    srcs: [":android.hardware.biometrics.fingerprint-service.xiaomi-srcs"],
     local_include_dirs: [
         "include",
     ],
diff --git a/aidl/fingerprint/Fingerprint.cpp b/aidl/fingerprint/Fingerprint.cpp
index cf98a29..f699495 100644
--- a/aidl/fingerprint/Fingerprint.cpp
+++ b/aidl/fingerprint/Fingerprint.cpp
@@ -7,6 +7,8 @@
 
 #include "Fingerprint.h"
 
+#include <dlfcn.h>
+
 #include <android-base/properties.h>
 #include <fingerprint.sysprop.h>
 #include "util/Util.h"
@@ -136,8 +138,26 @@ fingerprint_device_t* Fingerprint::openFingerprintHal(const char* class_name,
 
     ALOGD("Opening fingerprint hal library...");
     if (hw_get_module_by_class(module_id, class_name, &hw_mdl) != 0) {
-        ALOGE("Can't open fingerprint HW Module");
-        return nullptr;
+        // Some stock blobs ship <module_id>.<class>.so without a variant
+        // suffix, which hw_get_module_by_class never probes.
+        for (const char* dir : {"/odm/lib64/hw", "/vendor/lib64/hw"}) {
+            std::string path = std::string(dir) + "/" + module_id + "." + class_name + ".so";
+            void* handle = dlopen(path.c_str(), RTLD_NOW);
+            if (!handle) continue;
+            auto hmi = static_cast<hw_module_t*>(dlsym(handle, HAL_MODULE_INFO_SYM_AS_STR));
+            if (!hmi) {
+                dlclose(handle);
+                continue;
+            }
+            hmi->dso = handle;
+            hw_mdl = hmi;
+            ALOGI("Loaded fingerprint HAL directly from %s", path.c_str());
+            break;
+        }
+        if (!hw_mdl) {
+            ALOGE("Can't open fingerprint HW Module");
+            return nullptr;
+        }
     }
 
     if (!hw_mdl) {
